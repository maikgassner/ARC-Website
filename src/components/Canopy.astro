---
// The Arc mark: a canopy arc, as in the app icon.
interface Props { size?: number; color?: string; label?: string }
const { size = 48, color = 'var(--cream)', label } = Astro.props;
---
<svg
  width={size}
  height={size * 0.62}
  viewBox="70 150 375 210"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path
    fill={color}
    d="M80 352 C112 270 186 158 258 158 C330 158 404 268 436 350 C440 360 428 358 420 350 C376 302 322 256 258 256 C194 256 140 302 96 350 C88 358 76 362 80 352 Z"
  />
</svg>
