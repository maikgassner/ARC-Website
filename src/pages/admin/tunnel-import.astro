---
// One-off import of the wind tunnel list from Skydive Nation (skydive-nation.com,
// used with Leon's OK, 29 Oct 2026). src/data/tunnel-import.json holds their 64
// tunnels with suggested values (prices parsed from their text, diameter, max
// speed, home page, "Town, Country"). Each entry is matched to the nearest
// tunnel in the database: then it's an update (only changed fields are sent),
// otherwise a new tunnel. Their pins are rounded (±1 km): check every new one.
// Saves with admin_save_location, like /admin/places. Done / skipped live in
// this browser only.
import AdminShell from '../../layouts/AdminShell.astro';
---
<AdminShell title="Tunnel import" sub="Skydive Nation's tunnel list: check each one, fix the pin, save to the database." active="tunnel-import">
  <div class="tiles" data-tiles></div>
  <div class="toolbar">
    <div class="pills" role="tablist" data-filters>
      <button type="button" data-f="open" aria-selected="true">To do</button>
      <button type="button" data-f="new" aria-selected="false">New tunnels</button>
      <button type="button" data-f="update" aria-selected="false">Updates</button>
      <button type="button" data-f="done" aria-selected="false">Saved</button>
      <button type="button" data-f="skipped" aria-selected="false">Deleted</button>
    </div>
    <input type="search" placeholder="Search name or place…" data-search aria-label="Search">
  </div>
  <p class="note">Green values are suggestions from the list (prices as written there are shown under the fields). Prices are per hour; “incl. coaching” = flight + their coaching price. Nothing is saved until you press Save.</p>
  <div class="list" data-list></div>
</AdminShell>

<style>
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 16px; }
  :global(.r-tile) { display: grid; gap: 2px; padding: 16px 18px; border-radius: 18px; background: var(--surface); box-shadow: var(--shadow); }
  :global(.r-tile strong) { font-size: 1.8rem; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
  :global(.r-tile span) { font-size: .85rem; font-weight: 700; color: var(--fg-3); }
  @media (max-width: 760px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
  .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 20px; position: sticky; top: 0; z-index: 2; background: var(--bg, #fff); padding: 10px 0; }
  .toolbar input[type="search"] { flex: 1 1 240px; width: auto; }
  .pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .pills button { border: 0; cursor: pointer; font: 600 .9rem var(--font); padding: 9px 16px; border-radius: 999px; background: var(--ink-100); color: var(--fg-2); }
  .pills button[aria-selected="true"] { background: var(--fg); color: #fff; }
  .note { color: var(--fg-3); font-size: .85rem; margin: 8px 0 14px; }
  .list { display: grid; gap: 14px; }
  :global(.tc-card) { background: var(--surface); box-shadow: var(--shadow); border-radius: 18px; padding: 18px; display: grid; gap: 12px; }
  :global(.tc-card.done) { opacity: .55; }
  :global(.tc-head) { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; flex-wrap: wrap; }
  :global(.tc-head h3) { margin: 0; font-size: 1.1rem; }
  :global(.tc-head .loc) { color: var(--fg-3); font-size: .9rem; }
  :global(.tc-flag) { font-size: .78rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; background: var(--coral-50); color: var(--accent-text); }
  :global(.tc-flag.ok) { background: #e6f3ec; color: #2f7d5b; }
  :global(.tc-flag.warn) { background: #fdf3e1; color: #8a5a10; }
  :global(.tc-match) { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font-size: .9rem; }
  :global(.tc-match select) { width: auto; max-width: 100%; }
  :global(.tc-fields) { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px 14px; }
  :global(.tc-field label) { display: block; font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-3); margin-bottom: 4px; }
  :global(.tc-field input) { width: 100%; }
  :global(.tc-field input.sugg) { border-color: #2f7d5b; background: #f3faf6; }
  :global(.tc-field.wide), :global(.tc-field.pinfield) { grid-column: 1 / -1; }
  :global(.tc-sugg) { font-size: .8rem; color: #2f7d5b; margin-top: 4px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  :global(.tc-sugg button) { border: 0; cursor: pointer; font: 700 .75rem var(--font); padding: 3px 9px; border-radius: 999px; background: #e6f3ec; color: #2f7d5b; }
  :global(.tc-raw) { font-size: .82rem; color: var(--fg-3); background: var(--bg); border-radius: 12px; padding: 10px 12px; display: grid; gap: 3px; }
  :global(.tc-raw b) { color: var(--fg-2); }
  :global(.ac) { position: relative; }
  :global(.ac-list) {
    position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 20; margin: 0; padding: 6px; list-style: none;
    background: var(--surface); border-radius: 14px; box-shadow: 0 16px 40px rgba(41, 43, 44, .18); max-height: 320px; overflow: auto;
  }
  :global(.ac-list li) { padding: 10px 12px; border-radius: 10px; cursor: pointer; display: grid; gap: 2px; }
  :global(.ac-list li[aria-selected="true"]), :global(.ac-list li:hover) { background: var(--bg); }
  :global(.ac-list strong) { font-size: .95rem; }
  :global(.ac-list small) { font-size: .8rem; color: var(--fg-3); }
  :global(.pin) { font-size: .85rem; color: var(--fg-2); margin: 6px 0 0; }
  :global(.pin a) { color: var(--accent-text); font-weight: 600; }
  :global(.tc-links) { display: flex; gap: 6px 16px; flex-wrap: wrap; font-size: .85rem; }
  :global(.tc-links a) { font-weight: 700; color: var(--accent-text); }
  :global(.tc-actions) { display: flex; gap: 8px; align-items: center; justify-content: flex-end; flex-wrap: wrap; }
  :global(.tc-actions .danger) { margin-right: auto; color: var(--no); }
  :global(.tc-actions .danger:hover) { border-color: var(--no); }
</style>

<script>
  import type { SupabaseClient } from '@supabase/supabase-js';
  import { el, initAdmin, showError, toast } from '../../lib/admin';
  import { parseCoords, placeFromMapsUrl, isShortMapsLink, urlIn, cityOf, formatAddress, searchAddress, searchAddressNow, reverseGeocode, type Geo } from '../../lib/maps';
  import entries from '../../data/tunnel-import.json';

  type Field = 'location' | 'diameter' | 'height' | 'max_speed' | 'website' | 'currency'
    | 'price_no_coach_regular' | 'price_no_coach_off' | 'price_coach_regular' | 'price_coach_off' | 'pricing_times_note';
  type Tunnel = { name: string; lat: number; lng: number } & Partial<Record<Field, string | number | null>>;
  type Entry = { name: string; lat: number; lng: number; raw: Record<string, string | null>; suggest: Partial<Record<Field, string | number>> };

  const FIELDS: [Field, string, 'text' | 'number', boolean?][] = [
    ['location', 'Location (town, country)', 'text'], ['website', 'Website', 'text'],
    ['diameter', 'Diameter', 'text'], ['height', 'Height', 'text'], ['max_speed', 'Max speed', 'text'], ['currency', 'Currency', 'text'],
    ['price_no_coach_regular', 'No coaching (regular)', 'number'], ['price_no_coach_off', 'No coaching (off times)', 'number'],
    ['price_coach_regular', 'Incl. coaching (regular)', 'number'], ['price_coach_off', 'Incl. coaching (off times)', 'number'],
    ['pricing_times_note', 'Regular/off times note', 'text', true],
  ];
  const COLS = ['name', 'lat', 'lng', ...FIELDS.map(([k]) => k)].join(', ');
  const LIST = entries as Entry[];
  const MATCH_KM = 25;

  let sb: SupabaseClient;
  let tunnels: Tunnel[] = [];
  let filter = 'open', query = '';
  // Which database tunnel an entry updates ('' = add as new); the automatic
  // match unless changed in the card.
  const target = new Map<string, string>();
  const q = <T extends Element>(s: string) => document.querySelector<T>(s)!;
  const stateKey = (n: string) => `arc-tunnel-import:${n}`;
  const stateOf = (n: string) => { try { return localStorage.getItem(stateKey(n)); } catch { return null; } };
  const setState = (n: string, v: 'done' | 'skipped' | null) => { try { v ? localStorage.setItem(stateKey(n), v) : localStorage.removeItem(stateKey(n)); } catch {} };
  const km = (a: number, b: number, c: number, d: number) => {
    const r = Math.PI / 180, x = Math.sin((c - a) * r / 2) ** 2 + Math.cos(a * r) * Math.cos(c * r) * Math.sin((d - b) * r / 2) ** 2;
    return 12742 * Math.asin(Math.sqrt(x));
  };
  const fmtKm = (k: number) => (k < 1 ? `${Math.round(k * 1000)} m` : `${k.toFixed(1)} km`);
  const nearby = (e: Entry, max: number) => tunnels
    .map((t) => ({ t, d: km(e.lat, e.lng, t.lat, t.lng) }))
    .filter((x) => x.d <= max).sort((a, b) => a.d - b.d);
  // Name words that tell tunnels apart ("iFLY", "Indoor Skydiving" don't).
  const GENERIC = new Set(['ifly', 'indoor', 'skydiving', 'skydive', 'tunnel', 'wind', 'the', 'and', 'arena', 'center', 'centre']);
  const words = (s: string) => new Set(s.toLowerCase().normalize('NFD').replace(/[^a-z0-9 ]/g, ' ').split(/\s+/).filter((w) => w.length > 2 && !GENERIC.has(w)));
  const sharesName = (a: string, b: string) => { const wb = words(b); return [...words(a)].some((w) => wb.has(w)); };
  // Within 25 km: the one sharing a name word, else the nearest.
  const autoMatch = (e: Entry) => {
    const near = nearby(e, MATCH_KM);
    return (near.find((x) => sharesName(e.name, x.t.name)) ?? near[0])?.t.name ?? '';
  };
  const targetOf = (e: Entry): Tunnel | null => {
    const name = target.has(e.name) ? target.get(e.name)! : autoMatch(e);
    return tunnels.find((t) => t.name === name) ?? null;
  };
  const str = (v: unknown) => (v === null || v === undefined ? '' : String(v));

  function render() {
    const s = query.trim().toLowerCase();
    const rows = LIST.filter((e) => {
      if (s && !`${e.name} ${e.raw.location} ${targetOf(e)?.name ?? ''}`.toLowerCase().includes(s)) return false;
      const st = stateOf(e.name);
      if (filter === 'done') return st === 'done';
      if (filter === 'skipped') return st === 'skipped';
      if (st) return false;
      if (filter === 'new') return !targetOf(e);
      if (filter === 'update') return !!targetOf(e);
      return true;
    });
    const tile = (v: number, l: string) => el('div', { class: 'r-tile' }, el('strong', { textContent: String(v) }), el('span', { textContent: l }));
    const open = LIST.filter((e) => !stateOf(e.name));
    q<HTMLElement>('[data-tiles]').replaceChildren(
      tile(open.filter((e) => !targetOf(e)).length, 'New tunnels to check'),
      tile(open.filter((e) => targetOf(e)).length, 'Updates to check'),
      tile(LIST.filter((e) => stateOf(e.name) === 'done').length, 'Saved'),
      tile(LIST.filter((e) => stateOf(e.name) === 'skipped').length, 'Deleted'),
    );
    q<HTMLElement>('[data-list]').replaceChildren(...(rows.length ? rows.map(card) : [el('p', { class: 'note', textContent: 'Nothing in this view.' })]));
  }

  function card(e: Entry) {
    const t = targetOf(e);
    const isNew = !t;
    const st = stateOf(e.name);
    const inputs = {} as Record<Field, HTMLInputElement>;
    const nameInput = el('input', { type: 'text', value: e.name });
    const saveBtn = el('button', { type: 'button', class: 'primary-btn small', textContent: isNew ? 'Add tunnel' : 'Save changes' });
    // New: their (rounded) pin until checked. Update: the database pin stays.
    const startPin: [number, number] = t ? [t.lat, t.lng] : [e.lat, e.lng];
    let pin: [number, number] = [...startPin];
    const pinMoved = () => pin[0] !== startPin[0] || pin[1] !== startPin[1];
    const changed = () => isNew || pinMoved() || FIELDS.some(([k]) => inputs[k].value.trim() !== str(t![k]));
    const sync = () => { saveBtn.disabled = !changed(); };

    // Match: which database tunnel this is (nearest within 25 km), or new.
    const near = nearby(e, 60);
    const select = el('select', { 'aria-label': 'Matches tunnel' },
      el('option', { value: '', textContent: '➕ New tunnel (not in Arc yet)' }),
      ...near.map((x) => el('option', { value: x.t.name, textContent: `${x.t.name} · ${x.t.location ?? ''} · ${fmtKm(x.d)} away`, selected: x.t.name === t?.name })),
    );
    select.addEventListener('change', () => { target.set(e.name, select.value); render(); });

    const fields = el('div', { class: 'tc-fields' }, ...FIELDS.map(([k, label, type, wide]) => {
      const sugg = e.suggest[k];
      const current = t ? str(t[k]) : '';
      // Empty in Arc (or new): start with the suggestion, marked green.
      const prefill = current === '' && sugg !== undefined;
      const input = el('input', { type, value: prefill ? str(sugg) : current, class: prefill ? 'sugg' : '', step: type === 'number' ? '1' : undefined, oninput: () => { input.classList.remove('sugg'); sync(); } });
      inputs[k] = input;
      const differs = !prefill && sugg !== undefined && str(sugg) !== current;
      const chip = differs ? el('div', { class: 'tc-sugg' }, `List: ${sugg}`, el('button', { type: 'button', textContent: 'Use', onclick: () => { input.value = str(sugg); input.classList.add('sugg'); sync(); } })) : null;
      return el('div', { class: `tc-field${wide ? ' wide' : ''}` }, el('label', { textContent: label }), input, chip);
    }));

    // Pin field as on /admin/places: address search, Google Maps link
    // (long or maps.app.goo.gl), "lat, lng" or a Plus Code.
    const pinInput = el('input', { type: 'text', placeholder: 'Search an address or paste a Google Maps link', autocomplete: 'off', role: 'combobox', 'aria-autocomplete': 'list' });
    const list = el('ul', { class: 'ac-list', role: 'listbox', hidden: true });
    const pinNote = el('p', { class: 'pin' });
    let results: Geo[] = [];
    let active = -1, timer: number | undefined, seq = 0;
    const paintPin = () => {
      const moved = km(startPin[0], startPin[1], pin[0], pin[1]);
      pinNote.replaceChildren(
        `📍 ${pin[0].toFixed(5)}, ${pin[1].toFixed(5)}${pinMoved() ? ` · moved ${fmtKm(moved)}` : isNew ? ' · rounded pin from the list, check it' : ' · current pin in Arc'} · `,
        el('a', { href: `https://www.google.com/maps?q=${pin[0]},${pin[1]}`, target: '_blank', rel: 'noopener', textContent: 'Check it on Google Maps ↗' }),
      );
    };
    const setPin = (c: [number, number]) => { pin = [+c[0].toFixed(6), +c[1].toFixed(6)]; paintPin(); sync(); };
    const choose = (g: Geo, text?: string) => {
      setPin([g.lat, g.lng]);
      const loc = [cityOf(g.p), g.p.country].filter(Boolean).join(', ');
      if (loc) { inputs.location.value = loc; inputs.location.classList.remove('sugg'); sync(); }
      pinInput.value = text ?? formatAddress(g.p);
      list.hidden = true;
    };
    const paintList = () => {
      list.hidden = results.length === 0;
      list.replaceChildren(...results.map((g, i) => {
        const p = g.p;
        const title = p.name || [p.street, p.housenumber].filter(Boolean).join(' ') || cityOf(p) || p.country;
        const sub = [p.name ? [p.street, p.housenumber].filter(Boolean).join(' ') : '', [p.postcode, cityOf(p)].filter(Boolean).join(' '), p.country].filter(Boolean).join(', ');
        return el('li', { role: 'option', 'aria-selected': String(i === active), onmousedown: (ev: Event) => { ev.preventDefault(); choose(g); } },
          el('strong', { textContent: title }), sub && el('small', { textContent: sub }));
      }));
    };
    async function useMapsUrl(url: string) {
      const coords = parseCoords(url);
      const place = placeFromMapsUrl(url);
      if (!coords) {
        if (place) { pinInput.value = place; pinInput.dispatchEvent(new Event('input')); return; }
        toast('No coordinates in that link. Try “Share → Copy link” or paste “lat, lng”.');
        return;
      }
      setPin(coords);
      pinInput.value = place || `${coords[0].toFixed(5)}, ${coords[1].toFixed(5)}`;
      const mine = ++seq;
      const g = await reverseGeocode(coords[0], coords[1]).catch(() => null);
      if (mine !== seq) return;
      if (!g) { toast('📍 Pin set. No address found there, check the location.'); return; }
      choose({ ...g, lat: coords[0], lng: coords[1] }, place ? `${place}, ${formatAddress(g.p)}` : undefined);
      toast('📍 Pin set from the link. Check the location.');
    }
    async function useMapsLink(short: string) {
      toast('Opening the Google Maps link…');
      const { data, error } = await sb.functions.invoke('admin-fill-from-website', { body: { url: short, mode: 'resolve' } });
      if (error || !data?.url || isShortMapsLink(data.url)) { toast('Couldn’t open that link. Paste the long URL from the address bar or “lat, lng” instead.'); return; }
      await useMapsUrl(data.url);
    }
    pinInput.addEventListener('input', () => {
      clearTimeout(timer);
      const text = pinInput.value.trim();
      if (!text) { ++seq; results = []; paintList(); setPin(startPin); return; }
      const link = urlIn(text);
      if (link && isShortMapsLink(link)) { pinInput.value = link; useMapsLink(link); return; }
      if (link) { pinInput.value = link; useMapsUrl(link); return; }
      if (parseCoords(text)) { useMapsUrl(text); return; }
      if (text.length < 3) { results = []; paintList(); return; }
      timer = window.setTimeout(async () => {
        const mine = ++seq;
        pinNote.textContent = 'Searching… (Enter searches right away)';
        try { const r = await searchAddress(text); if (mine === seq) { results = r; active = -1; paintList(); } } catch {}
        if (mine === seq) paintPin();
      }, 300);
    });
    pinInput.addEventListener('keydown', async (ev) => {
      if (ev.key === 'Enter' && (list.hidden || !results.length)) {
        ev.preventDefault();
        const text = pinInput.value.trim();
        if (text.length < 3 || urlIn(text)) return;
        const mine = ++seq;
        pinNote.textContent = 'Searching…';
        const r = await searchAddressNow(text).catch(() => []);
        if (mine !== seq) return;
        paintPin();
        results = r; active = -1; paintList();
        if (!r.length) toast('No address found. Try street, town and country.');
        return;
      }
      if (list.hidden || !results.length) return;
      if (ev.key === 'ArrowDown') { ev.preventDefault(); active = (active + 1) % results.length; paintList(); }
      else if (ev.key === 'ArrowUp') { ev.preventDefault(); active = (active - 1 + results.length) % results.length; paintList(); }
      else if (ev.key === 'Enter') { ev.preventDefault(); choose(results[Math.max(0, active)]); }
      else if (ev.key === 'Escape') { list.hidden = true; }
    });
    pinInput.addEventListener('blur', () => setTimeout(() => { list.hidden = true; }, 150));
    paintPin();
    const listPin = !isNew && km(t!.lat, t!.lng, e.lat, e.lng) > 0.05
      ? el('div', { class: 'tc-sugg' }, `List pin: ${e.lat}, ${e.lng} (rounded, ${fmtKm(km(t!.lat, t!.lng, e.lat, e.lng))} away)`)
      : null;
    fields.insertBefore(el('div', { class: 'tc-field pinfield' }, el('label', { textContent: 'Pin (address or Google Maps link)' }), el('div', { class: 'ac' }, pinInput, list), pinNote, listPin), fields.firstChild);
    if (isNew) fields.insertBefore(el('div', { class: 'tc-field wide' }, el('label', { textContent: 'Name' }), nameInput), fields.firstChild);

    saveBtn.addEventListener('click', async () => {
      saveBtn.disabled = true;
      const data: Record<string, any> = {};
      for (const [k, , type] of FIELDS) {
        const v = inputs[k].value.trim();
        if (!isNew && v === str(t![k])) continue;
        data[k] = v === '' ? null : type === 'number' ? Math.round(Number(v)) : v;
      }
      if (isNew || pinMoved()) { data.lat = pin[0]; data.lng = pin[1]; }
      if (isNew) {
        const name = nameInput.value.trim();
        if (!name) { toast('Name is required.'); sync(); return; }
        if (tunnels.some((x) => x.name.toLowerCase() === name.toLowerCase())) { toast(`“${name}” already exists. Pick it under “Matches” instead.`); sync(); return; }
        if (!pinMoved() && !confirm('The pin is still the rounded one from the list (up to ~1 km off). Add anyway?')) { sync(); return; }
        data.name = name;
      }
      const { error } = await sb.rpc('admin_save_location', { p_kind: 'tunnel', p_original_name: isNew ? null : t!.name, p_data: data });
      if (error) { toast(`Save failed: ${error.message}`); sync(); return; }
      if (isNew) tunnels.push({ name: data.name, lat: data.lat, lng: data.lng, ...data });
      else Object.assign(t!, data);
      setState(e.name, 'done');
      toast(isNew ? `Added · ${data.name}` : `Saved · ${t!.name}`);
      render();
    });
    const skipBtn = el('button', { type: 'button', class: 'ghost-btn danger', textContent: st === 'skipped' ? 'Restore' : 'Delete from list', onclick: () => {
      setState(e.name, st === 'skipped' ? null : 'skipped');
      render();
    } });
    if (st === 'done') saveBtn.textContent = isNew ? 'Add again' : 'Save again';
    sync();

    const raw = e.raw;
    return el('article', { class: `tc-card${st ? ' done' : ''}` },
      el('div', { class: 'tc-head' },
        el('div', {}, el('h3', { textContent: e.name }), el('div', { class: 'loc', textContent: `${raw.location ?? ''} · ${raw.region ?? ''}` })),
        el('span', { class: `tc-flag ${isNew ? 'warn' : 'ok'}`, textContent: isNew ? 'New tunnel' : `Update · ${fmtKm(km(e.lat, e.lng, t!.lat, t!.lng))} from “${t!.name}”` }),
      ),
      el('div', { class: 'tc-match' }, el('strong', { textContent: 'Matches:' }), select),
      el('div', { class: 'tc-raw' },
        el('div', {}, el('b', { textContent: 'Price: ' }), raw.price ?? '–'),
        el('div', {}, el('b', { textContent: 'Coaching: ' }), raw.coaching ?? '–'),
        el('div', {}, el('b', { textContent: 'Diameter: ' }), raw.diameter ?? '–'),
        raw.comment ? el('div', {}, el('b', { textContent: 'Note: ' }), raw.comment) : null,
      ),
      el('div', { class: 'tc-links' },
        el('a', { href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${e.name} ${raw.location ?? ''}`)}`, target: '_blank', rel: 'noopener', textContent: 'Search on Google Maps' }),
        raw.web ? el('a', { href: raw.web, target: '_blank', rel: 'noopener', textContent: 'Source page' }) : null,
        t?.website ? el('a', { href: str(t.website), target: '_blank', rel: 'noopener', textContent: 'Website in Arc' }) : null,
      ),
      fields,
      el('div', { class: 'tc-actions' }, skipBtn, saveBtn),
    );
  }

  q<HTMLElement>('[data-filters]').addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest('button');
    if (!b) return;
    filter = b.dataset.f!;
    q<HTMLElement>('[data-filters]').querySelectorAll('button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    render();
  });
  q<HTMLInputElement>('[data-search]').addEventListener('input', (ev) => { query = (ev.target as HTMLInputElement).value; render(); });

  initAdmin(async (client) => {
    sb = client;
    const { data, error } = await sb.from('tunnels').select(COLS).order('name');
    if (error) return showError(error.message);
    tunnels = (data ?? []) as unknown as Tunnel[];
    render();
  });
</script>
