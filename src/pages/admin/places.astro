---
// Create / edit dropzones and tunnels from a desk — every field the app's
// forms have, plus photos. Writes go through admin_save_location() &
// friends (ARC/supabase/migrations/0089_admin_locations.sql); reads use the
// public dropzones/tunnels tables. Field lists mirror ARC/app/suggest-edit.tsx.
import AdminShell from '../../layouts/AdminShell.astro';
---
<AdminShell title="Places" sub="Add and edit dropzones and wind tunnels." active="places">

  <!-- List view -->
  <div data-list-view>
    <div class="toolbar">
      <input type="search" placeholder="Search by name, country or town…" data-search aria-label="Search">
      <div class="kind-pills" role="tablist">
        <button type="button" data-kind-filter="all" aria-selected="true">All</button>
        <button type="button" data-kind-filter="dz" aria-selected="false">Dropzones</button>
        <button type="button" data-kind-filter="tunnel" aria-selected="false">Tunnels</button>
      </div>
      <div class="new-btns">
        <button type="button" class="ghost-btn" data-loc-check-btn>Check DZ locations</button>
        <button type="button" class="primary-btn small" data-new>+ Add new</button>
      </div>
    </div>
    <!-- One-off data cleanup: dropzones further than 2 km from any airfield. -->
    <section class="loc-check" data-loc-check hidden></section>
    <p class="list-count" data-list-count></p>
    <div class="place-list" data-places></div>
  </div>

  <!-- Editor view -->
  <form class="editor" data-editor hidden novalidate>
    <div class="editor-head">
      <button type="button" class="ghost-btn" data-back>← All places</button>
      <div>
        <span class="kind-tag" data-editor-kind></span>
        <h2 data-editor-title></h2>
      </div>
      <div class="kind-toggle" role="radiogroup" aria-label="Type" data-kind-toggle hidden>
        <button type="button" role="radio" data-kind="dz">Dropzone</button>
        <button type="button" role="radio" data-kind="tunnel">Wind tunnel</button>
      </div>
    </div>
    <div class="editor-grid" data-fields></div>
    <div class="savebar">
      <span class="savebar-hint" data-save-hint></span>
      <button type="button" class="ghost-btn danger" data-delete hidden>Delete</button>
      <button type="button" class="ghost-btn" data-convert hidden></button>
      <button type="button" class="ghost-btn" data-cancel>Cancel</button>
      <button type="submit" class="primary-btn" data-save>Save</button>
    </div>
  </form>
</AdminShell>

<style>
  /* ---------- List ---------- */
  .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
  .toolbar input[type="search"] { flex: 1 1 260px; width: auto; }
  .kind-pills { display: flex; gap: 6px; }
  .kind-pills button, :global(.chip-suggest) {
    border: 0; cursor: pointer; font: 600 .9rem var(--font); padding: 9px 16px; border-radius: 999px;
    background: var(--ink-100); color: var(--fg-2); white-space: nowrap; transition: background .15s, color .15s;
  }
  .kind-pills button[aria-selected="true"] { background: var(--fg); color: #fff; }
  .new-btns { display: flex; gap: 8px; margin-left: auto; }
  .loc-check { margin-top: 16px; padding: 16px 18px; border-radius: 16px; background: var(--surface); box-shadow: 0 1px 3px rgba(41, 43, 44, .08); }
  .loc-check-head { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .loc-check-head p { margin: 0; flex: 1 1 260px; color: var(--fg-2); }
  .loc-check table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: .9rem; }
  .loc-check th { text-align: left; color: var(--fg-3); font-weight: 600; padding: 6px 8px; border-bottom: 1px solid var(--ink-100); }
  .loc-check td { padding: 8px; border-bottom: 1px solid var(--ink-100); vertical-align: top; }
  .loc-check td small { display: block; color: var(--fg-3); }
  .loc-check .link-btn { background: none; border: 0; padding: 0; font: inherit; font-weight: 600; color: var(--fg); cursor: pointer; text-align: left; }
  .loc-check .link-btn:hover, .loc-check a:hover { text-decoration: underline; }
  .loc-check-scroll { overflow-x: auto; }
  :global(.small) { padding: 10px 16px !important; font-size: .9rem !important; }
  :global(.dark-btn) {
    border: 0; cursor: pointer; border-radius: 999px; padding: 13px 22px; font: 800 1rem var(--font);
    background: var(--fg); color: #fff;
  }
  .list-count { color: var(--fg-3); font-size: .9rem; margin: 18px 0 10px; }
  .place-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  :global(.place-row) {
    display: flex; gap: 14px; align-items: center; text-align: left; cursor: pointer; width: 100%;
    padding: 12px; border-radius: 18px; border: 0; background: var(--surface); box-shadow: var(--shadow);
    font-family: var(--font); color: var(--fg); transition: transform .15s;
  }
  :global(.place-row:hover) { transform: translateY(-2px); }
  :global(.place-avatar) {
    width: 52px; height: 52px; flex: none; border-radius: 14px; object-fit: cover; display: grid; place-items: center;
    background: var(--coral-50); color: var(--accent-text); font-weight: 800; font-size: 1.1rem;
  }
  :global(.place-avatar.tunnel) { background: #eef1f3; color: #54626c; }
  :global(.place-row strong) { display: block; font-size: 1rem; line-height: 1.3; }
  :global(.place-row small) { display: block; color: var(--fg-3); font-size: .82rem; margin-top: 2px; }
  :global(.place-row .missing) { color: var(--amber); font-weight: 700; }

  /* ---------- Editor ---------- */
  .editor-head { display: flex; align-items: center; gap: 16px; margin-top: 16px; flex-wrap: wrap; }
  .editor-head h2 { margin: 2px 0 0; font-size: 1.6rem; }
  .kind-tag {
    font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px; background: var(--coral-50); color: var(--accent-text);
  }
  .kind-tag.tunnel { background: #eef1f3; color: #54626c; }
  .editor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr)); gap: 16px; margin-top: 20px; align-items: start; }
  :global(.fcard) { background: var(--surface); border-radius: 20px; box-shadow: var(--shadow); padding: 18px; display: grid; gap: 14px; }
  :global(.fcard.wide) { grid-column: 1 / -1; }
  :global(.fcard h3) { margin: 0; font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--fg-3); }
  :global(.field) { display: grid; gap: 6px; }
  :global(.field > span) { font-size: .85rem; font-weight: 700; color: var(--fg-2); }
  :global(.field > span em) { font-style: normal; font-weight: 500; color: var(--fg-3); }
  :global(.link-btn) { border: 0; background: none; padding: 0; font: inherit; color: var(--no); cursor: pointer; text-decoration: underline; }
  :global(.field input[readonly]) { color: var(--fg-3) !important; background: var(--ink-100) !important; cursor: not-allowed; }
  :global(.row2) { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  :global(.hint) { margin: -4px 0 0; font-size: .8rem; color: var(--fg-3); }
  :global(.hint a) { color: var(--accent-text); font-weight: 600; }

  :global(.chips) { display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.chip) {
    display: inline-flex; align-items: center; gap: 6px; padding: 7px 8px 7px 12px; border-radius: 999px;
    background: var(--fg); color: #fff; font-size: .88rem; font-weight: 600;
  }
  :global(.chip button) {
    border: 0; cursor: pointer; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(255, 255, 255, .18); color: #fff; font-size: .8rem; line-height: 1;
  }
  :global(.chip-suggest) { font-size: .82rem; padding: 6px 12px; }
  :global(.chip-suggest:hover) { color: var(--fg); }

  :global(.hours) { display: grid; gap: 6px; }
  :global(.hours label) { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 10px; font-size: .9rem; font-weight: 600; color: var(--fg-2); }
  :global(.hours input) { padding: 9px 12px !important; }
  :global(.inline) { display: flex; gap: 8px; }
  :global(.inline input) { flex: 1; }
  :global(.inline button), :global(.mini-btn) {
    flex: none; border: 1px solid var(--border); background: var(--surface); color: var(--fg-2); cursor: pointer;
    border-radius: 12px; padding: 0 14px; font: 700 .85rem var(--font); min-height: 42px;
  }
  :global(.inline button:hover), :global(.mini-btn:hover) { color: var(--fg); border-color: var(--fg-3); }

  :global(.cams) { display: grid; gap: 8px; }
  :global(.cam) { display: grid; grid-template-columns: 84px 1fr auto; gap: 10px; align-items: center; padding: 8px; border-radius: 14px; background: var(--bg); }
  :global(.cam img), :global(.cam .noimg) { width: 84px; height: 56px; border-radius: 10px; object-fit: cover; background: var(--ink-100); display: grid; place-items: center; font-size: .7rem; color: var(--fg-3); text-align: center; }
  :global(.cam a) { font-size: .85rem; color: var(--fg); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  :global(.media) { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; }
  :global(.media-item) { position: relative; }
  :global(.media-item img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; display: block; background: var(--ink-100); cursor: zoom-in; }
  :global(.media-item .del) {
    position: absolute; top: 6px; right: 6px; width: 26px; height: 26px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(0, 0, 0, .6); color: #fff; font-size: .85rem; display: grid; place-items: center;
  }
  :global(.avatar-row) { display: flex; gap: 14px; align-items: center; }
  :global(.avatar-preview) { width: 88px; height: 88px; border-radius: 20px; object-fit: cover; background: var(--ink-100); flex: none; }
  :global(.upload) {
    display: grid; place-items: center; min-height: 90px; padding: 12px; border-radius: 14px; cursor: pointer; text-align: center;
    border: 1.5px dashed var(--border); color: var(--fg-3); font-size: .88rem; font-weight: 600; transition: border-color .15s, color .15s;
  }
  :global(.upload:hover) { border-color: var(--fg-3); color: var(--fg); }
  :global(.upload input) { display: none; }

  .savebar {
    position: sticky; bottom: 16px; z-index: 10; display: flex; gap: 10px; align-items: center; justify-content: flex-end;
    margin-top: 20px; padding: 12px; border-radius: 999px; background: rgba(255, 255, 255, .92);
    backdrop-filter: blur(10px); box-shadow: 0 10px 30px rgba(41, 43, 44, .14);
  }
  .ghost-btn.danger { color: var(--no); }
  .ghost-btn.danger:hover { border-color: var(--no); color: var(--no); }
  .savebar-hint { margin-right: auto; padding-left: 10px; font-size: .88rem; color: var(--fg-3); }

  /* ---------- Rich text (description) ---------- */
  :global(.rt-toolbar) { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  :global(.rt-btn) {
    min-width: 38px; height: 34px; padding: 0 12px; border-radius: 10px; cursor: pointer;
    border: 1px solid var(--border); background: var(--surface); color: var(--fg); font: 600 .88rem var(--font);
  }
  :global(.rt-btn:hover) { border-color: var(--fg-3); }
  :global(.rt-help) { font-size: .78rem; color: var(--fg-3); margin-left: 4px; }
  :global(.rt-label) { font-size: .72rem !important; font-weight: 800 !important; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-3) !important; margin-top: 4px; }
  :global(.rt-preview) { padding: 14px 16px; border-radius: 12px; background: var(--bg); font-size: .92rem; line-height: 1.6; color: var(--fg-2); }
  :global(.rt-preview p) { margin: 0 0 8px; white-space: pre-wrap; }
  :global(.rt-preview ul) { margin: 0 0 8px; padding-left: 1.2em; }
  :global(.rt-preview li::marker) { color: var(--action); }
  :global(.rt-preview strong) { color: var(--fg); }
  :global(.rt-preview a) { color: var(--accent-text); font-weight: 600; text-decoration: underline; }
  :global(.rt-preview > :last-child) { margin-bottom: 0; }
  :global(.rt-empty) { color: var(--fg-3); }

  /* ---------- Hours toggle ---------- */
  :global(.switch-row) { display: flex; align-items: center; gap: 12px; cursor: pointer; font-weight: 700; font-size: .92rem; color: var(--fg); }
  :global(.switch-row input) { position: absolute; opacity: 0; pointer-events: none; }
  :global(.switch) { position: relative; flex: none; width: 44px; height: 26px; border-radius: 999px; background: var(--ink-200); transition: background .15s; }
  :global(.switch)::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2); transition: transform .15s; }
  :global(.switch-row input:checked + .switch) { background: var(--fg); }
  :global(.switch-row input:checked + .switch)::after { transform: translateX(18px); }
  :global(.switch-row input:focus-visible + .switch) { outline: 3px solid var(--coral-500); outline-offset: 2px; }
  :global(.hours-body) { display: grid; gap: 8px; }

  /* ---------- Kind toggle (new places) ---------- */
  .kind-toggle { display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--ink-100); margin-left: auto; }
  .kind-toggle button {
    border: 0; cursor: pointer; font: 700 .95rem var(--font); padding: 10px 18px; border-radius: 999px;
    background: transparent; color: var(--fg-3); transition: background .15s, color .15s;
  }
  .kind-toggle button[aria-checked="true"] { background: var(--surface); color: var(--fg); box-shadow: 0 1px 3px rgba(41, 43, 44, .12); }

  /* ---------- Validation ---------- */
  :global(.field.invalid input), :global(.field.invalid textarea), :global(.field.invalid select), :global(.field.invalid .upload) {
    border-color: var(--no) !important; box-shadow: 0 0 0 3px rgba(198, 78, 44, .14);
  }
  :global(.field.invalid > span) { color: var(--no); }
  :global(.err) { margin: 0; font-size: .82rem; font-weight: 700; color: var(--no); }

  /* ---------- Address autocomplete ---------- */
  :global(.ac) { position: relative; }
  :global(.ac-list) {
    position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 20; margin: 0; padding: 6px; list-style: none;
    background: var(--surface); border-radius: 14px; box-shadow: 0 16px 40px rgba(41, 43, 44, .18); max-height: 320px; overflow: auto;
  }
  :global(.ac-list li) { padding: 10px 12px; border-radius: 10px; cursor: pointer; display: grid; gap: 2px; }
  :global(.ac-list li[aria-selected="true"]), :global(.ac-list li:hover) { background: var(--bg); }
  :global(.ac-list strong) { font-size: .95rem; }
  :global(.ac-list small) { font-size: .8rem; color: var(--fg-3); }
  :global(.pin) { display: flex; gap: 8px; align-items: center; font-size: .85rem; color: var(--fg-2); margin: 0; }
  :global(.pin.none) { color: var(--fg-3); }
  :global(.pin a) { color: var(--accent-text); font-weight: 600; }

  /* ---------- Profile photo card ---------- */
  :global(.profile-card) { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: center; }
  :global(.profile-card .avatar-preview) { width: 112px; height: 112px; border-radius: 26px; }
  :global(.avatar-empty) { width: 112px; height: 112px; border-radius: 26px; display: grid; place-items: center; background: var(--ink-100); color: var(--fg-3); font-size: .78rem; font-weight: 700; text-align: center; padding: 8px; }
  :global(.logo-opts) { display: flex; gap: 10px; flex-wrap: wrap; }
  :global(.logo-opt) { padding: 0; border: 0; background: none; cursor: pointer; line-height: 0; border-radius: 50%; transition: transform .15s; }
  :global(.logo-opt:hover) { transform: scale(1.06); }
  :global(.logo-opt img) { width: 64px; height: 64px; border-radius: 50%; box-shadow: 0 0 0 1px var(--border); }
  :global(.profile-actions) { display: flex; gap: 8px; flex-wrap: wrap; }
  :global(.profile-actions .upload) { min-height: 0; padding: 10px 16px; border-radius: 999px; }
  :global(.media-item.pending img) { opacity: .75; }
  :global(.media-item .badge) {
    position: absolute; left: 6px; bottom: 6px; font-size: .68rem; font-weight: 800; letter-spacing: .04em;
    padding: 3px 8px; border-radius: 999px; background: rgba(0, 0, 0, .6); color: #fff;
  }
  :global(.upload.drag) { border-color: var(--coral-500); color: var(--fg); background: var(--coral-50); }

  @media (max-width: 640px) {
    .kind-toggle { margin-left: 0; width: 100%; }
    .kind-toggle button { flex: 1; }
    :global(.profile-card) { grid-template-columns: 1fr; justify-items: start; }
    .new-btns { margin-left: 0; width: 100%; }
    .new-btns button { flex: 1; }
    :global(.row2) { grid-template-columns: 1fr; }
    .savebar { border-radius: 20px; }
  }
</style>

<script>
  import type { SupabaseClient } from '@supabase/supabase-js';
  import { el, add, photoUrl, openLightbox, toast, initAdmin, showError, toAvatar, PROD_ONLY, BUCKET, type Env } from '../../lib/admin';

  type Kind = 'dz' | 'tunnel';
  type Place = Record<string, any> & { name: string };
  type FieldType = 'text' | 'number' | 'textarea' | 'chips' | 'chipsText' | 'hours' | 'select' | 'address';
  type Field = { key: string; label: string; type: FieldType; placeholder?: string; hint?: string; suggest?: string[]; options?: [string, string][]; decimal?: boolean };
  type Section = { title: string; wide?: boolean; fields: Field[]; extra?: 'webcams' | 'profile' | 'gallery' | 'fill' };

  const $ = <T extends Element>(sel: string) => document.querySelector(sel) as T;
  const $$ = <T extends Element>(sel: string) => Array.from(document.querySelectorAll(sel)) as T[];

  // ---------- Field definitions (mirror the app's suggest-edit form) ----------
  const FACILITIES = ['Showers', 'Café & bar', 'Packing area', 'Gear rental', 'WiFi', 'Free parking', 'Restaurant', 'Shop', 'Briefing room', 'Video service', 'Kids area', 'Lockers'];
  const STAY = ['Camper-friendly', 'Tent-friendly', 'On-site rooms', 'Bunkhouse', 'Hotels nearby'];
  const TUNNEL_FACILITIES = ['Showers', 'Café & bar', 'Gear rental', 'Lockers', 'Free parking', 'Video service', 'Shop', 'Kids area', 'WiFi'];

  // Picked, not typed — same list as the app's suggest form.
  const CURRENCIES = ['CHF', 'EUR', 'USD', 'GBP', 'SEK', 'NOK', 'DKK', 'CZK', 'PLN', 'HUF', 'AUD', 'NZD', 'CAD', 'ZAR', 'AED', 'THB'];
  const CURRENCY_OPTIONS: [string, string][] = [['', 'Choose…'], ...CURRENCIES.map((c): [string, string] => [c, c])];
  // Pre-fills the currency from the picked address's country (only when empty).
  const EURO = ['AT', 'BE', 'CY', 'DE', 'EE', 'ES', 'FI', 'FR', 'GR', 'HR', 'IE', 'IT', 'LT', 'LU', 'LV', 'MT', 'NL', 'PT', 'SI', 'SK', 'ME', 'XK', 'AD', 'MC', 'SM', 'VA'];
  const CURRENCY_BY_COUNTRY: Record<string, string> = {
    CH: 'CHF', LI: 'CHF', US: 'USD', GB: 'GBP', SE: 'SEK', NO: 'NOK', DK: 'DKK', CZ: 'CZK', PL: 'PLN', HU: 'HUF',
    AU: 'AUD', NZ: 'NZD', CA: 'CAD', ZA: 'ZAR', AE: 'AED', TH: 'THB', ...Object.fromEntries(EURO.map((c) => [c, 'EUR'])),
  };

  const FILL: Section = { title: 'Quick fill', wide: true, extra: 'fill', fields: [] };
  const PROFILE: Section = { title: 'Profile photo', wide: true, extra: 'profile', fields: [] };
  const GALLERY: Section = { title: 'Gallery', wide: true, extra: 'gallery', fields: [] };

  const DZ_SECTIONS: Section[] = [
    FILL,
    PROFILE,
    { title: 'Basics', fields: [
      { key: 'name', label: 'Name', type: 'text', placeholder: 'Skydive Example' },
      { key: 'address', label: 'Address', type: 'address', placeholder: 'Start typing the airfield or address…' },
      { key: 'country', label: 'Country', type: 'text', placeholder: 'Filled in from the address' },
      { key: 'icao', label: 'Airfield code (ICAO)', type: 'text', placeholder: 'e.g. LOIH', hint: 'logbooks often name the DZ by it — the import matches it' },
    ] },
    { title: 'Jumping', fields: [
      { key: 'altitude_m', label: 'Exit altitude', type: 'number', placeholder: '4000', hint: 'In metres' },
      { key: 'aircraft', label: 'Aircraft', type: 'chipsText', placeholder: 'e.g. 2× Twin Otter — Enter to add', suggest: ['1× Cessna 208', '1× Pilatus Porter', '1× Twin Otter', '2× Twin Otter', '1× Cessna 182', '1× Skyvan', '1× Casa 212'] },
      { key: 'hours_url', label: 'Opening hours link', type: 'text', placeholder: 'https://… their calendar or opening-hours page', hint: 'the DZ’s own hours / calendar page' },
      { key: 'hours', label: 'Opening hours', type: 'hours' },
    ] },
    { title: 'Pricing', fields: [
      { key: 'guest_ticket_price', label: 'Guest jump ticket', type: 'number', decimal: true, placeholder: '32.50', hint: 'One jump for a visiting fun jumper' },
      { key: 'currency', label: 'Currency', type: 'select', options: CURRENCY_OPTIONS },
    ] },
    { title: 'Contact', fields: [
      { key: 'phone', label: 'Phone', type: 'text', placeholder: 'Add phone number' },
      { key: 'website', label: 'Website', type: 'text', placeholder: 'skydive-example.ch' },
    ] },
    { title: 'Weather', fields: [
      { key: 'foehn_region', label: 'Föhn region', type: 'select', options: [['', 'None (not Alpine)'], ['north', 'Alpine north side'], ['south', 'Alpine south side']] },
      { key: 'foehn_region_label', label: 'Föhn region label', type: 'text', placeholder: 'Alpennordseite · Rheintal' },
    ] },
    { title: 'Description', wide: true, fields: [
      { key: 'description', label: 'Description', type: 'textarea', placeholder: 'What makes this place special? Landing area, team, vibe, who it suits…' },
    ] },
    { title: 'Amenities', fields: [
      { key: 'facilities', label: 'Facilities', type: 'chips', placeholder: 'Add a facility — Enter', suggest: FACILITIES },
      { key: 'stay', label: 'Stay options', type: 'chips', placeholder: 'Add an option — Enter', suggest: STAY },
    ] },
    { title: 'Webcams', extra: 'webcams', fields: [] },
    GALLERY,
  ];

  const TUNNEL_SECTIONS: Section[] = [
    FILL,
    PROFILE,
    { title: 'Basics', fields: [
      { key: 'name', label: 'Name', type: 'text', placeholder: 'Windwerk Example' },
      { key: 'address', label: 'Address', type: 'address', placeholder: 'Start typing the tunnel’s address…' },
      { key: 'location', label: 'Location', type: 'text', placeholder: 'Town, Country — filled in from the address' },
    ] },
    { title: 'Tunnel', fields: [
      { key: 'diameter', label: 'Diameter', type: 'text', placeholder: '4.3 m' },
      { key: 'height', label: 'Height', type: 'text', placeholder: '17 m' },
      { key: 'max_speed', label: 'Max speed', type: 'text', placeholder: '280 km/h' },
      { key: 'hours_url', label: 'Opening hours link', type: 'text', placeholder: 'https://… their calendar or opening-hours page', hint: 'the DZ’s own hours / calendar page' },
      { key: 'hours', label: 'Opening hours', type: 'hours' },
    ] },
    { title: 'Contact', fields: [
      { key: 'phone', label: 'Phone', type: 'text', placeholder: 'Add phone number' },
      { key: 'website', label: 'Website', type: 'text', placeholder: 'windwerk-example.ch' },
    ] },
    { title: 'Pricing', fields: [
      { key: 'currency', label: 'Currency', type: 'select', options: CURRENCY_OPTIONS },
      { key: 'price_no_coach_regular', label: 'No coaching · regular', type: 'number', placeholder: '900', hint: 'Per hour' },
      { key: 'price_no_coach_off', label: 'No coaching · off times', type: 'number', hint: 'Per hour' },
      { key: 'price_coach_regular', label: 'Incl. coaching · regular', type: 'number', hint: 'Per hour' },
      { key: 'price_coach_off', label: 'Incl. coaching · off times', type: 'number', hint: 'Per hour' },
      { key: 'pricing_times_note', label: 'Regular / off times note', type: 'text', placeholder: 'Off times: Mon–Fri before 4 pm' },
    ] },
    { title: 'Description', wide: true, fields: [
      { key: 'description', label: 'Description', type: 'textarea', placeholder: 'What makes this tunnel special?' },
    ] },
    { title: 'Amenities', fields: [
      { key: 'facilities', label: 'Facilities', type: 'chips', placeholder: 'Add a facility — Enter', suggest: TUNNEL_FACILITIES },
    ] },
    GALLERY,
  ];

  // Fields that carry over when switching a *new* place between DZ and tunnel.
  const SHARED_KEYS = ['name', 'address', 'lat', 'lng', 'hours', 'hours_url', '_showHours', 'phone', 'website', 'description', 'facilities', 'avatar_path', 'currency', '_country', '_city'];

  const FT_PER_M = 1 / 0.3048;

  // ---------- Opening hours (port of ARC/utils/openingHours.ts) ----------
  const WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
  const SHORT = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
  const DAY = '(mon|tue|wed|thu|fri|sat|sun)[a-z]*\\.?';
  const RANGE_OR_DAY = `${DAY}(?:\\s*[–—-]\\s*${DAY})?`;
  const SPEC = new RegExp(`^((?:${RANGE_OR_DAY})(?:\\s*[,&/]\\s*(?:${RANGE_OR_DAY}))*)\\s*:?\\s*(.*)$`, 'i');
  function daysIn(spec: string): number[] {
    const out: number[] = [];
    for (const part of spec.split(/\s*[,&/]\s*/)) {
      const m = part.match(new RegExp(`^${DAY}(?:\\s*[–—-]\\s*${DAY})?$`, 'i'));
      if (!m) continue;
      const a = SHORT.indexOf(m[1].toLowerCase());
      const b = m[2] ? SHORT.indexOf(m[2].toLowerCase()) : a;
      for (let i = a; ; i = (i + 1) % 7) { out.push(i); if (i === b) break; }
    }
    return out;
  }
  const tidy = (v: string) => (/^closed$/i.test(v.trim()) ? 'Closed' : v.trim());
  function parseHours(text?: string): string[] {
    if (!text?.trim()) return Array(7).fill('');
    const perDay: (string | null)[] = Array(7).fill(null);
    let general: string | null = null;
    for (const seg of text.split(/\s*[·;\n]\s*/).filter(Boolean)) {
      const m = seg.trim().match(SPEC);
      const days = m ? daysIn(m[1]) : [];
      const value = m ? m[m.length - 1] : '';
      if (m && days.length && value.trim()) days.forEach((d) => { perDay[d] = tidy(value); });
      else general = tidy(seg);
    }
    // Unnamed days stay empty (shown as nothing in the app); an explicit "Closed" is kept.
    return perDay.map((v) => v ?? general ?? '');
  }
  function serializeHours(values: string[]): string {
    const v = values.map((x) => x.trim());
    if (v.every((x) => !x)) return '';
    if (v.every((x) => x === v[0])) return v[0];
    const SH = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    const parts: string[] = [];
    for (let i = 0; i < 7; ) {
      if (!v[i]) { i++; continue; }
      let j = i;
      while (j + 1 < 7 && v[j + 1] === v[i]) j++;
      parts.push(`${i === j ? SH[i] : `${SH[i]}–${SH[j]}`} ${v[i]}`);
      i = j + 1;
    }
    return parts.join(' · ');
  }

  // ---------- Address search (OpenStreetMap — free, no key) ----------
  // Photon for search-as-you-type (Nominatim's policy forbids autocomplete),
  // Nominatim for single lookups — pin → address, and Enter in the field —
  // because Photon's public server is sometimes ~30 s slow. Both time out.
  type Geo = { lat: number; lng: number; p: Record<string, any> };
  const cityOf = (p: Record<string, any>) => p.city ?? p.town ?? p.village ?? p.locality ?? p.district ?? p.county ?? '';
  function formatAddress(p: Record<string, any>): string {
    const street = [p.street, p.housenumber].filter(Boolean).join(' ');
    const town = [p.postcode, cityOf(p)].filter(Boolean).join(' ');
    return [p.name && p.name !== p.street ? p.name : '', street, town, p.country].filter(Boolean).join(', ');
  }
  const toGeo = (f: any): Geo => ({ lng: f.geometry.coordinates[0], lat: f.geometry.coordinates[1], p: f.properties ?? {} });
  const getJson = async (url: string, ms: number) => {
    const res = await fetch(url, { signal: AbortSignal.timeout(ms) });
    return res.ok ? res.json() : null;
  };
  // Nominatim result → the same shape as Photon's properties.
  const fromNominatim = (n: any): Geo => {
    const a = n.address ?? {};
    return {
      lat: Number(n.lat), lng: Number(n.lon),
      p: {
        name: n.name || undefined, street: a.road ?? a.pedestrian ?? a.footway, housenumber: a.house_number, postcode: a.postcode,
        city: a.city ?? a.town ?? a.village ?? a.hamlet ?? a.municipality, county: a.county, country: a.country, countrycode: a.country_code,
      },
    };
  };
  const NOMINATIM = 'https://nominatim.openstreetmap.org';
  async function searchAddress(q: string): Promise<Geo[]> {
    const d = await getJson(`https://photon.komoot.io/api/?q=${encodeURIComponent(q)}&limit=6&lang=en`, 8000);
    return (d?.features ?? []).map(toGeo);
  }
  async function searchAddressNow(q: string): Promise<Geo[]> {
    const d = await getJson(`${NOMINATIM}/search?q=${encodeURIComponent(q)}&format=jsonv2&addressdetails=1&limit=6&accept-language=en`, 8000);
    return Array.isArray(d) ? d.map(fromNominatim) : [];
  }
  async function reverseGeocode(lat: number, lng: number): Promise<Geo | null> {
    try {
      const n = await getJson(`${NOMINATIM}/reverse?lat=${lat}&lon=${lng}&format=jsonv2&addressdetails=1&accept-language=en`, 6000);
      if (n && !n.error) return { ...fromNominatim(n), lat, lng };
    } catch {}
    try {
      const f = (await getJson(`https://photon.komoot.io/reverse?lat=${lat}&lon=${lng}&lang=en`, 8000))?.features?.[0];
      return f ? { lat, lng, p: f.properties ?? {} } : null;
    } catch { return null; }
  }
  // Name / search text in a Google Maps link (…/maps/place/Skydive+Hohenems/@…
  // or …/maps?q=…) — the address fallback when the pin has no street address.
  function placeFromMapsUrl(text: string): string {
    try {
      const u = new URL(text);
      const m = u.pathname.match(/\/maps\/(?:place|search)\/([^/@]+)/);
      const raw = m ? decodeURIComponent(m[1].replace(/\+/g, ' ')) : (u.searchParams.get('q') ?? u.searchParams.get('query') ?? '');
      return /^-?\d+(\.\d+)?\s*,\s*-?\d+(\.\d+)?$/.test(raw.trim()) ? '' : raw.trim();
    } catch { return ''; }
  }
  const isShortMapsLink = (text: string) => /^https?:\/\/(maps\.app\.goo\.gl|goo\.gl\/maps|g\.co\/kgs)\//i.test(text.trim());
  // A link pasted next to old address text still counts — take the URL itself.
  const urlIn = (text: string) => text.match(/https?:\/\/\S+/i)?.[0] ?? null;

  // A pasted "47.38, 9.69" or Google Maps link also works in the address field.
  function parseCoords(text: string): [number, number] | null {
    const pats = [/!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)/, /@(-?\d+\.\d+),\s*(-?\d+\.\d+)/, /[?&](?:q|ll|query)=(-?\d+\.\d+),\s*(-?\d+\.\d+)/, /^\s*(-?\d{1,3}\.\d+)\s*[,;\s]\s*(-?\d{1,3}\.\d+)\s*$/];
    for (const p of pats) {
      const m = text.match(p);
      if (m) { const lat = +m[1], lng = +m[2]; if (Math.abs(lat) <= 90 && Math.abs(lng) <= 180) return [lat, lng]; }
    }
    return plusCodeToCoords(text);
  }

  // Google often puts only a Plus Code in a place link (…!20s8Q995PVV%2BFCM,
  // no @lat,lng), or people paste one ("8Q995PVV+FCM"): decode the full
  // Open Location Code to the centre of its cell (~14 × 14 m, 11 chars ~3 m).
  const OLC = '23456789CFGHJMPQRVWX';
  function plusCodeToCoords(text: string): [number, number] | null {
    let t = text;
    try { t = decodeURIComponent(text); } catch { /* keep as is */ }
    const m = t.match(/(?:^|[^23456789CFGHJMPQRVWX])([23456789CFGHJMPQRVWX]{8})\+([23456789CFGHJMPQRVWX]{2,3})(?![23456789CFGHJMPQRVWX])/i);
    if (!m) return null;
    const code = (m[1] + m[2]).toUpperCase();
    let lat = -90, lng = -180, res = 20;
    for (let i = 0; i < 10; i += 2) {
      lat += OLC.indexOf(code[i]) * res; lng += OLC.indexOf(code[i + 1]) * res;
      if (i < 8) res /= 20;
    }
    let latCell = res, lngCell = res;
    if (code.length > 10) { // 11th char: the cell split into 5 rows × 4 columns
      const d = OLC.indexOf(code[10]); latCell = res / 5; lngCell = res / 4;
      lat += Math.floor(d / 4) * latCell; lng += (d % 4) * lngCell;
    }
    return [+(lat + latCell / 2).toFixed(6), +(lng + lngCell / 2).toFixed(6)];
  }

  // Downscale big desk photos before upload (the app uploads ~0.7 quality JPEGs).
  async function toJpeg(file: File, max = 1800): Promise<Blob> {
    const img = await createImageBitmap(file);
    const scale = Math.min(1, max / Math.max(img.width, img.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(img.width * scale);
    canvas.height = Math.round(img.height * scale);
    canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
    return new Promise((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error('Could not read image'))), 'image/jpeg', 0.82));
  }
  const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'place';

  // ---------- State ----------
  let sb: SupabaseClient;
  let env: Env = 'prod';
  let places: (Place & { kind: Kind })[] = [];
  let kindFilter: 'all' | Kind = 'all';
  type Pending = { file: File; url: string };
  let editing: { kind: Kind; original: string | null; values: Record<string, any>; gallery: any[]; pending: Pending[] } | null = null;
  let dirty = false;

  const listView = $<HTMLElement>('[data-list-view]');
  const editor = $<HTMLFormElement>('[data-editor]');
  const fieldsBox = $<HTMLElement>('[data-fields]');
  const searchInput = $<HTMLInputElement>('[data-search]');
  const kindToggle = $<HTMLElement>('[data-kind-toggle]');

  // ---------- List ----------
  // Readable names for the "Missing: …" hint (column names say "altitude ft").
  const MISSING_LABEL: Record<string, string> = { altitude_ft: 'altitude', price_no_coach_regular: 'price' };

  async function loadPlaces() {
    const [dz, tu] = await Promise.all([
      sb.from('dropzones').select('*').order('name'),
      sb.from('tunnels').select('*').order('name'),
    ]);
    if (dz.error || tu.error) return showError((dz.error || tu.error)!.message);
    places = [
      ...(dz.data ?? []).map((p: Place) => ({ ...p, kind: 'dz' as Kind })),
      ...(tu.data ?? []).map((p: Place) => ({ ...p, kind: 'tunnel' as Kind })),
    ].sort((a, b) => a.name.localeCompare(b.name));
    renderList();
  }

  function renderList() {
    const q = searchInput.value.trim().toLowerCase();
    const shown = places.filter((p) =>
      (kindFilter === 'all' || p.kind === kindFilter) &&
      (!q || [p.name, p.country, p.location, p.address].some((x) => x?.toLowerCase().includes(q))));
    $<HTMLElement>('[data-list-count]').textContent =
      `${shown.length} of ${places.length} places · ${places.filter((p) => p.kind === 'dz').length} dropzones, ${places.filter((p) => p.kind === 'tunnel').length} tunnels`;
    $<HTMLElement>('[data-places]').replaceChildren(...shown.map((p) => {
      // A calendar link counts as "has hours".
      const has = (k: string) => (k === 'hours' ? !!(p.hours || p.hours_url) : !!p[k]);
      const missing = p.kind === 'dz'
        ? ['altitude_ft', 'aircraft', 'hours', 'website'].filter((k) => !has(k))
        : ['hours', 'website', 'price_no_coach_regular'].filter((k) => !has(k));
      const sub = p.kind === 'dz'
        ? [p.country, p.altitude_ft && `${Math.round(p.altitude_ft * 0.3048).toLocaleString('de-CH')} m`, p.aircraft, p.guest_ticket_price != null && `${Number(p.guest_ticket_price)} ${p.currency ?? ''}`.trim()].filter(Boolean).join(' · ')
        : [p.location, p.diameter].filter(Boolean).join(' · ');
      return el('button', { type: 'button', class: 'place-row', onclick: () => openEditor(p.kind, p) },
        p.avatar_path
          ? el('img', { class: 'place-avatar', src: photoUrl(env, p.avatar_path), alt: '', loading: 'lazy' })
          : el('span', { class: `place-avatar${p.kind === 'tunnel' ? ' tunnel' : ''}`, textContent: p.kind === 'dz' ? 'DZ' : 'T' }),
        el('span', {},
          el('strong', { textContent: p.name }),
          el('small', { textContent: sub || (p.kind === 'dz' ? 'Dropzone' : 'Tunnel') }),
          missing.length > 0 && el('small', { class: 'missing', textContent: `Missing: ${missing.map((m) => MISSING_LABEL[m] ?? m.replace(/_/g, ' ')).join(', ')}` }),
        ),
      );
    }));
  }

  searchInput.addEventListener('input', renderList);
  $$<HTMLButtonElement>('[data-kind-filter]').forEach((b) => b.addEventListener('click', () => {
    kindFilter = b.dataset.kindFilter as typeof kindFilter;
    $$<HTMLButtonElement>('[data-kind-filter]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    renderList();
  }));
  $<HTMLButtonElement>('[data-new]').addEventListener('click', () => openEditor('dz', null));

  // ---------- Location check (one-off cleanup) ----------
  // Every dropzone should sit on an airfield. Loads the open OurAirports
  // dataset (public domain, ~12 MB, every airport down to small strips) and
  // lists dropzones whose pin is more than 2 km from any airfield, or more
  // than 2 km from the airfield their ICAO code names. Tunnels aren't at
  // airfields, so they're not checked.
  const AIRPORTS_CSV = 'https://davidmegginson.github.io/ourairports-data/airports.csv';
  const MAX_KM = 2;
  // Checked by hand: the pin is right, the airfield just isn't in OurAirports
  // (or is further than 2 km). Plus what was ticked off in this browser.
  const LOCATION_CHECKED = new Set([
    'FunnyFarm', 'Skydive Terengganu', 'SA Skydiving', 'Skydive West Edmonton', 'Skydive Pharaohs',
    'Faldskærmsklubben DFC', 'FSC Calw e.v', 'Skydive Vancouver', 'Skydive Ramblers', 'Davy Parachutisme',
    'Bloemfontein Parachute Club', 'Salzburger Fallschirmspringer- und Flugsport Club',
  ]);
  const CHECKED_KEY = 'arcAdminLocationChecked';
  const checkedHere = (): Set<string> => {
    try { return new Set(JSON.parse(localStorage.getItem(CHECKED_KEY) ?? '[]')); } catch { return new Set(); }
  };
  function markChecked(name: string) {
    const set = checkedHere(); set.add(name);
    try { localStorage.setItem(CHECKED_KEY, JSON.stringify([...set])); } catch { /* private mode */ }
    runLocationCheck();
  }
  let airfieldsCache: Awaited<ReturnType<typeof loadAirfields>> | null = null;
  type Airfield = { name: string; code: string; lat: number; lng: number };

  function parseCsv(text: string): string[][] {
    const rows: string[][] = [];
    let row: string[] = [], cell = '', quoted = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (quoted) {
        if (c === '"') { if (text[i + 1] === '"') { cell += '"'; i++; } else quoted = false; }
        else cell += c;
      } else if (c === '"') quoted = true;
      else if (c === ',') { row.push(cell); cell = ''; }
      else if (c === '\n') { row.push(cell); rows.push(row); row = []; cell = ''; }
      else if (c !== '\r') cell += c;
    }
    if (cell || row.length) { row.push(cell); rows.push(row); }
    return rows;
  }

  function distKm(aLat: number, aLng: number, bLat: number, bLng: number) {
    const r = Math.PI / 180, dLat = (bLat - aLat) * r, dLng = (bLng - aLng) * r;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(aLat * r) * Math.cos(bLat * r) * Math.sin(dLng / 2) ** 2;
    return 12742 * Math.asin(Math.sqrt(h));
  }

  async function loadAirfields() {
    const res = await fetch(AIRPORTS_CSV);
    if (!res.ok) throw new Error(`Airfield list didn't load (${res.status}).`);
    const [head, ...rows] = parseCsv(await res.text());
    const col = (n: string) => head.indexOf(n);
    const iType = col('type'), iName = col('name'), iLat = col('latitude_deg'), iLng = col('longitude_deg');
    const codeCols = ['icao_code', 'gps_code', 'ident', 'local_code'].map(col);
    // Grid of 1° cells for the nearest-airfield search; codes for the ICAO check.
    const grid = new Map<string, Airfield[]>();
    const byCode = new Map<string, Airfield>();
    for (const r of rows) {
      if (!['small_airport', 'medium_airport', 'large_airport'].includes(r[iType])) continue;
      const a: Airfield = { name: r[iName], code: r[codeCols[0]] || r[codeCols[1]] || r[codeCols[2]], lat: +r[iLat], lng: +r[iLng] };
      if (!Number.isFinite(a.lat) || !Number.isFinite(a.lng)) continue;
      const key = `${Math.floor(a.lat)},${Math.floor(a.lng)}`;
      (grid.get(key) ?? grid.set(key, []).get(key)!).push(a);
      for (const i of codeCols) { const c = r[i]?.toUpperCase(); if (c && !byCode.has(c)) byCode.set(c, a); }
    }
    return { grid, byCode };
  }

  type LocIssue = { place: Place & { kind: Kind }; km: number | null; near: Airfield | null; note: string };

  const mapsLink = (lat: number, lng: number, text: string) =>
    el('a', { href: `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`, target: '_blank', rel: 'noopener', textContent: text });

  async function runLocationCheck() {
    const box = $<HTMLElement>('[data-loc-check]');
    const btn = $<HTMLButtonElement>('[data-loc-check-btn]');
    box.hidden = false;
    btn.disabled = true;
    if (!airfieldsCache) box.replaceChildren(el('p', { textContent: 'Loading the airfield list (~12 MB)…' }));
    try {
      airfieldsCache ??= await loadAirfields();
      const { grid, byCode } = airfieldsCache;
      const here = checkedHere();
      const isChecked = (name: string) => LOCATION_CHECKED.has(name) || here.has(name);
      const hiddenChecked = places.filter((p) => p.kind === 'dz' && isChecked(p.name)).length;
      const dzs = places.filter((p) => p.kind === 'dz' && !isChecked(p.name));
      const issues: LocIssue[] = [];
      for (const p of dzs) {
        const lat = Number(p.lat), lng = Number(p.lng);
        if (p.lat == null || p.lng == null || !Number.isFinite(lat) || !Number.isFinite(lng) || (lat === 0 && lng === 0)) {
          issues.push({ place: p, km: null, near: null, note: 'No coordinates' });
          continue;
        }
        let near: Airfield | null = null, km = Infinity;
        for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) {
          for (const a of grid.get(`${Math.floor(lat) + dy},${Math.floor(lng) + dx}`) ?? []) {
            const d = distKm(lat, lng, a.lat, a.lng);
            if (d < km) { km = d; near = a; }
          }
        }
        const notes: string[] = [];
        if (km > MAX_KM) notes.push(near ? 'No airfield within 2 km' : 'No airfield within ~100 km');
        const icao = String(p.icao ?? '').trim().toUpperCase();
        const named = icao ? byCode.get(icao) : undefined;
        if (icao && !named) notes.push(`ICAO ${icao} not found`);
        if (named) {
          const dNamed = distKm(lat, lng, named.lat, named.lng);
          if (dNamed > MAX_KM) {
            notes.push(`${icao} (${named.name}) is ${dNamed.toFixed(1)} km away`);
            if (km <= MAX_KM) { km = dNamed; near = named; }
          }
        }
        if (notes.length) issues.push({ place: p, km: Number.isFinite(km) ? km : null, near, note: notes.join(' · ') });
      }
      issues.sort((a, b) => (b.km ?? Infinity) - (a.km ?? Infinity));
      const tunnels = places.length - dzs.length;

      const csv = () => [['Name', 'Country', 'Lat', 'Lng', 'ICAO', 'Distance km', 'Nearest airfield', 'Airfield lat', 'Airfield lng', 'Note'],
        ...issues.map((i) => [i.place.name, i.place.country ?? '', i.place.lat ?? '', i.place.lng ?? '', i.place.icao ?? '',
          i.km == null ? '' : i.km.toFixed(1), i.near?.name ?? '', i.near?.lat ?? '', i.near?.lng ?? '', i.note])]
        .map((r) => r.map((c) => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n');

      box.replaceChildren(
        el('div', { class: 'loc-check-head' },
          el('p', { textContent: `${issues.length} of ${dzs.length} dropzones to check by hand${hiddenChecked ? ` · ${hiddenChecked} already checked, hidden` : ''}${tunnels ? ` · ${tunnels} tunnels not checked (they're not at airfields)` : ''}. Sorted by distance; private strips missing from OurAirports show up here too.` }),
          el('button', { type: 'button', class: 'ghost-btn', textContent: 'Copy as CSV', onclick: async () => {
            await navigator.clipboard.writeText(csv());
            toast('Copied — paste it into a spreadsheet');
          } }),
          el('button', { type: 'button', class: 'ghost-btn', textContent: 'Close', onclick: () => { box.hidden = true; } }),
        ),
        el('div', { class: 'loc-check-scroll' },
          el('table', {},
            el('thead', {}, el('tr', {}, ...['Dropzone', 'Distance', 'Nearest airfield', 'Why', ''].map((t) => el('th', { textContent: t })))),
            el('tbody', {}, ...issues.map((i) => el('tr', {},
              el('td', {},
                el('button', { type: 'button', class: 'link-btn', textContent: i.place.name, onclick: () => openEditor('dz', i.place) }),
                el('small', {}, [i.place.country, i.place.icao].filter(Boolean).join(' · ') || ' '),
                i.place.lat != null && i.place.lng != null && el('small', {}, mapsLink(Number(i.place.lat), Number(i.place.lng), 'Pin on Google Maps')),
              ),
              el('td', { textContent: i.km == null ? '—' : `${i.km.toFixed(1)} km` }),
              el('td', {}, i.near ? mapsLink(i.near.lat, i.near.lng, `${i.near.name}${i.near.code ? ` (${i.near.code})` : ''}`) : '—'),
              el('td', { textContent: i.note }),
              el('td', {}, el('button', { type: 'button', class: 'ghost-btn', textContent: 'Location checked', title: 'The pin is right — hide it from this list (this browser)', onclick: () => markChecked(i.place.name) })),
            ))),
          ),
        ),
      );
    } catch (e: any) {
      box.replaceChildren(el('p', { textContent: e?.message ?? 'The check failed — try again.' }));
    } finally {
      btn.disabled = false;
    }
  }
  $<HTMLButtonElement>('[data-loc-check-btn]').addEventListener('click', runLocationCheck);

  // ---------- Editor ----------
  async function openEditor(kind: Kind, place: Place | null) {
    const values: Record<string, any> = place ? { ...place } : {};
    if (kind === 'dz' && values.altitude_ft != null) {
      values.altitude_m = Math.round(values.altitude_ft * 0.3048);
      values._alt_m0 = values.altitude_m; // unchanged metres → keep the exact feet value
    }
    editing = { kind, original: place?.name ?? null, values, gallery: [], pending: [] };
    dirty = false;
    if (place) await loadGallery();
    paintHead();
    renderEditor();
    listView.hidden = true;
    editor.hidden = false;
    window.scrollTo({ top: 0 });
  }

  function paintHead() {
    const { kind, original, values } = editing!;
    const tag = $<HTMLElement>('[data-editor-kind]');
    tag.textContent = original ? (kind === 'dz' ? 'Dropzone' : 'Wind tunnel') : 'New place';
    tag.classList.toggle('tunnel', kind === 'tunnel');
    $<HTMLElement>('[data-editor-title]').textContent = original ?? (values.name?.trim() || (kind === 'dz' ? 'New dropzone' : 'New wind tunnel'));
    kindToggle.hidden = !!original;
    $$<HTMLButtonElement>('[data-kind]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.kind === kind)));
    $<HTMLElement>('[data-save-hint]').textContent = original ? '' : 'Name and address are required.';
    $<HTMLButtonElement>('[data-delete]').hidden = !original;
    const convert = $<HTMLButtonElement>('[data-convert]');
    convert.hidden = !original;
    convert.textContent = kind === 'dz' ? 'Make it a tunnel' : 'Make it a dropzone';
  }

  // Switching type on a new place keeps whatever both forms share.
  $$<HTMLButtonElement>('[data-kind]').forEach((b) => b.addEventListener('click', () => {
    if (!editing || editing.original || b.dataset.kind === editing.kind) return;
    const kind = b.dataset.kind as Kind;
    const v = editing.values;
    const kept: Record<string, any> = {};
    for (const k of SHARED_KEYS) if (v[k] !== undefined) kept[k] = v[k];
    if (kind === 'dz' && v._country) kept.country = v._country;
    if (kind === 'tunnel' && (v._city || v._country)) kept.location = [v._city, v._country].filter(Boolean).join(', ');
    editing = { ...editing, kind, values: kept };
    paintHead();
    renderEditor();
  }));

  function closeEditor() {
    if (dirty && !confirm('Discard your changes?')) return;
    editing?.pending.forEach((p) => URL.revokeObjectURL(p.url));
    editing = null;
    editor.hidden = true;
    listView.hidden = false;
  }
  $<HTMLButtonElement>('[data-back]').addEventListener('click', closeEditor);
  $<HTMLButtonElement>('[data-cancel]').addEventListener('click', closeEditor);
  editor.addEventListener('input', () => { dirty = true; });

  // Wrong type from an import (a tunnel in the dropzone list, or back):
  // admin_convert_location (0115) moves the shared fields, photos and
  // reviews; it refuses while logbooks, favourites, home DZs, events or
  // posts use the name. Kind-specific fields are filled in afterwards.
  $<HTMLButtonElement>('[data-convert]').addEventListener('click', async () => {
    if (!editing?.original) return;
    if (dirty && !confirm('Your unsaved changes will be lost. Continue?')) return;
    const { kind, original, values } = editing;
    const target: Kind = kind === 'dz' ? 'tunnel' : 'dz';
    let location: string | null = null;
    if (target === 'tunnel') {
      // "…, 41110 Bollullos de la Mitación, Spain" → "Bollullos de la Mitación, Spain"
      const parts = String(values.address ?? '').split(',').map((x) => x.trim()).filter(Boolean);
      const town = parts.length >= 2 ? parts[parts.length - 2].replace(/^[\d\s-]+/, '').trim() : '';
      const guess = [town, values.country].filter(Boolean).join(', ');
      location = prompt(`“${original}” becomes a wind tunnel. Its location (town, country):`, guess);
      if (location === null) return;
    } else if (!confirm(`“${original}” becomes a dropzone. Tunnel details (size, prices) don't carry over. Continue?`)) return;
    const { data, error } = await sb.rpc('admin_convert_location', { p_kind: kind, p_name: original, p_location: location });
    if (error) { toast(`Not converted: ${error.message}`); return; }
    dirty = false;
    closeEditor();
    toast(`${original} is now a ${target === 'dz' ? 'dropzone' : 'wind tunnel'} · ${data}`);
    await loadPlaces();
    const moved = places.find((p) => p.kind === target && p.name === original);
    if (moved) openEditor(target, moved);
  });

  // Mostly for cleaning up bulk imports (/admin/import). Photos, suggestions
  // and reviews of the place go with it (admin_delete_location, 0094).
  $<HTMLButtonElement>('[data-delete]').addEventListener('click', async () => {
    if (!editing?.original) return;
    const { kind, original } = editing;
    if (!confirm(`Delete “${original}” with its photos, reviews and suggestions? This can’t be undone.`)) return;
    const { error } = await sb.rpc('admin_delete_location', { p_kind: kind, p_name: original });
    if (error) { toast(`Delete failed: ${error.message}`); return; }
    dirty = false;
    closeEditor();
    toast(`Deleted · ${original}`);
    await loadPlaces();
  });

  const setVal = (key: string, v: any) => { editing!.values[key] = v; dirty = true; clearError(key); };
  const sectionsOf = (kind: Kind) => (kind === 'dz' ? DZ_SECTIONS : TUNNEL_SECTIONS);

  function renderEditor() {
    fieldsBox.replaceChildren(...sectionsOf(editing!.kind).map((sec) => {
      const card = el('section', { class: `fcard${sec.wide ? ' wide' : ''}` }, el('h3', { textContent: sec.title }));
      for (const f of sec.fields) add(card, fieldEl(f));
      if (sec.extra === 'fill') add(card, fillEl());
      if (sec.extra === 'profile') add(card, profileEl());
      if (sec.extra === 'webcams') add(card, webcamsEl());
      if (sec.extra === 'gallery') add(card, galleryEl());
      return card;
    }));
  }

  // Every field sits in a [data-key] wrapper so errors can mark it.
  function wrap(key: string, label: string, hint: string | undefined, ...controls: (Node | false | null | undefined)[]) {
    return el('div', { class: 'field', 'data-key': key },
      el('span', {}, label, hint ? el('em', { textContent: ` · ${hint}` }) : null),
      ...controls,
      el('p', { class: 'err', hidden: true }),
    );
  }

  function fieldEl(f: Field): HTMLElement {
    const v = editing!.values[f.key];
    if (f.type === 'text' || f.type === 'number') {
      const renaming = f.key === 'name' && editing!.original !== null;
      const input = el('input', {
        type: f.type === 'number' ? 'number' : 'text', value: v ?? '', placeholder: f.placeholder ?? '',
        min: f.type === 'number' ? '0' : undefined, step: f.decimal ? '0.01' : undefined,
        oninput: (e: Event) => {
          const raw = (e.target as HTMLInputElement).value;
          setVal(f.key, f.type === 'number' ? (raw === '' ? null : f.decimal ? Math.round(Number(raw) * 100) / 100 : Math.round(Number(raw))) : raw);
          if (f.key === 'name' && !editing!.original) paintHead();
        },
      });
      return wrap(f.key, f.label, renaming ? 'renaming keeps photos, reviews, favourites and home DZs' : f.hint, input);
    }
    if (f.type === 'textarea') return richTextEl(f);
    if (f.type === 'select') {
      // A stored value outside the list still shows (and stays selected).
      const opts = v && !f.options!.some(([val]) => val === v) ? [...f.options!, [v, v] as [string, string]] : f.options!;
      return wrap(f.key, f.label, f.hint, el('select', { onchange: (e: Event) => setVal(f.key, (e.target as HTMLSelectElement).value || null) },
        ...opts.map(([val, label]) => el('option', { value: val, textContent: label, selected: (v ?? '') === val }))));
    }
    if (f.type === 'address') return addressEl(f);
    if (f.type === 'hours') return hoursEl(f);
    return chipsEl(f);
  }

  // Description: plain text with **bold**, [text](url) links and "- " bullet lines — the app's
  // RichDescription (ARC/components/RichDescription.tsx) renders the same
  // two markers. Toolbar buttons insert them; the preview mirrors the app.
  function richTextEl(f: Field): HTMLElement {
    const ta = el('textarea', { value: editing!.values[f.key] ?? '', placeholder: f.placeholder ?? '', rows: 8 });
    const preview = el('div', { class: 'rt-preview' });
    const commit = () => { setVal(f.key, ta.value); paintPreview(); };
    const paintPreview = () => {
      const blocks: HTMLElement[] = [];
      let para: string[] = [];
      let list: HTMLElement | null = null;
      // Same tokens as the app: **bold**, [text](url), bare www./https:// links.
      const TOKEN = /(\*\*[^*]+\*\*|\[[^\]]+\]\([^)\s]+\)|(?:https?:\/\/|www\.)[^\s<>()]+[^\s<>().,;:!?'"])/g;
      const href = (u: string) => (/^https?:\/\//i.test(u) ? u : `https://${u}`);
      const inline = (node: HTMLElement, text: string) => {
        for (const part of text.split(TOKEN).filter(Boolean)) {
          const md = part.match(/^\[([^\]]+)\]\(([^)\s]+)\)$/);
          if (part.length > 4 && part.startsWith('**') && part.endsWith('**')) node.append(el('strong', { textContent: part.slice(2, -2) }));
          else if (md || /^(https?:\/\/|www\.)/i.test(part)) {
            const url = href(md ? md[2] : part);
            node.append(el('a', { href: url, target: '_blank', rel: 'noopener', textContent: md ? md[1] : part.replace(/^https?:\/\//i, '') }));
          } else node.append(part);
        }
        return node;
      };
      const flush = () => { if (para.length) { blocks.push(inline(el('p'), para.join('\n'))); para = []; } list = null; };
      for (const line of ta.value.split('\n')) {
        if (/^\s*[-•*]\s+/.test(line)) {
          if (para.length) { blocks.push(inline(el('p'), para.join('\n'))); para = []; }
          if (!list) { list = el('ul'); blocks.push(list); }
          list.append(inline(el('li'), line.replace(/^\s*[-•*]\s+/, '')));
        } else if (!line.trim()) flush();
        else { list = null; para.push(line); }
      }
      flush();
      preview.replaceChildren(...(blocks.length ? blocks : [el('p', { class: 'rt-empty', textContent: 'Preview appears here.' })]));
    };

    // Wrap the selection in **…** (or insert a placeholder to type over).
    const bold = () => {
      const { selectionStart: a, selectionEnd: b, value } = ta;
      const sel = value.slice(a, b) || 'bold text';
      ta.setRangeText(`**${sel}**`, a, b, 'end');
      if (a === b) ta.setSelectionRange(a + 2, a + 2 + sel.length);
      ta.focus(); commit();
    };
    // Toggle "- " on every line the selection touches.
    const bullets = () => {
      const { selectionStart: a, selectionEnd: b, value } = ta;
      const start = value.lastIndexOf('\n', a - 1) + 1;
      const endIdx = value.indexOf('\n', b);
      const end = endIdx === -1 ? value.length : endIdx;
      const lines = value.slice(start, end).split('\n');
      const allOn = lines.every((l) => /^\s*[-•*]\s+/.test(l) || !l.trim());
      const next = lines.map((l) => (!l.trim() ? l : allOn ? l.replace(/^\s*[-•*]\s+/, '') : `- ${l}`)).join('\n');
      ta.setRangeText(next, start, end, 'select');
      ta.focus(); commit();
    };
    // Turn the selection into [text](url); without a selection insert a placeholder text.
    const link = () => {
      const { selectionStart: a, selectionEnd: b, value } = ta;
      const raw = prompt('Link address (https://…)');
      if (!raw?.trim()) return;
      const url = /^https?:\/\//i.test(raw.trim()) ? raw.trim() : `https://${raw.trim()}`;
      const label = value.slice(a, b) || 'link text';
      ta.setRangeText(`[${label}](${url})`, a, b, 'end');
      if (a === b) ta.setSelectionRange(a + 1, a + 1 + label.length);
      ta.focus(); commit();
    };
    ta.addEventListener('input', commit);
    ta.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'b') { e.preventDefault(); bold(); }
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); link(); }
      // Enter inside a bullet continues the list; Enter on an empty bullet ends it.
      if (e.key === 'Enter' && !e.shiftKey) {
        const { selectionStart: a, value } = ta;
        const lineStart = value.lastIndexOf('\n', a - 1) + 1;
        const line = value.slice(lineStart, a);
        if (/^\s*-\s+\S/.test(line)) { e.preventDefault(); ta.setRangeText('\n- ', a, ta.selectionEnd, 'end'); commit(); }
        else if (/^\s*-\s*$/.test(line)) { e.preventDefault(); ta.setRangeText('', lineStart, a, 'end'); commit(); }
      }
    });
    paintPreview();
    const toolbar = el('div', { class: 'rt-toolbar' },
      el('button', { type: 'button', class: 'rt-btn', title: 'Bold (⌘B)', onclick: bold }, el('strong', { textContent: 'B' })),
      el('button', { type: 'button', class: 'rt-btn', title: 'Bullet list', onclick: bullets, textContent: '• List' }),
      el('button', { type: 'button', class: 'rt-btn', title: 'Link (⌘K)', onclick: link, textContent: '🔗 Link' }),
      el('span', { class: 'rt-help', textContent: 'Select text, then click. Web addresses become links on their own.' }),
    );
    return wrap(f.key, f.label, f.hint, toolbar, ta, el('span', { class: 'rt-label', textContent: 'Preview · as shown in the app' }), preview);
  }

  function addressEl(f: Field): HTMLElement {
    const vals = editing!.values;
    const input = el('input', { type: 'text', value: vals.address ?? '', placeholder: f.placeholder, autocomplete: 'off', role: 'combobox', 'aria-autocomplete': 'list' });
    const list = el('ul', { class: 'ac-list', role: 'listbox', hidden: true });
    const pin = el('p', { class: 'pin' });
    let results: Geo[] = [];
    let active = -1;
    let timer: number | undefined;
    let seq = 0;

    const paintPin = () => {
      const has = vals.lat != null && vals.lng != null;
      pin.classList.toggle('none', !has);
      pin.replaceChildren(...(has
        ? ['📍 Pin set · ', el('a', { href: `https://www.google.com/maps?q=${vals.lat},${vals.lng}`, target: '_blank', rel: 'noopener', textContent: 'Check it on Google Maps ↗' }),
           ' · ', el('button', { type: 'button', class: 'link-btn', textContent: 'Remove pin', onclick: () => {
             // Clears the position only — pick an address or paste a Google
             // Maps link / "lat, lng" to set the new one (saving needs a pin).
             vals.lat = null; vals.lng = null; vals.address = ''; input.value = ''; dirty = true; paintPin(); input.focus();
           } })]
        : ['No pin yet — pick an address from the suggestions (or paste a Google Maps link).']));
    };
    const setText = (key: string, value: string) => {
      vals[key] = value;
      const other = fieldsBox.querySelector<HTMLInputElement>(`[data-key="${key}"] input`);
      if (other) other.value = value;
      clearError(key);
    };
    const choose = (g: Geo) => {
      vals.lat = +g.lat.toFixed(6);
      vals.lng = +g.lng.toFixed(6);
      vals._country = g.p.country ?? '';
      vals._city = cityOf(g.p);
      const text = formatAddress(g.p);
      input.value = text;
      vals.address = text;
      if (editing!.kind === 'dz') { if (g.p.country) setText('country', g.p.country); }
      else setText('location', [vals._city, vals._country].filter(Boolean).join(', '));
      const cur = CURRENCY_BY_COUNTRY[String(g.p.countrycode ?? '').toUpperCase()];
      if (cur && !vals.currency) {
        vals.currency = cur;
        const sel = fieldsBox.querySelector<HTMLSelectElement>('[data-key="currency"] select');
        if (sel) sel.value = cur;
        clearError('currency');
      }
      dirty = true;
      clearError('address');
      list.hidden = true;
      paintPin();
    };
    const paintList = () => {
      list.hidden = results.length === 0;
      list.replaceChildren(...results.map((g, i) => {
        const p = g.p;
        const title = p.name || [p.street, p.housenumber].filter(Boolean).join(' ') || cityOf(p) || p.country;
        const sub = [p.name ? [p.street, p.housenumber].filter(Boolean).join(' ') : '', [p.postcode, cityOf(p)].filter(Boolean).join(' '), p.country].filter(Boolean).join(', ');
        return el('li', { role: 'option', 'aria-selected': String(i === active), onmousedown: (e: Event) => { e.preventDefault(); choose(g); } },
          el('strong', { textContent: title }), sub && el('small', { textContent: sub }));
      }));
    };

    input.addEventListener('input', () => {
      vals.address = input.value;
      dirty = true;
      clearTimeout(timer);
      const q = input.value.trim();
      const link = urlIn(q);
      if (link && isShortMapsLink(link)) { input.value = link; useMapsLink(link); return; }
      if (link) { input.value = link; useMapsUrl(link); return; }
      if (parseCoords(q)) { useMapsUrl(q); return; }
      if (q.length < 3) { results = []; paintList(); return; }
      timer = window.setTimeout(async () => {
        const mine = ++seq;
        pin.textContent = 'Searching… (Enter searches right away)';
        try { const r = await searchAddress(q); if (mine === seq) { results = r; active = -1; paintList(); } } catch {}
        if (mine === seq) paintPin();
      }, 300);
    });
    // Pin from coordinates / a long Google Maps URL. The address text comes
    // from the reverse lookup; for a field in the middle of nowhere that may be
    // empty, so the place name from the link (or what Photon knows) is kept.
    async function useMapsUrl(url: string) {
      const coords = parseCoords(url);
      const place = placeFromMapsUrl(url);
      if (!coords) {
        if (place) { input.value = place; input.dispatchEvent(new Event('input')); return; } // search by name
        toast('No coordinates in that link — try “Share → Copy link” or paste “lat, lng”.');
        return;
      }
      // Pin right away (with the place name as address text); the street
      // address and country follow from the reverse lookup.
      choose({ lat: coords[0], lng: coords[1], p: {} });
      input.value = vals.address = place || `${coords[0].toFixed(5)}, ${coords[1].toFixed(5)}`;
      toast('📍 Pin set from the link — looking up the address…');
      const g = await reverseGeocode(coords[0], coords[1]).catch(() => null);
      if (vals.lat !== +coords[0].toFixed(6) || vals.lng !== +coords[1].toFixed(6)) return; // pin changed meanwhile
      if (!g) { toast('📍 Pin set — no address found there, check the country'); return; }
      choose({ ...g, lat: coords[0], lng: coords[1] });
      if (place && !vals.address.toLowerCase().includes(place.toLowerCase())) input.value = vals.address = `${place}, ${vals.address}`;
      toast('📍 Pin set from the link — check the address text');
    }
    // maps.app.goo.gl/… share links carry no coordinates; the edge function
    // follows the redirect (PROD only).
    async function useMapsLink(short: string) {
      if (env === 'test') { toast(PROD_ONLY); return; }
      toast('Opening the Google Maps link…');
      const { data, error } = await sb.functions.invoke('admin-fill-from-website', { body: { url: short, mode: 'resolve' } });
      if (error || !data?.url || isShortMapsLink(data.url)) {
        let msg = error?.message ?? 'no address came back';
        try { msg = (await (error as any)?.context?.json?.())?.error ?? msg; } catch {}
        toast(`Couldn’t open that link (${msg}) — paste the address or “lat, lng” instead.`);
        return;
      }
      await useMapsUrl(data.url);
    }

    input.addEventListener('keydown', async (e) => {
      if (e.key === 'Enter' && (list.hidden || !results.length)) {
        e.preventDefault();
        const q = input.value.trim();
        if (q.length < 3 || urlIn(q)) return;
        const mine = ++seq;
        pin.textContent = 'Searching…';
        const r = await searchAddressNow(q).catch(() => []);
        if (mine !== seq) return;
        paintPin();
        results = r; active = -1; paintList();
        if (!r.length) toast('No address found — try street, town and country');
        return;
      }
      if (list.hidden || !results.length) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); active = (active + 1) % results.length; paintList(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = (active - 1 + results.length) % results.length; paintList(); }
      else if (e.key === 'Enter') { e.preventDefault(); choose(results[Math.max(0, active)]); }
      else if (e.key === 'Escape') { list.hidden = true; }
    });
    input.addEventListener('blur', () => setTimeout(() => { list.hidden = true; }, 150));
    paintPin();
    return wrap(f.key, f.label, 'sets the pin and country', el('div', { class: 'ac' }, input, list), pin);
  }

  function chipsEl(f: Field): HTMLElement {
    // chipsText = stored as one comma-separated text (aircraft), chips = text[]
    const read = (): string[] => {
      const v = editing!.values[f.key];
      if (Array.isArray(v)) return v;
      return typeof v === 'string' && v.trim() ? v.split(/\s*[,;\n]\s*/).filter(Boolean) : [];
    };
    const write = (list: string[]) => setVal(f.key, f.type === 'chipsText' ? (list.join(', ') || null) : list);
    const box = el('div', { class: 'field' }, el('span', { textContent: f.label }));
    const chips = el('div', { class: 'chips' });
    const sugg = el('div', { class: 'chips' });
    const input = el('input', { type: 'text', placeholder: f.placeholder ?? 'Type and press Enter' });
    const paint = () => {
      const list = read();
      chips.replaceChildren(...list.map((item, i) => el('span', { class: 'chip' }, item,
        el('button', { type: 'button', 'aria-label': `Remove ${item}`, textContent: '✕', onclick: () => { write(list.filter((_, j) => j !== i)); paint(); } }))));
      sugg.replaceChildren(...(f.suggest ?? []).filter((s) => !list.includes(s)).map((s) =>
        el('button', { type: 'button', class: 'chip-suggest', textContent: `+ ${s}`, onclick: () => { write([...read(), s]); paint(); } })));
    };
    const commit = () => {
      const parts = input.value.split(',').map((s) => s.trim()).filter(Boolean);
      if (!parts.length) return;
      write([...read(), ...parts.filter((p) => !read().includes(p))]);
      input.value = '';
      paint();
    };
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); commit(); } });
    input.addEventListener('blur', commit);
    paint();
    add(box, chips, input, (f.suggest?.length ?? 0) > 0 && sugg);
    return box;
  }

  // Fixed hours are optional on top of the link: a toggle shows the
  // per-day inputs. Empty days stay empty (the app shows only filled days);
  // toggling off clears the hours on save.
  function hoursEl(f: Field): HTMLElement {
    const vals = editing!.values;
    if (vals._showHours === undefined) vals._showHours = !!(vals[f.key] ?? '').trim();
    const days = parseHours(vals[f.key]);
    const save = () => setVal(f.key, serializeHours(days) || null);
    const inputs = WEEKDAYS.map((d, i) => el('input', {
      type: 'text', value: days[i], placeholder: '',
      oninput: (e: Event) => { days[i] = (e.target as HTMLInputElement).value; save(); },
    }));
    const all = el('input', { type: 'text', placeholder: 'e.g. 09:00–sunset' });
    const applyAll = () => {
      days.fill(all.value.trim());
      inputs.forEach((inp) => (inp.value = all.value.trim()));
      save();
    };
    const body = el('div', { class: 'hours-body' },
      el('div', { class: 'inline' }, all, el('button', { type: 'button', textContent: 'Set every day', onclick: applyAll })),
      el('div', { class: 'hours' }, ...WEEKDAYS.map((d, i) => el('label', {}, d, inputs[i]))),
      el('p', { class: 'hint', textContent: 'Leave a day empty to not show it. Type “Closed” to say so explicitly.' }),
    );
    body.hidden = !vals._showHours;
    const toggle = el('input', { type: 'checkbox', checked: vals._showHours, onchange: (e: Event) => {
      vals._showHours = (e.target as HTMLInputElement).checked;
      body.hidden = !vals._showHours;
      dirty = true;
    } });
    return el('div', { class: 'field', 'data-key': f.key },
      el('label', { class: 'switch-row' }, toggle, el('span', { class: 'switch' }), el('span', {}, 'Also show fixed opening hours in the app')),
      body,
    );
  }

  // Same rule as the app (ARC/components/Webcams.tsx): direct image links,
  // and swisswebcams/Windy pages via their public current-picture JPEG.
  function webcamImageUrl(url: string): string | null {
    if (/\.(jpe?g|png|webp|gif)(\?|#|$)/i.test(url)) return url;
    if (!/(swisswebcams\.ch|windy\.com)/i.test(url)) return null;
    const id = url.match(/(?:webcam[:/]|zoom\/|webcams\/)(\d{9,11})/i)?.[1] ?? url.match(/\b(\d{10})\b/)?.[1];
    return id ? `https://images-webcams.windy.com/${id.slice(-2)}/${id}/current/normal/${id}.jpg` : null;
  }

  function webcamsEl(): HTMLElement {
    const box = el('div', { class: 'field' });
    const list = el('div', { class: 'cams' });
    const input = el('input', { type: 'url', placeholder: 'https://… webcam image or page' });
    const read = (): string[] => editing!.values.webcams ?? [];
    const paint = () => list.replaceChildren(...read().map((url, i) => {
      const img = webcamImageUrl(url);
      return el('div', { class: 'cam' },
        img ? el('img', { src: img, alt: '', loading: 'lazy' }) : el('span', { class: 'noimg', textContent: 'Web page' }),
        // Only http(s) links — webcams can come from user suggestions.
        el('a', { href: /^https?:\/\//i.test(url) ? url : '#', target: '_blank', rel: 'noopener', title: url, textContent: url.replace(/^https?:\/\/(www\.)?/i, '') }),
        el('button', { type: 'button', class: 'mini-btn', textContent: 'Remove', onclick: () => { setVal('webcams', read().filter((_, j) => j !== i)); paint(); } }),
      );
    }));
    const commit = () => {
      const url = input.value.trim();
      if (!url) return;
      if (!/^https?:\/\//i.test(url)) { toast('Webcam links need to start with http(s)://'); return; }
      setVal('webcams', [...read(), url]);
      input.value = '';
      paint();
    };
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); commit(); } });
    paint();
    add(box,
      el('span', {}, 'Webcams nearby', el('em', { textContent: ' · image links and swisswebcams/Windy pages show a live preview' })),
      list,
      el('div', { class: 'inline' }, input, el('button', { type: 'button', textContent: 'Add', onclick: commit })),
    );
    return box;
  }

  async function uploadImage(file: Blob, folder: string, mode: 'photo' | 'avatar' | 'ready' = 'photo'): Promise<string> {
    const { data: u } = await sb.auth.getUser();
    const blob = mode === 'ready' ? file : mode === 'avatar' ? await toAvatar(file) : await toJpeg(file as File);
    const path = `${u.user?.id}/admin/${folder}-${Date.now()}-${Math.random().toString(36).slice(2, 7)}.jpg`;
    const { error } = await sb.storage.from(BUCKET).upload(path, blob, { contentType: 'image/jpeg' });
    if (error) throw error;
    return path;
  }

  // File picker label that also accepts drag & drop.
  function dropZone(label: string, multiple: boolean, onFiles: (files: File[]) => void) {
    const input = el('input', { type: 'file', accept: 'image/*', multiple });
    const zone = el('label', { class: 'upload' }, label, input);
    const take = (list: FileList | null | undefined) => {
      const files = Array.from(list ?? []).filter((f) => f.type.startsWith('image/'));
      if (files.length) onFiles(multiple ? files : files.slice(0, 1));
    };
    input.addEventListener('change', () => { take(input.files); input.value = ''; });
    zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('drag'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('drag'));
    zone.addEventListener('drop', (e) => { e.preventDefault(); zone.classList.remove('drag'); take(e.dataTransfer?.files); });
    return zone;
  }

  // "Fill from website": the admin-fill-from-website edge function reads the
  // place's site and returns a draft (Claude). Only EMPTY fields are filled,
  // so nothing the admin typed is overwritten; the address goes through the
  // same Photon lookup as typing it, which sets the pin and country.
  function fillEl(): HTMLElement {
    const vals = editing!.values;
    const input = el('input', { type: 'url', value: vals.website ?? '', placeholder: 'https://… the dropzone’s or tunnel’s website' });
    const status = el('p', { class: 'hint', textContent: 'Reads the site (home, contact, prices, info pages) and drafts the fields below. Empty fields only — check everything before saving.' });
    const btn = el('button', { type: 'button', class: 'dark-btn small', textContent: 'Fill from website' });
    btn.addEventListener('click', async () => {
      const url = input.value.trim();
      if (!url) { toast('Paste the website address first'); return; }
      if (env === 'test') { status.textContent = PROD_ONLY; return; }
      btn.disabled = true;
      status.textContent = 'Reading the website… (10–30 seconds)';
      const { data, error } = await sb.functions.invoke('admin-fill-from-website', { body: { url, kind: editing!.kind } });
      btn.disabled = false;
      if (error || !data?.draft) {
        let msg = error?.message ?? 'No draft came back.';
        try { msg = (await (error as any)?.context?.json?.())?.error ?? msg; } catch {}
        status.textContent = `Couldn’t fill: ${msg}`;
        return;
      }
      const n = await applyDraft(data.draft, url);
      const warn = { tandem_only: '⚠️ The site looks tandem-only (nothing for fun jumpers). ', not_skydiving: '⚠️ This doesn’t look like a dropzone or tunnel. ', wind_tunnel: editing!.kind === 'dz' ? '⚠️ The site looks like a wind tunnel — switch the type? ' : '', dropzone: editing!.kind === 'tunnel' ? '⚠️ The site looks like a dropzone — switch the type? ' : '' }[data.draft.category as string] ?? '';
      status.textContent = `${warn}Filled ${n} field${n === 1 ? '' : 's'} from ${data.pages?.length ?? 1} page${data.pages?.length === 1 ? '' : 's'}.${data.draft.notes ? ` Note: ${data.draft.notes}` : ''} Please check everything before saving.`;
      toast(`✓ Filled ${n} fields — please review`);
    });
    return el('div', { class: 'field' }, el('div', { class: 'inline' }, input, btn), status);
  }

  async function applyDraft(d: any, url: string): Promise<number> {
    const ed = editing!;
    const v = ed.values;
    let n = 0;
    const empty = (x: any) => x == null || x === '' || (Array.isArray(x) && x.length === 0);
    const put = (key: string, val: any) => {
      if (empty(val) || !empty(v[key])) return;
      v[key] = val; n++;
    };
    if (!ed.original) put('name', d.name);
    put('website', d.website || url);
    put('phone', d.phone);
    put('description', d.description);
    put('facilities', d.facilities);
    put('hours_url', d.hours_url);
    if (Array.isArray(d.hours_per_day) && d.hours_per_day.some((x: string) => x?.trim()) && empty(v.hours)) {
      const week = Array.from({ length: 7 }, (_, i) => d.hours_per_day[i] ?? '');
      v.hours = serializeHours(week);
      v._showHours = true; n++;
    }
    if (ed.kind === 'dz') {
      put('altitude_m', d.altitude_m);
      put('aircraft', (d.aircraft ?? []).join(', ') || null);
      put('guest_ticket_price', d.guest_ticket_price);
      put('currency', d.currency);
      put('stay', d.stay);
      put('country', d.country);
    } else {
      put('location', d.location);
      for (const k of ['diameter', 'height', 'max_speed', 'price_no_coach_regular', 'price_coach_regular', 'pricing_times_note']) put(k, d[k]);
      put('currency', d.currency);
    }
    // Address → pin via the same lookup the address field uses.
    if (d.address && (v.lat == null || v.lng == null)) {
      try {
        const hit = (await searchAddressNow(d.address))[0] ?? (await searchAddress(d.address))[0];
        if (hit) {
          v.lat = +hit.lat.toFixed(6); v.lng = +hit.lng.toFixed(6);
          v._country = hit.p.country ?? ''; v._city = cityOf(hit.p);
          if (ed.kind === 'dz') { if (empty(v.country) && hit.p.country) v.country = hit.p.country; }
          else if (empty(v.location)) v.location = [v._city, v._country].filter(Boolean).join(', ');
        }
      } catch { /* pin stays empty — the admin picks the address by hand */ }
      if (empty(v.address)) { v.address = d.address; n++; }
    }
    dirty = true;
    paintHead();
    renderEditor();
    return n;
  }

  // Profile photo → avatar_path: the round icon on the map and at the top of
  // the place page. First thing in the form so it isn't mixed up with the gallery.
  function profileEl(): HTMLElement {
    const vals = editing!.values;
    const box = el('div', { class: 'profile-card' });
    // "Find logo": same logo search as /admin/import, options already squared.
    let logos: { blob: Blob; url: string }[] = [];
    let logoStatus = '';
    const findLogo = async () => {
      const url = String(vals.website ?? '').trim();
      if (!url) { toast('Add the website first (Contact section or Quick fill)'); return; }
      if (env === 'test') { logoStatus = PROD_ONLY; paint(); return; }
      logos.forEach((l) => URL.revokeObjectURL(l.url));
      logos = []; logoStatus = 'Looking for the logo on the website…'; paint();
      const { data, error } = await sb.functions.invoke('admin-fill-from-website', { body: { url, mode: 'logo' } });
      if (error) {
        let msg = error.message;
        try { msg = (await (error as any).context?.json?.())?.error ?? msg; } catch {}
        logoStatus = `Couldn’t search: ${msg}`; paint(); return;
      }
      for (const l of data?.logos ?? []) {
        try {
          const blob = await toAvatar(new Blob([Uint8Array.from(atob(l.data), (c) => c.charCodeAt(0))], { type: l.type }));
          logos.push({ blob, url: URL.createObjectURL(blob) });
        } catch { /* undecodable image */ }
      }
      logoStatus = logos.length ? 'Click one to use it:' : 'No logo found on the home page.';
      paint();
    };
    const useLogo = async (l: { blob: Blob }) => {
      toast('Uploading…');
      try {
        setVal('avatar_path', await uploadImage(l.blob, `${slug(vals.name || 'place')}-avatar`, 'ready'));
        paint();
        toast('✓ Profile photo ready — save to apply');
      } catch (e: any) { toast(`Upload failed: ${e.message}`); }
    };
    const paint = () => {
      const preview = vals.avatar_path
        ? el('img', { class: 'avatar-preview', src: photoUrl(env, vals.avatar_path), alt: 'Profile photo', onclick: () => openLightbox(photoUrl(env, vals.avatar_path)) })
        : el('div', { class: 'avatar-empty', textContent: 'No profile photo' });
      box.replaceChildren(preview, el('div', { class: 'field' },
        el('p', { class: 'hint', style: 'margin:0', textContent: 'The round icon on the map and at the top of the place page. Use the logo or a photo — it’s made square automatically (photos cropped to the centre, logos fitted on white). “Find logo on website” looks it up for you. Other pictures go in the gallery below.' }),
        el('div', { class: 'profile-actions' },
          dropZone(vals.avatar_path ? 'Replace profile photo' : 'Upload profile photo', false, async ([file]) => {
            toast('Uploading…');
            try {
              setVal('avatar_path', await uploadImage(file, `${slug(vals.name || 'place')}-avatar`, 'avatar'));
              paint();
              toast('✓ Profile photo ready — save to apply');
            } catch (e: any) { toast(`Upload failed: ${e.message}`); }
          }),
          el('button', { type: 'button', class: 'mini-btn', textContent: 'Find logo on website', onclick: findLogo }),
          vals.avatar_path && el('button', { type: 'button', class: 'mini-btn', textContent: 'Remove', onclick: () => { setVal('avatar_path', null); paint(); } }),
        ),
        logoStatus && el('p', { class: 'hint', style: 'margin:0', textContent: logoStatus }),
        logos.length > 0 && el('div', { class: 'logo-opts' }, ...logos.map((l, i) =>
          el('button', { type: 'button', class: 'logo-opt', title: 'Use this one', onclick: () => useLogo(l) }, el('img', { src: l.url, alt: `Logo option ${i + 1}` })))),
      ));
    };
    paint();
    return box;
  }

  // Gallery: on an existing place photos go live right away; on a new one
  // they wait here and upload right after the first save.
  function galleryEl(): HTMLElement {
    const box = el('div', { class: 'field' });
    const grid = el('div', { class: 'media' });
    const paint = () => {
      const ed = editing!;
      grid.replaceChildren(
        ...ed.gallery.map((p) => {
          const src = photoUrl(env, p.photo_path);
          return el('div', { class: 'media-item' },
            el('img', { src, alt: '', loading: 'lazy', onclick: () => openLightbox(src) }),
            el('button', { type: 'button', class: 'del', 'aria-label': 'Remove photo', textContent: '✕', onclick: async () => {
              if (!confirm('Remove this photo from the gallery?')) return;
              const { error } = await sb.rpc('admin_delete_location_photo', { p_kind: ed.kind, p_id: p.id });
              if (error) return toast(`Failed: ${error.message}`);
              ed.gallery = ed.gallery.filter((x) => x.id !== p.id);
              paint();
              toast('Photo removed');
            } }),
          );
        }),
        ...ed.pending.map((p) => el('div', { class: 'media-item pending' },
          el('img', { src: p.url, alt: '', onclick: () => openLightbox(p.url) }),
          el('span', { class: 'badge', textContent: 'Uploads on save' }),
          el('button', { type: 'button', class: 'del', 'aria-label': 'Remove photo', textContent: '✕', onclick: () => {
            URL.revokeObjectURL(p.url);
            ed.pending = ed.pending.filter((x) => x !== p);
            paint();
          } }),
        )),
      );
      count.textContent = `${ed.gallery.length + ed.pending.length} photo${ed.gallery.length + ed.pending.length === 1 ? '' : 's'}`;
    };
    const count = el('span');
    const zone = dropZone('+ Add photos — pick several or drop them here', true, async (files) => {
      const ed = editing!;
      if (!ed.original) {
        ed.pending.push(...files.map((file) => ({ file, url: URL.createObjectURL(file) })));
        dirty = true;
        paint();
        return;
      }
      toast(`Uploading ${files.length} photo${files.length > 1 ? 's' : ''}…`);
      try {
        await addGalleryPhotos(files);
        paint();
        toast(`✓ ${files.length} photo${files.length > 1 ? 's' : ''} added`);
      } catch (e: any) { toast(`Upload failed: ${e.message}`); }
    });
    paint();
    add(box, count, grid, zone);
    return box;
  }

  async function addGalleryPhotos(files: File[]) {
    const ed = editing!;
    const paths = await Promise.all(files.map((f) => uploadImage(f, slug(ed.original!))));
    const { error } = await sb.rpc('admin_add_location_photos', { p_kind: ed.kind, p_name: ed.original, p_paths: paths });
    if (error) throw error;
    await loadGallery();
  }

  async function loadGallery() {
    if (!editing?.original) return;
    const { kind, original } = editing;
    const { data } = await sb.from(kind === 'dz' ? 'dz_photos' : 'tunnel_photos')
      .select('*').eq(kind === 'dz' ? 'dz_name' : 'tunnel_name', original).eq('status', 'approved').order('created_at');
    editing.gallery = data ?? [];
  }

  // ---------- Validation ----------
  function clearError(key: string) {
    const w = fieldsBox.querySelector<HTMLElement>(`[data-key="${key}"]`);
    if (!w) return;
    w.classList.remove('invalid');
    const err = w.querySelector<HTMLElement>(':scope > .err');
    if (err) err.hidden = true;
  }
  function showErrors(errors: Record<string, string>) {
    let first: HTMLElement | null = null;
    for (const w of fieldsBox.querySelectorAll<HTMLElement>('[data-key]')) {
      const msg = errors[w.dataset.key!];
      w.classList.toggle('invalid', !!msg);
      const err = w.querySelector<HTMLElement>(':scope > .err');
      if (err) { err.hidden = !msg; err.textContent = msg ?? ''; }
      if (msg && !first) first = w;
    }
    if (first) {
      first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      first.querySelector<HTMLElement>('input, textarea, select')?.focus({ preventScroll: true });
    }
    const n = Object.keys(errors).length;
    toast(`Please fix ${n} field${n > 1 ? 's' : ''}`);
  }
  function validate(): Record<string, string> {
    const { kind, original, values: v } = editing!;
    const errors: Record<string, string> = {};
    const name = (v.name ?? '').trim();
    if (!name) errors.name = 'Give the place a name.';
    else if (name !== original && places.some((p) => p.kind === kind && p.name !== original && p.name.toLowerCase() === name.toLowerCase()))
      errors.name = `“${name}” already exists — open it from the list instead.`;
    else if (places.some((p) => p.kind !== kind && p.name.toLowerCase() === name.toLowerCase()))
      errors.name = `A ${kind === 'dz' ? 'tunnel' : 'dropzone'} is already called “${name}” — give this one its own name (e.g. the tunnel’s brand).`;
    if (v.lat == null || v.lng == null) errors.address = 'Pick an address from the suggestions so the pin can be placed.';
    if (kind === 'dz' && !(v.country ?? '').trim()) errors.country = 'Country is required — pick an address or type it.';
    if (kind === 'tunnel' && !(v.location ?? '').trim()) errors.location = 'Location is required, e.g. “Winterthur, Switzerland”.';
    if (kind === 'dz' && v.altitude_m != null && (v.altitude_m < 300 || v.altitude_m > 8000)) errors.altitude_m = 'Exit altitude in metres, e.g. 4000.';
    if (kind === 'dz' && v.guest_ticket_price != null && v.guest_ticket_price < 0) errors.guest_ticket_price = 'Can’t be negative.';
    if (kind === 'dz' && v.guest_ticket_price != null && !(v.currency ?? '').trim()) errors.currency = 'Which currency is the ticket price in?';
    const ic = (v.icao ?? '').trim();
    if (kind === 'dz' && ic && !/^[a-z0-9]{3,4}$/i.test(ic)) errors.icao = '3–4 letters or digits, e.g. LOIH.';
    const hu = (v.hours_url ?? '').trim();
    if (hu && (/\s/.test(hu) || !/^(https?:\/\/)?[^/]+\.[a-z]{2,}/i.test(hu))) errors.hours_url = 'That doesn’t look like a web address.';
    for (const k of ['price_no_coach_regular', 'price_no_coach_off', 'price_coach_regular', 'price_coach_off'])
      if (kind === 'tunnel' && v[k] != null && v[k] < 0) errors[k] = 'Can’t be negative.';
    return errors;
  }

  // ---------- Save ----------
  editor.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!editing) return;
    const errors = validate();
    if (Object.keys(errors).length) return showErrors(errors);

    const { kind, original, values } = editing;
    const payload: Record<string, any> = {};
    for (const f of sectionsOf(kind).flatMap((s) => s.fields)) {
      if (f.key === 'altitude_m' || (f.key === 'address' && kind === 'tunnel')) continue;
      let v = values[f.key];
      if (typeof v === 'string') v = v.trim() || null;
      payload[f.key] = v ?? (f.type === 'chips' ? [] : null);
    }
    if (kind === 'dz') {
      payload.altitude_ft = values.altitude_m == null ? null
        : values.altitude_m === values._alt_m0 ? values.altitude_ft
        : Math.round(values.altitude_m * FT_PER_M);
      payload.webcams = values.webcams ?? [];
    }
    if (payload.hours_url && !/^https?:\/\//i.test(payload.hours_url)) payload.hours_url = `https://${payload.hours_url}`;
    if (payload.icao) payload.icao = String(payload.icao).toUpperCase();
    if (!values._showHours) payload.hours = null;
    payload.lat = values.lat;
    payload.lng = values.lng;
    payload.avatar_path = values.avatar_path ?? null;

    const btn = $<HTMLButtonElement>('[data-save]');
    btn.disabled = true;
    // Rename first (admin_rename_location, 0095: moves photos, reviews,
    // favourites… to the new name), then save the fields under the new name.
    let target = original;
    if (original && payload.name && payload.name !== original) {
      if (!confirm(`Rename “${original}” to “${payload.name}”? Photos, reviews, favourites and home DZs move along; logbook entries keep the old name.`)) { btn.disabled = false; return; }
      const ren = await sb.rpc('admin_rename_location', { p_kind: kind, p_old: original, p_new: payload.name });
      if (ren.error) {
        btn.disabled = false;
        if (ren.error.message.includes('duplicate key')) return showErrors({ name: `“${payload.name}” already exists.` });
        if (ren.error.message.includes('Could not find the function')) { toast('Renaming needs migration 0095 in this database first.'); return; }
        toast(`Rename failed: ${ren.error.message}`);
        return;
      }
      target = ren.data as string;
      editing.original = target;
    }
    const { data, error } = await sb.rpc('admin_save_location', { p_kind: kind, p_original_name: target, p_data: payload });
    if (error) {
      btn.disabled = false;
      if (error.message.includes('duplicate key')) return showErrors({ name: `“${payload.name}” already exists.` });
      if (error.message.includes('Name is required')) return showErrors({ name: 'Give the place a name.' });
      toast(`Save failed: ${error.message}`);
      return;
    }

    // New place: now that it exists, upload the photos that were waiting.
    const waiting = editing.pending;
    if (!original && waiting.length) {
      editing.original = data;
      toast(`Saved — uploading ${waiting.length} photo${waiting.length > 1 ? 's' : ''}…`);
      try { await addGalleryPhotos(waiting.map((p) => p.file)); }
      catch (err: any) { toast(`Saved, but photo upload failed: ${err.message}`); }
      waiting.forEach((p) => URL.revokeObjectURL(p.url));
    }
    btn.disabled = false;
    dirty = false;
    toast(`✓ Saved · ${data}`);
    await loadPlaces();
    const saved = places.find((p) => p.kind === kind && p.name === data);
    if (saved) openEditor(kind, saved);
  });

  window.addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });

  // ---------- Demo (dev server + ?demo) ----------
  function demoClient(): SupabaseClient {
    const rows: Record<string, any[]> = {
      dropzones: [
        { name: 'Skydive Hohenems', country: 'Austria', lat: 47.3847, lng: 9.6997, altitude_ft: 13500, aircraft: '1× Cessna 208', hours: '9:00 am – sunset', website: 'skydivehohenems.at', facilities: ['Showers', 'WiFi'], stay: ['Camper-friendly'], webcams: ['https://www.foto-webcam.eu/webcam/dornbirn/current/400.jpg'], foehn_region: 'north', foehn_region_label: 'Alpennordseite · Rheintal', avatar_path: '/img/landing/map.jpg', description: 'Alpine backdrop with views over the **Rhine Valley**.\n\nGood to know:\n- Licensed jumpers only\n- Pay in **cash or TWINT**\n- Bring licence and repack card\n\nBoogie info: www.speckboogie.ch or [our calendar](https://www.skydive.ch/kalender).' },
        { name: 'Skydive Algarve', country: 'Portugal', lat: 37.13, lng: -8.62, facilities: [], stay: [], webcams: [] },
      ],
      tunnels: [{ name: 'Windwerk Winterthur', location: 'Winterthur, Switzerland', lat: 47.5, lng: 8.72, diameter: '4.3 m', hours: 'Tue–Fri 12:00–21:00 · Sat–Sun 10:00–20:00', currency: 'CHF', price_no_coach_regular: 900, facilities: ['Lockers'] }],
      dz_photos: [{ id: 'p1', dz_name: 'Skydive Hohenems', photo_path: '/img/landing/feed.jpg', status: 'approved' }],
      tunnel_photos: [],
    };
    const query = (table: string) => {
      const filters: [string, any][] = [];
      const api: any = {
        select: () => api, order: () => api,
        eq: (k: string, v: any) => { filters.push([k, v]); return api; },
        then: (res: any) => res({ data: rows[table].filter((r) => filters.every(([k, v]) => r[k] === v)), error: null }),
      };
      return api;
    };
    return { from: query, rpc: async (fn: string, args: any) => ({ data: fn === 'admin_save_location' ? (args.p_original_name ?? args.p_data.name) : null, error: null }), auth: { getUser: async () => ({ data: { user: { id: 'demo' } } }) }, storage: { from: () => ({ upload: async () => ({ error: null }) }) } } as any;
  }

  initAdmin(async (client, e) => {
    sb = client; env = e;
    if (editing && dirty && !confirm('Reload and discard your changes?')) return;
    editing = null; dirty = false;
    editor.hidden = true; listView.hidden = false;
    await loadPlaces();
    // /admin/places?open=<name> (links from Moderation) opens that place.
    const openName = new URLSearchParams(location.search).get('open');
    const toOpen = openName ? places.find((p) => p.name === openName) : undefined;
    if (toOpen) { await openEditor(toOpen.kind, toOpen); return; }
    // Dev preview of the editor: /admin/places?demo&edit (or &new).
    if (import.meta.env.DEV && location.search.includes('demo')) {
      if (location.search.includes('edit')) openEditor('dz', places.find((p) => p.kind === 'dz' && p.avatar_path)!);
      else if (location.search.includes('new')) {
        await openEditor('dz', null);
        if (location.search.includes('invalid')) editor.requestSubmit();
        const q = new URLSearchParams(location.search).get('q');
        if (q) {
          const a = fieldsBox.querySelector<HTMLInputElement>('[data-key="address"] input')!;
          a.value = q; a.dispatchEvent(new Event('input')); a.focus();
        }
      }
    }
  }, import.meta.env.DEV ? demoClient : undefined);
</script>
