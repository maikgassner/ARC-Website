<style>
  .toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
  .toolbar select { width: auto; min-width: 200px; }
  .toolbar [data-area] { width: auto; flex: 1 1 220px; max-width: 320px; }
  .grow { flex: 1; }
  .hint { color: var(--fg-3); font-size: .9rem; margin: 14px 0; max-width: 760px; }
  .cand-head { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin: 8px 0; font-weight: 700; color: var(--fg-2); }
  .cand-head label { display: flex; gap: 8px; align-items: center; cursor: pointer; }
  .cands { display: grid; gap: 8px; }
  :global(.cand) {
    display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center;
    padding: 12px 14px; border-radius: 16px; background: var(--surface); box-shadow: var(--shadow);
  }
  :global(.cand.off) { opacity: .5; }
  :global(.cand .tag) { margin-left: 8px; padding: 2px 8px; border-radius: 999px; background: #eef1f3; color: #54626c; font-size: .75rem; font-weight: 700; vertical-align: 2px; }
  :global(.cand strong) { display: block; }
  :global(.cand small) { display: block; color: var(--fg-3); font-size: .82rem; word-break: break-all; }
  :global(.cand .state) { font-size: .85rem; font-weight: 700; color: var(--fg-3); text-align: right; max-width: 320px; }
  :global(.cand .state.ok) { color: var(--ok); }
  :global(.cand .state.err) { color: var(--no); font-weight: 600; }
  :global(.cand input[type="checkbox"]), .cand-head input { width: 18px; height: 18px; accent-color: var(--fg); }
  .logos { margin-top: 48px; }
  .logos h2 { margin: 0; font-size: 1.3rem; }
  :global(.logo-row) { display: grid; grid-template-columns: minmax(160px, 1fr) auto; gap: 14px; align-items: center; padding: 12px 14px; border-radius: 16px; background: var(--surface); box-shadow: var(--shadow); }
  :global(.logo-row small) { display: block; color: var(--fg-3); font-size: .82rem; }
  :global(.logo-opts) { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  :global(.logo-opt) { padding: 3px; border-radius: 50%; border: 3px solid transparent; background: none; cursor: pointer; line-height: 0; }
  :global(.logo-opt img) { width: 64px; height: 64px; border-radius: 50%; box-shadow: 0 0 0 1px var(--border); }
  :global(.logo-opt[aria-pressed="true"]) { border-color: var(--fg); }
  :global(.logo-none) { font: 700 .85rem var(--font); color: var(--fg-3); background: var(--ink-100); border: 3px solid transparent; border-radius: 999px; padding: 8px 14px; cursor: pointer; }
  :global(.logo-none[aria-pressed="true"]) { border-color: var(--fg); color: var(--fg); }
  @media (max-width: 640px) { :global(.logo-row) { grid-template-columns: 1fr; } }
  .osm { color: var(--fg-3); font-size: .8rem; margin-top: 24px; }
  .osm a { color: inherit; }
  @media (max-width: 640px) { :global(.cand) { grid-template-columns: auto 1fr; } :global(.cand .state) { grid-column: 2; text-align: left; } }
</style>

<script>
  import type { SupabaseClient } from '@supabase/supabase-js';
  import { el, toast, initAdmin, showError, toAvatar, PROD_ONLY, BUCKET, type Env } from '../../lib/admin';

  // south, west, north, east — split so each Overpass query stays fast.
  // south, west, north, east — each region is cut into ~15°×20° tiles below,
  // because one big box times out on Overpass (North America did).
  const REGIONS: Record<string, [number, number, number, number]> = {
    europe: [34, -25, 72, 45],
    na_east: [7, -100, 72, -50],
    na_west: [7, -170, 72, -100],
    samerica: [-56, -95, 7, -30],
    africa_me: [-36, -20, 34, 65],
    asia: [-11, 45, 72, 180],
    oceania: [-50, 110, -11, 180],
  };
  function tiles([s, w, n, e]: number[], dLat = 15, dLng = 20): number[][] {
    const out: number[][] = [];
    for (let a = s; a < n; a += dLat) for (let b = w; b < e; b += dLng) out.push([a, b, Math.min(a + dLat, n), Math.min(b + dLng, e)]);
    return out;
  }
  const OVERPASS = ['https://overpass-api.de/api/interpreter', 'https://overpass.private.coffee/api/interpreter', 'https://overpass.kumi.systems/api/interpreter'];
  const FT_PER_M = 1 / 0.3048;
  const PARALLEL = 3;
  // Removed after review (2026-10-13): tandem-only operators and places that
  // aren't dropzones. Skipped before the website is even read; the draft's
  // `category` catches new ones.
  const NOT_FOR_ARC = new Set(['2dive.fr', 'accel-air.com', 'atlasparachutisme.com', 'fsgrefrath.de', 'mytandem.fr',
    'skydive-nuggets.de', 'skydiveseven.pt', 'parachutismelorraine.fr', 'bassella.com', 'rennefeld.de', 'paraservice.dk',
    'riggerloftet.dk', 'orduparagliding.com']);
  const SKIP_REASON: Record<string, string> = {
    tandem_only: 'Skipped — tandem only, nothing for fun jumpers',
    not_skydiving: 'Skipped — not a dropzone',
  };
  // Paragliding sites share the parachuting tag in OSM — never import them.
  const PARAGLIDING = /paraglid|parapente|gleitschirm|parapendio|yama[cç] para/i;

  type Kind = 'dz' | 'tunnel';
  type Cand = { id: string; kind: Kind; name: string; lat: number; lng: number; website: string; host: string; town: string; dup?: string; state?: string; err?: boolean };

  const $ = <T extends Element>(sel: string) => document.querySelector(sel) as T;
  const list = $<HTMLElement>('[data-cands]');
  const head = $<HTMLElement>('[data-cand-head]');
  const summary = $<HTMLElement>('[data-summary]');
  const progress = $<HTMLElement>('[data-progress]');
  const findBtn = $<HTMLButtonElement>('[data-find]');
  const importBtn = $<HTMLButtonElement>('[data-import]');
  const allBox = $<HTMLInputElement>('[data-all]');

  let sb: SupabaseClient;
  let env: Env = 'prod';
  let cands: Cand[] = [];
  const picked = new Set<string>();
  let running = false;

  const hostOf = (u: string) => { try { return new URL(/^https?:/i.test(u) ? u : `https://${u}`).hostname.replace(/^www\./, '').toLowerCase(); } catch { return ''; } };
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '');
  function km(a: { lat: number; lng: number }, b: { lat: number; lng: number }) {
    const r = Math.PI / 180, x = Math.sin((b.lat - a.lat) * r / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin((b.lng - a.lng) * r / 2) ** 2;
    return 12742 * Math.asin(Math.sqrt(x));
  }

  // Exact tag values use Overpass' index (seconds); a regex on `sport` scans
  // every sports pitch in the box and times out on big areas.
  async function overpass(bbox: number[]): Promise<any[]> {
    const box = bbox.join(',');
    const q = `[out:json][timeout:60];(${['skydiving', 'parachuting', 'indoor_skydiving'].map((v) => `nwr["sport"="${v}"](${box});`).join('')});out center tags;`;
    // Overpass allows ~2 requests per IP and answers 429/504 when busy:
    // retry the main server with a growing pause, other servers last.
    const order = [OVERPASS[0], OVERPASS[0], OVERPASS[1], OVERPASS[0], OVERPASS[2]];
    for (const [i, url] of order.entries()) {
      try {
        const res = await fetch(url, { method: 'POST', body: new URLSearchParams({ data: q }), signal: AbortSignal.timeout(45_000) });
        if (res.ok && res.headers.get('content-type')?.includes('json')) return (await res.json()).elements ?? [];
      } catch {}
      await new Promise((ok) => setTimeout(ok, 4000 * (i + 1)));
    }
    throw new Error('OpenStreetMap didn’t answer');
  }

  // A club often has several OSM objects (hangar, landing area, club house):
  // one candidate per website, preferring the airfield / named club.
  const RANK = (t: Record<string, string>) => (t.aeroway === 'aerodrome' ? 3 : t.club || t.leisure === 'sports_centre' ? 2 : t.name ? 1 : 0);

  const sourceSel = $<HTMLSelectElement>('[data-source]');
  const areaInput = $<HTMLInputElement>('[data-area]');
  const kindSel = $<HTMLSelectElement>('[data-kind]');
  const regionSel = $<HTMLSelectElement>('[data-region]');
  const paintSource = () => {
    const web = sourceSel.value === 'web';
    areaInput.hidden = kindSel.hidden = !web;
    regionSel.hidden = web;
  };
  sourceSel.addEventListener('change', paintSource);
  paintSource();

  // Web search (edge function, mode 'discover'): names + websites, no pin yet —
  // the pin comes from the address on the place's own site when importing.
  async function webCandidates(): Promise<{ cands: Cand[]; note: string }> {
    const area = areaInput.value.trim();
    if (!area) throw new Error('Type a country first, e.g. “Spain” or “USA – Florida”.');
    if (env === 'test') throw new Error(PROD_ONLY);
    const kind = kindSel.value as Kind;
    summary.textContent = `Searching the web for ${kind === 'tunnel' ? 'wind tunnels' : 'dropzones'} in ${area}… (30–90 seconds)`;
    const { data, error } = await sb.functions.invoke('admin-fill-from-website', { body: { mode: 'discover', area, kind } });
    if (error || !data?.places) {
      let msg = error?.message ?? 'No list came back.';
      try { msg = (await (error as any)?.context?.json?.())?.error ?? msg; } catch {}
      throw new Error(`Search failed: ${msg}`);
    }
    const cands = (data.places as { name: string; website: string; town: string }[])
      .filter((p) => !NOT_FOR_ARC.has(hostOf(p.website)) && !PARAGLIDING.test(`${p.name} ${p.website}`))
      .map((p, i) => ({ id: `web${i}`, kind, name: p.name, lat: NaN, lng: NaN, website: p.website, host: hostOf(p.website), town: [p.town, area.replace(/^USA\s*[–-]\s*(.+)$/i, '$1, USA')].filter(Boolean).join(', ') }));
    return { cands, note: `${data.searches ?? '?'} web searches · ` };
  }

  async function find() {
    findBtn.disabled = true; importBtn.disabled = true;
    list.replaceChildren(); head.hidden = true; picked.clear();
    try {
      const [dz, tu] = await Promise.all([
        sb.from('dropzones').select('name, lat, lng, website'),
        sb.from('tunnels').select('name, lat, lng, website'),
      ]);
      if (dz.error || tu.error) return showError((dz.error || tu.error)!.message);
      const existing = [...(dz.data ?? []), ...(tu.data ?? [])];
      const names = new Map(existing.map((p) => [norm(p.name), p.name]));
      const hosts = new Map(existing.filter((p) => p.website).map((p) => [hostOf(p.website), p.name]));
      const dupOf = (c: Cand) => names.get(norm(c.name)) ?? (c.host && hosts.get(c.host)) ?? (isNaN(c.lat) ? undefined : existing.find((p) => p.lat != null && km(p, c) < 2)?.name);
      const finish = (list: Cand[], note: string) => {
        cands = list.map((c) => ({ ...c, dup: dupOf(c) }))
          .sort((a, b) => Number(!!a.dup) - Number(!!b.dup) || Number(!a.website) - Number(!b.website) || a.name.localeCompare(b.name));
        const fresh = cands.filter((c) => !c.dup && c.website);
        fresh.forEach((c) => picked.add(c.id));
        summary.textContent = `${note}${cands.length} candidates · ${cands.filter((c) => c.dup).length} already in Arc · ${cands.filter((c) => !c.dup && !c.website).length} without a website · ${fresh.length} can be drafted. Tandem-only operators and places that aren’t dropzones are skipped automatically after reading their site — still untick anything obvious.`;
        head.hidden = false;
        render();
      };
      if (sourceSel.value === 'web') {
        const { cands: found, note } = await webCandidates();
        return finish(found, note);
      }

      summary.textContent = 'Asking OpenStreetMap…';
      const queue = tiles(REGIONS[regionSel.value]);
      const total = queue.length;
      const els: any[] = [];
      let done = 0, failed = 0;
      const worker = async () => {
        for (let t = queue.shift(); t; t = queue.shift()) {
          try { els.push(...(await overpass(t))); } catch { failed++; }
          summary.textContent = `Asking OpenStreetMap… ${++done} / ${total} areas`;
        }
      };
      summary.textContent = `Asking OpenStreetMap… 0 / ${total} areas`;
      await worker(); // one at a time — Overpass rate-limits parallel requests
      if (failed === total) throw new Error('OpenStreetMap didn’t answer — try again in a few minutes.');
      const best = new Map<string, { e: any; rank: number }>();
      for (const e of els) {
        const t = e.tags ?? {};
        const website = t.website || t['contact:website'] || t.url || '';
        const lat = e.lat ?? e.center?.lat, lng = e.lon ?? e.center?.lon;
        if (lat == null || (!t.name && !website)) continue;
        if (PARAGLIDING.test([t.sport, t.name, t.description, website].join(' '))) continue;
        if (NOT_FOR_ARC.has(hostOf(website))) continue;
        const key = hostOf(website) || `osm-${e.type}${e.id}`;
        const rank = RANK(t);
        if (!best.has(key) || rank > best.get(key)!.rank) best.set(key, { e: { ...e, lat, lon: lng, website }, rank });
      }
      finish([...best.values()].map(({ e }) => {
        const t = e.tags ?? {};
        return {
          id: `${e.type}${e.id}`, kind: /indoor/.test(t.sport ?? '') ? 'tunnel' : 'dz', name: t.name || hostOf(e.website), lat: e.lat, lng: e.lon,
          website: e.website ? (/^https?:/i.test(e.website) ? e.website : `https://${e.website}`) : '',
          host: hostOf(e.website), town: [t['addr:city'], t['addr:country']].filter(Boolean).join(', '),
        } as Cand;
      }), failed ? `⚠️ ${failed} of ${total} areas didn’t answer — run it again later to fill the gaps. ` : '');
    } catch (err: any) {
      summary.textContent = err.message;
    } finally {
      findBtn.disabled = false;
    }
  }

  function render() {
    const can = (c: Cand) => !c.dup && !!c.website && !c.state;
    list.replaceChildren(...cands.map((c) => {
      const box = el('input', { type: 'checkbox', checked: picked.has(c.id), disabled: !can(c) || running });
      box.addEventListener('change', () => { box.checked ? picked.add(c.id) : picked.delete(c.id); paint(); });
      const state = c.state ?? (c.dup ? `In Arc as “${c.dup}”` : !c.website ? 'No website' : '');
      return el('div', { class: `cand${can(c) || c.state ? '' : ' off'}` },
        box,
        el('div', {},
          el('strong', {}, c.name, c.kind === 'tunnel' ? el('span', { class: 'tag', textContent: 'Tunnel' }) : ''),
          el('small', {}, c.website ? el('a', { href: c.website, target: '_blank', rel: 'noopener', textContent: c.host }) : '', c.town ? ` · ${c.town}` : '')),
        el('span', { class: `state${c.state ? (c.err ? ' err' : ' ok') : ''}`, textContent: state }));
    }));
    paint();
  }

  function paint() {
    const selectable = cands.filter((c) => !c.dup && c.website && !c.state);
    importBtn.disabled = running || !selectable.some((c) => picked.has(c.id));
    importBtn.textContent = running ? 'Importing…' : `Import selected (${selectable.filter((c) => picked.has(c.id)).length})`;
    allBox.checked = selectable.length > 0 && selectable.every((c) => picked.has(c.id));
  }
  allBox.addEventListener('change', () => {
    cands.filter((c) => !c.dup && c.website && !c.state).forEach((c) => (allBox.checked ? picked.add(c.id) : picked.delete(c.id)));
    render();
  });

  // Prefer the address from the place's own site (geocoded like the editor
  // does); the OSM pin is only the fallback when that fails or lands far away.
  async function geocode(address: string): Promise<{ lat: number; lng: number; country?: string; city?: string } | null> {
    try {
      const res = await fetch(`https://photon.komoot.io/api/?q=${encodeURIComponent(address)}&limit=1&lang=en`);
      const f = res.ok ? (await res.json()).features?.[0] : null;
      return f ? { lng: f.geometry.coordinates[0], lat: f.geometry.coordinates[1], country: f.properties?.country, city: f.properties?.city ?? f.properties?.town ?? f.properties?.village } : null;
    } catch { return null; }
  }

  async function importOne(c: Cand, taken: Record<Kind, Set<string>>) {
    const set = (s: string, err = false) => { c.state = s; c.err = err; render(); };
    set('Reading website…');
    const { data, error } = await sb.functions.invoke('admin-fill-from-website', { body: { url: c.website, kind: c.kind } });
    if (error || !data?.draft) {
      let msg = error?.message ?? 'No draft came back.';
      try { msg = (await (error as any)?.context?.json?.())?.error ?? msg; } catch {}
      return set(msg, true);
    }
    const d = data.draft;
    if (SKIP_REASON[d.category]) return set(SKIP_REASON[d.category], true);
    // The site knows better than the OSM tag whether it's a tunnel.
    if (d.category === 'wind_tunnel') c.kind = 'tunnel';
    else if (d.category === 'dropzone') c.kind = 'dz';
    const name = (d.name || c.name).trim();
    if (PARAGLIDING.test([name, d.description, d.website].join(' '))) return set('Skipped — paragliding, not skydiving', true);
    if (taken[c.kind].has(norm(name))) return set(`Skipped — “${name}” already exists`, true);

    // Pin: the address on the place's own site. OSM candidates fall back to
    // their OSM point; web-search ones (no point) to "name, town".
    const noPoint = isNaN(c.lat);
    let pin = { lat: c.lat, lng: c.lng }, country = d.country || '', city = '';
    let g = d.address ? await geocode(d.address) : null;
    if (g && !noPoint && km(g, c) >= 30) g = null;
    if (!g && noPoint) g = (await geocode(`${name}, ${c.town}`)) ?? (c.town ? await geocode(c.town) : null);
    if (g) { pin = g; country ||= g.country ?? ''; city = g.city ?? ''; }
    else if (noPoint) return set('No address found on the site — add it by hand under Places', true);
    if (!country) country = (await reverseCountry(pin)) ?? '';

    // Tunnels: same basics plus the chamber specs; prices stay empty like the DZ ones.
    const payload = c.kind === 'tunnel' ? {
      name, lat: pin.lat, lng: pin.lng, location: d.location || [city, country].filter(Boolean).join(', ') || null,
      website: d.website || c.website, phone: d.phone || null, description: d.description || null,
      diameter: d.diameter || null, height: d.height || null, max_speed: d.max_speed || null, facilities: [],
    } : {
      name, lat: pin.lat, lng: pin.lng, country: country || null,
      address: d.address || null, website: d.website || c.website, phone: d.phone || null,
      altitude_ft: d.altitude_m ? Math.round(d.altitude_m * FT_PER_M) : null,
      aircraft: d.aircraft?.length ? d.aircraft.join(', ') : null,
      description: d.description || null, facilities: [], stay: [], webcams: [],
    };
    const { error: saveErr } = await sb.rpc('admin_save_location', { p_kind: c.kind, p_original_name: null, p_data: payload });
    if (saveErr) return set(saveErr.message.includes('duplicate key') ? `Skipped — “${name}” already exists` : `Save failed: ${saveErr.message}`, true);
    taken[c.kind].add(norm(name));
    set(`✓ Added as “${name}”${d.notes ? ` — ${d.notes}` : ''}`);
  }

  async function reverseCountry(p: { lat: number; lng: number }): Promise<string | null> {
    try {
      const res = await fetch(`https://photon.komoot.io/reverse?lat=${p.lat}&lon=${p.lng}&lang=en`);
      return res.ok ? (await res.json()).features?.[0]?.properties?.country ?? null : null;
    } catch { return null; }
  }

  importBtn.addEventListener('click', async () => {
    if (env === 'test') { toast(PROD_ONLY); return; }
    const queue = cands.filter((c) => picked.has(c.id) && !c.dup && c.website && !c.state);
    if (!queue.length || !confirm(`Draft and add ${queue.length} place${queue.length > 1 ? 's' : ''} to the database? Each takes 10–30 seconds; keep this tab open.`)) return;
    running = true; findBtn.disabled = true; render();
    const [dz, tu] = await Promise.all([sb.from('dropzones').select('name'), sb.from('tunnels').select('name')]);
    const taken = { dz: new Set((dz.data ?? []).map((p) => norm(p.name))), tunnel: new Set((tu.data ?? []).map((p) => norm(p.name))) };
    const total = queue.length;
    let done = 0;
    const worker = async () => {
      for (let c = queue.shift(); c; c = queue.shift()) {
        try { await importOne(c, taken); } catch (err: any) { c.state = err.message; c.err = true; }
        done++;
        progress.textContent = `${done} / ${total}`;
        render();
      }
    };
    progress.textContent = `0 / ${total}`;
    await Promise.all(Array.from({ length: PARALLEL }, worker));
    running = false; findBtn.disabled = false;
    const ok = cands.filter((c) => c.state?.startsWith('✓')).length;
    progress.textContent = `${ok} added · ${total - ok} not`;
    toast(`✓ Import finished — ${ok} added`);
    render();
  });

  findBtn.addEventListener('click', find);

  // ---------- Profile photos from the places' own logos ----------
  type LogoRow = { kind: Kind; name: string; website: string; opts: { blob: Blob; url: string }[]; pick: number; state?: string; err?: boolean };
  const logoList = $<HTMLElement>('[data-logo-list]');
  const logoSummary = $<HTMLElement>('[data-logo-summary]');
  const findLogosBtn = $<HTMLButtonElement>('[data-find-logos]');
  const saveLogosBtn = $<HTMLButtonElement>('[data-save-logos]');
  let logoRows: LogoRow[] = [];
  const slug = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'place';

  function renderLogos() {
    logoList.replaceChildren(...logoRows.map((r) => {
      const opts = el('div', { class: 'logo-opts' });
      if (r.state) opts.append(el('span', { class: `state ${r.err ? 'err' : 'ok'}`, textContent: r.state }));
      else if (!r.opts.length) opts.append(el('span', { class: 'state', textContent: 'Searching…' }));
      else {
        r.opts.forEach((o, i) => opts.append(el('button', { type: 'button', class: 'logo-opt', 'aria-pressed': String(r.pick === i), onclick: () => { r.pick = i; renderLogos(); } }, el('img', { src: o.url, alt: `Option ${i + 1}` }))));
        opts.append(el('button', { type: 'button', class: 'logo-none', 'aria-pressed': String(r.pick === -1), textContent: 'None', onclick: () => { r.pick = -1; renderLogos(); } }));
      }
      return el('div', { class: 'logo-row' },
        el('div', {}, el('strong', { textContent: r.name }), el('small', {}, el('a', { href: r.website, target: '_blank', rel: 'noopener', textContent: hostOf(r.website) }), r.kind === 'tunnel' ? ' · Tunnel' : '')),
        opts);
    }));
    const n = logoRows.filter((r) => !r.state && r.pick >= 0 && r.opts[r.pick]).length;
    saveLogosBtn.textContent = `Save selected (${n})`;
    saveLogosBtn.disabled = !n;
  }

  findLogosBtn.addEventListener('click', async () => {
    if (env === 'test') { logoSummary.textContent = PROD_ONLY; return; }
    findLogosBtn.disabled = true;
    const [dz, tu] = await Promise.all([
      sb.from('dropzones').select('name, website').is('avatar_path', null).not('website', 'is', null).order('name'),
      sb.from('tunnels').select('name, website').is('avatar_path', null).not('website', 'is', null).order('name'),
    ]);
    if (dz.error || tu.error) { findLogosBtn.disabled = false; return showError((dz.error || tu.error)!.message); }
    logoRows = [
      ...(dz.data ?? []).map((p) => ({ kind: 'dz' as Kind, name: p.name, website: p.website, opts: [], pick: 0 })),
      ...(tu.data ?? []).map((p) => ({ kind: 'tunnel' as Kind, name: p.name, website: p.website, opts: [], pick: 0 })),
    ];
    logoSummary.textContent = `Searching the websites of ${logoRows.length} places without a profile photo…`;
    renderLogos();
    const queue = [...logoRows];
    const worker = async () => {
      for (let r = queue.shift(); r; r = queue.shift()) {
        try {
          const { data, error } = await sb.functions.invoke('admin-fill-from-website', { body: { url: r.website, mode: 'logo' } });
          if (error) throw error;
          for (const l of data?.logos ?? []) {
            try {
              const bytes = Uint8Array.from(atob(l.data), (c) => c.charCodeAt(0));
              const blob = await toAvatar(new Blob([bytes], { type: l.type }));
              r.opts.push({ blob, url: URL.createObjectURL(blob) });
            } catch { /* undecodable image — skip */ }
          }
          if (!r.opts.length) { r.state = 'No logo found'; r.err = true; }
        } catch { r.state = 'Website didn’t answer'; r.err = true; }
        renderLogos();
      }
    };
    await Promise.all(Array.from({ length: 4 }, worker));
    // Places with options first, so the ones to look at are together.
    logoRows.sort((a, b) => Number(!!a.state) - Number(!!b.state) || a.name.localeCompare(b.name));
    const found = logoRows.filter((r) => r.opts.length).length;
    logoSummary.textContent = `Logos found for ${found} of ${logoRows.length} places. The first option is pre-selected — click another one or “None”, then save.`;
    findLogosBtn.disabled = false;
    renderLogos();
  });

  saveLogosBtn.addEventListener('click', async () => {
    const todo = logoRows.filter((r) => !r.state && r.pick >= 0 && r.opts[r.pick]);
    if (!todo.length || !confirm(`Save ${todo.length} profile photo${todo.length > 1 ? 's' : ''}?`)) return;
    saveLogosBtn.disabled = findLogosBtn.disabled = true;
    const { data: u } = await sb.auth.getUser();
    for (const r of todo) {
      const path = `${u.user?.id}/admin/${slug(r.name)}-avatar-${Date.now()}-${Math.random().toString(36).slice(2, 7)}.jpg`;
      const up = await sb.storage.from(BUCKET).upload(path, r.opts[r.pick].blob, { contentType: 'image/jpeg' });
      const save = up.error ? null : await sb.rpc('admin_save_location', { p_kind: r.kind, p_original_name: r.name, p_data: { avatar_path: path } });
      const err = up.error ?? save?.error;
      r.state = err ? `Failed: ${err.message}` : '✓ Saved';
      r.err = !!err;
      renderLogos();
    }
    findLogosBtn.disabled = false;
    toast(`✓ ${todo.filter((r) => !r.err).length} profile photos saved`);
  });

  initAdmin(async (client, e) => {
    sb = client; env = e;
    if (!running) { cands = []; list.replaceChildren(); head.hidden = true; paint(); }
  });
</script>
