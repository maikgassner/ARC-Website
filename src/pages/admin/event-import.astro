---
// Import events from outside calendars into Arc (ARC/supabase/migrations/
// 0126_event_import.sql). Sources: Swiss Skydive's Eventskalendar (an
// Elfsight widget whose settings JSON is public), and teams' / organisers'
// events pages, read on the server by Claude (admin-fill-from-website,
// mode 'events'; poster images when the dates are only on those). "All
// sources" reads every one of them at once. Each upcoming event is
// matched to an Arc dropzone / tunnel, checked here and imported one by one
// (admin_import_event); its cover image is copied into event-photos. An event
// already imported (events.source + source_id) shows as "In Arc".
import AdminShell from '../../layouts/AdminShell.astro';
---
<AdminShell title="Events" sub="Events in Arc: check, edit, create, or import from other calendars." active="event-import">
  <datalist id="places"></datalist>

  <!-- Events in Arc -->
  <div data-events-view>
    <div class="toolbar">
      <input type="search" placeholder="Search by title, place or organiser…" data-ev-search aria-label="Search">
      <div class="pills" role="tablist">
        <button type="button" data-when="upcoming" aria-selected="true">Upcoming</button>
        <button type="button" data-when="past" aria-selected="false">Past</button>
        <button type="button" data-when="all" aria-selected="false">All</button>
      </div>
      <div class="new-btns">
        <button type="button" class="ghost-btn" data-import>Import events</button>
        <button type="button" class="primary-btn small" data-new>+ New event</button>
      </div>
    </div>
    <p class="list-count" data-ev-count></p>
    <div class="ev-list" data-events></div>
  </div>

  <!-- Import from other calendars -->
  <div data-import-view hidden>
    <div class="toolbar">
      <button type="button" class="ghost-btn" data-back>← All events</button>
      <select data-source aria-label="Source"></select>
      <label class="check"><input type="checkbox" data-hide-assoc checked> Hide association meetings</label>
      <label class="check"><input type="checkbox" data-show-skipped> Show skipped</label>
      <span class="count" data-count></span>
      <span class="count read-at" data-read-at></span>
      <button type="button" class="ghost-btn small" data-reread>Read again</button>
    </div>
    <div class="list" data-list></div>
  </div>

  <!-- One event: new or edit -->
  <div data-editor-view hidden>
    <div class="toolbar"><button type="button" class="ghost-btn" data-back>← All events</button></div>
    <div class="list" data-editor></div>
  </div>
</AdminShell>

<style>
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 16px; }
  .toolbar select { padding: 9px 12px; border-radius: 12px; border: 1.5px solid var(--ink-100); font: inherit; background: var(--surface); }
  .check { display: flex; align-items: center; gap: 6px; font-size: .9rem; font-weight: 600; color: var(--fg-2); }
  .count { margin-left: auto; color: var(--fg-3); font-size: .85rem; font-weight: 600; }
  .count.read-at { margin-left: 0; }
  .list { display: grid; gap: 14px; margin-top: 18px; }
  .toolbar input[type="search"] { flex: 1 1 260px; width: auto; }
  .pills { display: flex; gap: 6px; }
  .pills button {
    border: 0; cursor: pointer; font: 600 .9rem var(--font); padding: 9px 16px; border-radius: 999px;
    background: var(--ink-100); color: var(--fg-2); white-space: nowrap;
  }
  .pills button[aria-selected="true"] { background: var(--fg); color: #fff; }
  .new-btns { display: flex; gap: 8px; margin-left: auto; }
  :global(.small) { padding: 10px 16px !important; font-size: .9rem !important; }
  .list-count { color: var(--fg-3); font-size: .9rem; margin: 18px 0 10px; }
  .ev-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
  :global(.ev-row) {
    display: flex; gap: 14px; align-items: center; text-align: left; cursor: pointer; width: 100%;
    padding: 12px; border-radius: 18px; border: 0; background: var(--surface); box-shadow: var(--shadow);
    font-family: var(--font); color: var(--fg); transition: transform .15s;
  }
  :global(.ev-row:hover) { transform: translateY(-2px); }
  :global(.ev-row.past) { opacity: .65; }
  :global(.ev-thumb) {
    width: 56px; height: 56px; flex: none; border-radius: 14px; display: grid; place-items: center;
    background: var(--coral-50); color: var(--accent-text); font-weight: 800; font-size: .75rem; line-height: 1.1; text-align: center;
  }
  :global(.ev-row strong) { display: block; font-size: 1rem; line-height: 1.3; }
  :global(.ev-row small) { display: block; color: var(--fg-3); font-size: .82rem; margin-top: 2px; }
  :global(.ev-row .ev-tags) { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 5px; font-size: .72rem; font-weight: 700; }
  /* A picture in its square frame, as the app shows it (events.photo_fit). */
  :global(.fit) { overflow: hidden; background-size: cover; background-position: center; }
  :global(.fit > img) { width: 100%; height: 100%; display: block; object-fit: cover; }
  :global(.fit.top > img) { object-position: top; }
  :global(.fit.bottom > img) { object-position: bottom; }
  :global(.fit.whole) { position: relative; }
  :global(.fit.whole::before) { content: ''; position: absolute; inset: -12px; background: inherit; filter: blur(10px); }
  :global(.fit.whole > img) { position: relative; object-fit: contain; }
  :global(.ev-fit) { font: inherit; font-size: .8rem; padding: 5px 8px; border-radius: 8px; border: 1.5px solid var(--ink-100); background: var(--surface); }
  :global(.ev) { display: grid; grid-template-columns: 132px 1fr; gap: 18px; padding: 18px; border-radius: 18px; background: var(--surface); box-shadow: var(--shadow); }
  :global(.ev.done) { opacity: .6; }
  :global(.ev-img) { width: 132px; height: 132px; border-radius: 14px; background-color: var(--ink-100); cursor: zoom-in; }
  :global(.ev-noimg) { width: 132px; height: 132px; border-radius: 14px; background: var(--ink-100); display: grid; place-items: center; color: var(--fg-3); font-size: .8rem; }
  :global(.ev-media) { display: grid; gap: 8px; align-content: start; }
  :global(.ev-upload) { font: inherit; font-size: .8rem; font-weight: 700; color: var(--action, #C64E2C); background: none; border: 0; padding: 0; cursor: pointer; text-align: left; }
  :global(.ev.draft) { outline: 2px dashed var(--ink-100); }
  :global(.ev-field input.not-on-arc) { border-color: #E8A33D; background: #FFF7E8; }
  :global(.ev-field .hint .warn) { color: #8A5A00; }
  :global(.ev-use) { font: inherit; font-weight: 700; color: var(--action, #C64E2C); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  :global(.ev-field .hint .warn a) { color: inherit; text-decoration: underline; }
  :global(.ev-body) { display: grid; gap: 10px; min-width: 0; }
  :global(.ev-meta) { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; font-size: .82rem; font-weight: 700; color: var(--fg-3); }
  :global(.ev-tag) { padding: 2px 8px; border-radius: 999px; background: var(--ink-100); color: var(--fg-2); }
  :global(.ev-tag.ok) { background: #E6F4EA; color: #1E6B34; }
  :global(.ev-grid) { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  :global(.ev-field) { display: grid; gap: 4px; font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-3); }
  :global(.ev-field.full) { grid-column: 1 / -1; }
  :global(.ev-field input), :global(.ev-field textarea), :global(.ev-field select) { font: inherit; font-size: .92rem; text-transform: none; letter-spacing: 0; color: var(--fg); padding: 8px 10px; border-radius: 10px; border: 1.5px solid var(--ink-100); background: var(--surface); }
  :global(.ev-field textarea) { min-height: 84px; resize: vertical; }
  :global(.ev-field .rt-toolbar), :global(.ev-field .rt-preview) { text-transform: none; letter-spacing: 0; font-weight: 500; }
  :global(.ev-field .rt-toolbar) { margin-top: 2px; }
  :global(.ev-field .hint) { font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--fg-3); }
  :global(.ev-discs) { display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.ev-disc) { padding: 5px 11px; border-radius: 999px; border: 1.5px solid var(--ink-100); background: var(--surface); font: inherit; font-size: .82rem; font-weight: 700; color: var(--fg-2); cursor: pointer; }
  :global(.ev-disc[aria-pressed="true"]) { background: var(--action, #C64E2C); border-color: transparent; color: #fff; }
  :global(.ev-actions) { display: flex; gap: 10px; align-items: center; justify-content: flex-end; }
  :global(.ev-actions a) { margin-right: auto; font-size: .85rem; font-weight: 700; }
  @media (max-width: 760px) {
    :global(.ev) { grid-template-columns: 1fr; }
    :global(.ev-grid) { grid-template-columns: 1fr; }
  }
</style>

<script>
  import type { SupabaseClient } from '@supabase/supabase-js';
  import { el, initAdmin, showError, toast, openLightbox } from '../../lib/admin';
  import { searchAddressNow } from '../../lib/maps';
  import { richTextEditor } from '../../lib/richText';

  // elfsight: an Elfsight "Event Calendar" widget — its settings (events,
  //   types, locations) come from the public endpoint the widget itself uses.
  // page: any events page; the Edge Function reads it (no CORS needed) and
  //   Claude lists the dated upcoming events. A new source is one line here.
  type Source = { id: string; label: string; organizer: string; page: string; skipTypes?: string[] }
    & ({ kind: 'elfsight'; widget: string } | { kind: 'page' } | { kind: 'manual' });
  // Events made here from scratch ("New event"): source 'admin', a random id.
  const MANUAL: Source = { kind: 'manual', id: 'admin', label: 'Created here', organizer: '', page: '' };
  const SOURCES: Source[] = [
    { kind: 'elfsight', id: 'swissskydive', label: 'Swiss Skydive · Eventskalendar', organizer: 'Swiss Skydive',
      page: 'https://home.swissskydive.org/eventskalendar', widget: '395c7aa7-b567-4849-8b41-3911faa0b3a3', skipTypes: ['Association'] },
    { kind: 'page', id: 'toratora', label: 'Tora Tora', organizer: 'Tora Tora', page: 'https://www.toratora.eu/events/' },
    { kind: 'page', id: 'fly4life', label: 'Fly4Life', organizer: 'Team Fly4Life', page: 'https://www.teamfly4life.com/events' },
    { kind: 'page', id: 'theapes', label: 'The Apes Freefly', organizer: 'The Apes Freefly', page: 'https://www.theapesfreefly.com/eventos-y-experiencias/' },
    { kind: 'page', id: 'movingdays', label: 'Moving Days', organizer: 'Moving Days', page: 'https://movingdayscamp.com' },
  ];
  const ALL = '__all';
  const DISCS = ['Freefly', 'Belly', 'Wingsuit', 'Angle', 'Speed', 'CRW', 'Canopy', 'Tunnel'];
  // Optional event type (events.category, 0131) — same keys as the app.
  const CATEGORIES: [string, string][] = [['', 'No type'], ['boogie', 'Boogie'], ['skills_camp', 'Skills camp'], ['competition', 'Competition'], ['other', 'Other']];
  function guessCategory(it: Item): string {
    const t = `${it.type} ${it.title}`.toLowerCase();
    if (/competition|championship|meisterschaft|world cup|\bcup\b|nationals|\bwm\b|\bsm\b/.test(t)) return 'competition';
    if (/boogie|festival|fest\b/.test(t)) return 'boogie';
    if (/camp|skill|clinic|masterclass|coach|course|training|ausbildung|week|invitational|experience/.test(t)) return 'skills_camp';
    return '';
  }

  type Place = { name: string; kind: 'dz' | 'tunnel'; lat: number | null; lng: number | null; website: string | null };
  type Item = {
    src: Source; id: string; title: string; start: string; end: string | null; type: string;
    locName: string; locAddress: string; locWebsite: string;
    description: string; image: string | null; link: string | null; price?: string;
    // Set while editing a card, so a re-render (filters, other imports) keeps it.
    file?: File; organizer?: string; arcPlace?: string; address?: string; geo?: { lat: number; lng: number };
    // Picture in its square frame (events.photo_fit, 0134); unset = middle.
    fit?: string;
    // Editing an event that's already in Arc: its id, and whether it's ours
    // (RLS lets the organiser change it, nobody else).
    editId?: string; mine?: boolean; photoPath?: string | null; discs?: string[]; category?: string;
  };

  let sb: SupabaseClient;
  let selected: Source[] = SOURCES;
  let items: Item[] = [];
  // "New event" forms, on top until imported (not affected by the filters).
  let drafts: Item[] = [];
  let failed: string[] = [];
  let places: Place[] = [];
  let imported = new Set<string>(); // `${source}|${source_id}`
  // Left out on purpose ("Skip", event_import_skips, 0135): same keys.
  let skipped = new Set<string>();
  const key = (it: Item) => `${it.src.id}|${it.id}`;
  const q = <T extends Element>(s: string) => document.querySelector<T>(s)!;

  // Accents, case and filler words don't count when comparing names.
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()
    .replace(/\b(skydive|skydiving|paraclub|para|centro|dropzone|indoor|flugplatz|fallschirm\w*)\b/g, ' ')
    .replace(/[^a-z0-9]+/g, ' ').trim();
  const host = (u: string | null | undefined) => {
    if (!u) return '';
    try { return new URL(u.startsWith('http') ? u : `https://${u}`).hostname.replace(/^www\./, ''); } catch { return ''; }
  };
  // Website domain first (most reliable), then the name, then the town in the address.
  function matchPlace(it: Item): Place | null {
    const h = host(it.locWebsite);
    if (h) { const byHost = places.find((p) => host(p.website) === h); if (byHost) return byHost; }
    const n = norm(it.locName);
    if (n) {
      const byName = places.find((p) => { const pn = norm(p.name); return !!pn && (pn === n || pn.includes(n) || n.includes(pn)); });
      if (byName) return byName;
    }
    const town = norm(it.locAddress.replace(/^.*\b\d{4}\s+/, ''));
    return town ? places.find((p) => norm(p.name).split(' ').includes(town)) ?? null : null;
  }
  // Address → pin (Nominatim: one lookup at a time, ~1/s, each address once).
  const geoCache = new Map<string, Promise<{ lat: number; lng: number } | null>>();
  let geoQueue: Promise<unknown> = Promise.resolve();
  function geocode(address: string): Promise<{ lat: number; lng: number } | null> {
    const k = address.trim().toLowerCase();
    if (!k) return Promise.resolve(null);
    if (!geoCache.has(k)) {
      const run = geoQueue.then(async () => {
        const [g] = await searchAddressNow(address).catch(() => []);
        await new Promise((r) => setTimeout(r, 1100));
        return g ? { lat: g.lat, lng: g.lng } : null;
      });
      geoQueue = run.catch(() => {});
      geoCache.set(k, run);
    }
    return geoCache.get(k)!;
  }
  function kmBetween(a: { lat: number; lng: number }, b: { lat: number; lng: number }) {
    const r = Math.PI / 180, x = Math.sin(((b.lat - a.lat) * r) / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(((b.lng - a.lng) * r) / 2) ** 2;
    return 12742 * Math.asin(Math.sqrt(x));
  }
  function nearestPlace(at: { lat: number; lng: number }): { place: Place; km: number } | null {
    let best: { place: Place; km: number } | null = null;
    for (const p of places) {
      if (p.lat == null || p.lng == null) continue;
      const km = kmBetween(at, { lat: p.lat, lng: p.lng });
      if (!best || km < best.km) best = { place: p, km };
    }
    return best;
  }
  function guessDiscs(it: Item, place: Place | null): string[] {
    const t = `${it.title} ${it.description}`.toLowerCase();
    const out = new Set<string>();
    if (place?.kind === 'tunnel' || /\bindoor\b|tunnel/.test(t)) out.add('Tunnel');
    if (/freefly/.test(t)) out.add('Freefly');
    if (/\bbelly\b|\bfs\b|formation/.test(t)) out.add('Belly');
    if (/wingsuit|\bws\b/.test(t)) out.add('Wingsuit');
    if (/\bangle\b|tracking/.test(t)) out.add('Angle');
    if (/\bspeed\b/.test(t)) out.add('Speed');
    if (/\bcrw\b|canopy formation/.test(t)) out.add('CRW');
    if (/accuracy|swoop|canopy piloting/.test(t)) out.add('Canopy');
    return DISCS.filter((d) => out.has(d));
  }
  // HTML description → plain text with paragraph breaks.
  function htmlToText(html: string) {
    const doc = new DOMParser().parseFromString(html.replace(/<br\s*\/?>/gi, '\n').replace(/<\/(div|p|li)>/gi, '\n'), 'text/html');
    return (doc.body.textContent ?? '').replace(/\n{3,}/g, '\n\n').trim();
  }
  const today = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };
  const fmt = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  // A page event has no id of its own: title + start day stand in for one.
  const slug = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  async function fetchSource(src: Source): Promise<Item[]> {
    if (src.kind === 'manual') return [];
    if (src.kind === 'page') {
      const { data, error } = await sb.functions.invoke('admin-fill-from-website', { body: { mode: 'events', url: src.page } });
      if (error) {
        const msg = await (error as any).context?.json?.().then((j: any) => j?.error).catch(() => null);
        throw new Error(msg ?? error.message);
      }
      return ((data?.events ?? []) as any[]).map((e): Item => ({
        src, id: `${slug(e.title)}-${e.start}`, title: String(e.title ?? '').trim(),
        start: e.start, end: e.end && e.end !== e.start ? e.end : null, type: '',
        locName: e.place ?? '', locAddress: '', locWebsite: '',
        description: e.description ?? '', image: null, link: e.link ?? null, price: e.price ?? undefined,
      })).sort((a, b) => a.start.localeCompare(b.start));
    }
    const url = `https://core.service.elfsight.com/p/boot/?page=${encodeURIComponent(src.page)}&w=${src.widget}`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(`Calendar didn't load (${res.status})`);
    const json = await res.json();
    const st = json?.data?.widgets?.[src.widget]?.data?.settings;
    if (!st?.events) throw new Error('Calendar has no events (the widget changed?)');
    const types = new Map<string, string>((st.eventTypes ?? []).map((t: any) => [t.id, t.name]));
    const locs = new Map<string, any>((st.locations ?? []).map((l: any) => [l.id, l]));
    const from = today();
    return (st.events as any[])
      .map((e): Item => {
        const loc = locs.get(e.location?.[0]) ?? {};
        const link = (e.actions ?? []).find((a: any) => a.link?.value)?.link.value ?? null;
        return {
          src, id: String(e.id), title: String(e.name ?? '').trim(),
          start: e.start?.date, end: e.end?.date && e.end.date !== e.start?.date ? e.end.date : null,
          type: types.get(e.eventType?.[0]) ?? '',
          locName: loc.name ?? '', locAddress: loc.address ?? '', locWebsite: loc.website ?? '',
          description: htmlToText(e.description ?? ''),
          image: e.coverImage?.url ?? e.images?.[0]?.url ?? null,
          link,
        };
      })
      .filter((e) => e.start && (e.end ?? e.start) >= from)
      .sort((a, b) => a.start.localeCompare(b.start));
  }

  // Already in Arc under another id (made by hand, or the source's title
  // changed since): the dates overlap and the titles share most words.
  const words = (t: string) => new Set(t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
    .replace(/\b(20\d\d|the|and|der|die|das|und|de|la|le|el|by|with|at|in)\b/g, ' ')
    .split(/[^a-z0-9]+/).filter((w) => w.length > 1));
  function sameInArc(it: Item): boolean {
    const mine = words(it.title);
    if (!mine.size || !it.start) return false;
    const itEnd = it.end ?? it.start;
    return events.some((e) => {
      const eEnd = e.end_date ?? e.event_date;
      if (!e.event_date || e.event_date > itEnd || eEnd < it.start) return false;
      const theirs = words(e.title ?? '');
      const shared = [...mine].filter((w) => theirs.has(w)).length;
      return shared > 0 && shared / Math.min(mine.size, theirs.size || 1) >= 0.6;
    });
  }

  function render() {
    const hideAssoc = q<HTMLInputElement>('[data-hide-assoc]').checked;
    // Events already in Arc don't show here: they're in the list (edit them there).
    const relevant = items.filter((it) => !(hideAssoc && it.src.skipTypes?.includes(it.type)));
    const notInArc = relevant.filter((it) => !imported.has(key(it)) && !sameInArc(it));
    const inArc = relevant.length - notInArc.length;
    const showSkipped = q<HTMLInputElement>('[data-show-skipped]').checked;
    const nSkipped = notInArc.filter((it) => skipped.has(key(it))).length;
    const shown = showSkipped ? notInArc : notInArc.filter((it) => !skipped.has(key(it)));
    q('[data-count]').textContent = `${notInArc.length - nSkipped} to import${inArc ? ` · ${inArc} already in Arc` : ''}${nSkipped ? ` · ${nSkipped} skipped` : ''}`;
    const list = q<HTMLElement>('[data-list]');
    const problems = failed.map((f) => el('p', { class: 'note', textContent: `⚠︎ ${f}` }));
    list.replaceChildren(...problems, ...(shown.length ? shown.map(card) : [el('p', { class: 'note', textContent: inArc ? 'Everything upcoming here is in Arc already.' : 'No upcoming events here.' })]));
  }

  // A card re-renders its own view (image picked, fit changed…).
  const rerender = () => (editing ? renderEditor() : render());

  function card(it: Item) {
    const done = !it.editId && imported.has(key(it));
    const isEdit = !!it.editId;
    const isSkipped = !isEdit && skipped.has(key(it));
    const readOnly = isEdit && !it.mine;
    const place = matchPlace(it);
    const field = (label: string, input: HTMLElement, opts: { full?: boolean; hint?: string } = {}) =>
      el('label', { class: `ev-field${opts.full ? ' full' : ''}` }, label, input, opts.hint && el('span', { class: 'hint', textContent: opts.hint }));

    const title = el('input', { value: it.title, placeholder: 'e.g. Freefly Boogie 2027' });
    const start = el('input', { type: 'date', value: it.start });
    const end = el('input', { type: 'date', value: it.end ?? '' });
    // Dropzone: an Arc dropzone / tunnel from the list, or — marked — free
    // text (then either keep it, or add the place in Places first).
    // Address: optional, shown next to the dropzone; its pin suggests the
    // nearest place on Arc and puts the event on the map.
    const placeIn = el('input', { value: it.arcPlace ?? place?.name ?? (it.locAddress ? it.locName : ''), placeholder: 'Pick a dropzone or tunnel' });
    placeIn.setAttribute('list', 'places');
    const addressIn = el('input', { value: it.address ?? (place ? it.locAddress : it.locAddress || it.locName), placeholder: 'Optional, e.g. Flugplatz 1, 6845 Hohenems' });
    const placeHint = el('span', { class: 'hint' });
    const suggestion = el('span', { class: 'hint' });
    const paintPlace = () => {
      const onArc = places.find((p) => p.name === placeIn.value.trim());
      const empty = !placeIn.value.trim();
      placeIn.classList.toggle('not-on-arc', !onArc && !empty);
      placeHint.replaceChildren(
        onArc ? `✓ On Arc (${onArc.kind === 'tunnel' ? 'tunnel' : 'dropzone'}), the event links to it`
        : empty ? (addressIn.value.trim() ? 'None: the event shows the address only' : 'No place')
        : el('span', { class: 'warn' }, 'Not on Arc: saved as free text, no link. ',
            el('a', { href: '/admin/places', target: '_blank', rel: 'noopener', textContent: 'Add it in Places ↗' }),
            ' then pick it here.'),
      );
    };
    // Nearest place on Arc to the address, one click to take it.
    let geoFor = '';
    const suggest = async () => {
      const address = addressIn.value.trim();
      geoFor = address;
      if (!address) { it.geo = undefined; suggestion.replaceChildren(); return; }
      suggestion.replaceChildren('Looking up the address…');
      const at = await geocode(address);
      if (geoFor !== address) return;
      it.geo = at ?? undefined;
      const near = at && nearestPlace(at);
      suggestion.replaceChildren(
        !at ? el('span', { class: 'warn' }, 'Address not found on the map: saved as text, no pin.')
        : !near ? ''
        : near.place.name === placeIn.value.trim() ? `✓ ${near.km < 1 ? 'Under 1' : Math.round(near.km)} km from the address`
        : el('span', {}, `Nearest on Arc: ${near.place.name} (${Math.round(near.km)} km) `,
            el('button', { type: 'button', class: 'ev-use', textContent: 'Use it', onclick: () => {
              placeIn.value = near.place.name; it.arcPlace = placeIn.value; paintPlace(); suggest();
            } })),
      );
    };
    paintPlace();
    suggest();
    placeIn.addEventListener('input', paintPlace);
    let addressTimer = 0;
    addressIn.addEventListener('input', () => {
      it.address = addressIn.value; paintPlace();
      clearTimeout(addressTimer); addressTimer = window.setTimeout(suggest, 800);
    });
    const organizer = el('input', { value: it.organizer ?? it.src.organizer, placeholder: 'Who runs it, e.g. Skydive Empuriabrava' });
    const link = el('input', { value: it.link ?? '', placeholder: 'https://' });
    const price = el('input', { value: it.price ?? '', placeholder: 'e.g. EUR 350 incl. 10 jumps, or Free', maxLength: 60 });
    const desc = richTextEditor(it.description, 'Who is it for, what to bring, meeting point…', (v) => { it.description = v; });
    const picked = new Set(it.discs ?? guessDiscs(it, place));
    const category = el('select', {}, ...CATEGORIES.map(([v, l]) => el('option', { value: v, textContent: l })));
    category.value = it.category ?? guessCategory(it);
    category.addEventListener('change', () => { it.category = category.value; });
    const discs = el('div', { class: 'ev-discs' }, ...DISCS.map((d) => {
      const b = el('button', { type: 'button', class: 'ev-disc', textContent: d, 'aria-pressed': String(picked.has(d)) });
      b.addEventListener('click', () => { picked.has(d) ? picked.delete(d) : picked.add(d); it.discs = [...picked]; b.setAttribute('aria-pressed', String(picked.has(d))); });
      return b;
    }));

    // Edits live on the item, so a re-render doesn't lose them.
    title.addEventListener('input', () => { it.title = title.value; });
    start.addEventListener('input', () => { it.start = start.value; });
    end.addEventListener('input', () => { it.end = end.value || null; });
    placeIn.addEventListener('input', () => { it.arcPlace = placeIn.value; });
    organizer.addEventListener('input', () => { it.organizer = organizer.value; });
    link.addEventListener('input', () => { it.link = link.value || null; });
    price.addEventListener('input', () => { it.price = price.value; });

    const isDraft = it.src.kind === 'manual';
    const label = isEdit ? 'Save changes' : isDraft ? 'Create event' : 'Import';
    const btn = el('button', { type: 'button', class: 'primary-btn small', textContent: done ? 'In Arc' : label, disabled: done || readOnly });
    btn.addEventListener('click', async () => {
      if (!title.value.trim() || !start.value) return toast('Title and start date are needed');
      if (!organizer.value.trim()) return toast('Who organises it?');
      if (!placeIn.value.trim() && !addressIn.value.trim()) return toast('Where is it? A dropzone or an address');
      btn.disabled = true; btn.textContent = isEdit ? 'Saving…' : 'Importing…';
      try {
        const p = places.find((x) => x.name === placeIn.value.trim()) ?? null;
        const dzText = p?.name ?? placeIn.value.trim();
        const address = addressIn.value.trim();
        const pin = address ? await geocode(address) : null;
        // An event in Arc keeps its picture unless a new one was picked.
        const photo_path = isEdit ? (it.file ? await copyImage(it) : it.photoPath ?? null)
          : it.file || it.image ? await copyImage(it) : null;
        const data = {
          organizer_name: organizer.value.trim(),
          title: title.value.trim(), event_date: start.value, end_date: end.value && end.value !== start.value ? end.value : null,
          // Arc shows `place`: the dropzone, then the address (if any).
          place: address.toLowerCase().startsWith(dzText.toLowerCase()) ? address : [dzText, address].filter(Boolean).join(', '),
          dz_name: p?.kind === 'dz' ? p.name : null,
          lat: pin?.lat ?? p?.lat ?? null, lng: pin?.lng ?? p?.lng ?? null, photo_path,
          description: desc.textarea.value.trim(), discs: [...picked], website: link.value.trim() || null,
          category: category.value || null,
          price: price.value.trim() || null,
          photo_fit: photo_path ? it.fit ?? null : null,
        };
        const { error } = isEdit
          ? await sb.from('events').update({ ...data, updated_at: new Date().toISOString() }).eq('id', it.editId!)
          : await sb.rpc('admin_import_event', { p_data: { ...data, source: it.src.id, source_id: it.id } });
        if (error) throw error;
        toast(`${isEdit ? 'Saved' : isDraft ? 'Created' : 'Imported'}: ${title.value.trim()}`);
        if (isEdit || isDraft) { drafts = drafts.filter((d) => d !== it); showList(); loadEvents(); return; }
        imported.add(key(it));
        render();
      } catch (e: any) {
        btn.disabled = false; btn.textContent = label;
        showError(e?.message ?? String(e));
      }
    });

    // Own picture: picked here, uploaded on import (replaces the source's).
    const fileInput = el('input', { type: 'file', accept: 'image/jpeg,image/png,image/webp', hidden: true });
    fileInput.addEventListener('change', () => {
      const f = fileInput.files?.[0];
      if (!f) return;
      if (f.size > 8 * 1024 * 1024) return toast('That image is over 8 MB');
      it.file = f;
      it.image = URL.createObjectURL(f);
      it.fit = undefined;
      rerender();
    });
    // How the picture sits in the app's square frame; a picture that isn't
    // square (a flyer) starts out whole.
    const fit = el('select', { class: 'ev-fit', 'aria-label': 'Picture fit' }, ...FITS.map(([v, l]) => el('option', { value: v, textContent: l })));
    fit.value = it.fit ?? 'center';
    fit.addEventListener('change', () => { it.fit = fit.value; rerender(); });
    const preview = it.image ? framed(it.image, it.fit, 'ev-img') : null;
    preview?.addEventListener('click', () => openLightbox(it.image!));
    if (preview && !it.fit) {
      const probe = new Image();
      probe.onload = () => {
        if (it.fit || !probe.naturalWidth) return;
        if (Math.abs(probe.naturalWidth / probe.naturalHeight - 1) > 0.05) { it.fit = 'whole'; rerender(); }
      };
      probe.src = it.image!;
    }
    const img = el('div', { class: 'ev-media' },
      preview ?? el('div', { class: 'ev-noimg', textContent: 'No image' }),
      !!it.image && !readOnly && fit,
      !done && !readOnly && el('button', { type: 'button', class: 'ev-upload', textContent: it.image ? 'Change image' : 'Upload image', onclick: () => fileInput.click() }),
      !done && it.file && el('button', { type: 'button', class: 'ev-upload', textContent: 'Remove image', onclick: () => { it.file = undefined; it.image = it.photoPath ? photoUrl(it.photoPath) : null; rerender(); } }),
      fileInput,
    );

    // Not for Arc: hidden from this list for every admin (Show skipped brings it back).
    const skipBtn = el('button', { type: 'button', class: 'ev-upload', textContent: isSkipped ? 'Unskip' : 'Skip this one' });
    skipBtn.addEventListener('click', async () => {
      skipBtn.disabled = true;
      const k = { source: it.src.id, source_id: it.id };
      const { error } = isSkipped
        ? await sb.from('event_import_skips').delete().match(k)
        : await sb.from('event_import_skips').insert({ ...k, title: it.title, event_date: it.start });
      if (error) { skipBtn.disabled = false; return showError(error.message); }
      isSkipped ? skipped.delete(key(it)) : skipped.add(key(it));
      toast(isSkipped ? `Back in the list: ${it.title}` : `Skipped: ${it.title}`);
      render();
    });

    return el('article', { class: `ev${done || isSkipped ? ' done' : ''}${isDraft && !isEdit ? ' draft' : ''}` },
      img,
      el('div', { class: 'ev-body' },
        el('div', { class: 'ev-meta' },
          isEdit ? el('span', { class: 'ev-tag ok', textContent: 'In Arc' })
            : isDraft ? el('span', { class: 'ev-tag', textContent: 'New event' }) : el('span', { textContent: it.end ? `${fmt(it.start)} – ${fmt(it.end)}` : fmt(it.start) }),
          readOnly && el('span', { class: 'warn', textContent: `Made in the app by ${it.organizer}: only they can change it` }),
          !isDraft && selected.length > 1 && el('span', { class: 'ev-tag', textContent: it.src.label }),
          it.type && el('span', { class: 'ev-tag', textContent: it.type }),
          it.locName && el('span', { textContent: `📍 ${it.locName}` }),
          done && el('span', { class: 'ev-tag ok', textContent: 'In Arc' }),
          isSkipped && el('span', { class: 'ev-tag', textContent: 'Skipped' }),
        ),
        el('div', { class: 'ev-grid' },
          field('Title', title, { full: true }),
          field('Start', start), field('End', end, { hint: 'Empty for a one-day event' }),
          el('label', { class: 'ev-field full' }, 'Dropzone', placeIn, placeHint),
          el('label', { class: 'ev-field full' }, 'Address', addressIn, suggestion),
          field('Organizer', organizer, { full: true, hint: 'Shown as the event\'s organiser in Arc' }),
          field('Link', link, { full: true }),
          field('Entry price', price, { full: true, hint: 'Optional: what signing up costs, as the organiser writes it' }),
          el('div', { class: 'ev-field full' }, 'Description', desc.toolbar, desc.textarea, desc.label, desc.preview),
          field('Type', category, { hint: 'Optional' }),
          field('Disciplines', discs, { full: true }),
        ),
        el('div', { class: 'ev-actions' },
          isEdit
            ? (it.mine ? el('button', { type: 'button', class: 'ev-upload', textContent: 'Delete event', onclick: () => deleteEvent(it) }) : el('span'))
            : isDraft
            ? el('button', { type: 'button', class: 'ev-upload', textContent: 'Discard', onclick: () => { drafts = drafts.filter((d) => d !== it); showList(); } })
            : el('a', { href: it.link || it.src.page, target: '_blank', rel: 'noopener', textContent: `Open on ${it.src.label} ↗` }),
          !isEdit && !isDraft && !done && skipBtn,
          btn,
        ),
      ),
    );
  }

  // The cover image goes into event-photos under the admin's own folder,
  // like a photo picked in the app.
  async function copyImage(it: Item): Promise<string | null> {
    try {
      let blob: Blob;
      if (it.file) blob = it.file;
      else {
        const res = await fetch(it.image!);
        if (!res.ok) return null;
        blob = await res.blob();
      }
      const ext = blob.type === 'image/png' ? 'png' : blob.type === 'image/webp' ? 'webp' : 'jpg';
      const { data: { user } } = await sb.auth.getUser();
      const path = `${user!.id}/import-${it.src.id}-${it.id}.${ext}`;
      const { error } = await sb.storage.from('event-photos').upload(path, blob, { contentType: blob.type || 'image/jpeg', upsert: true });
      return error ? null : path;
    } catch { return null; }
  }

  const FITS: [string, string][] = [['top', 'Show top'], ['center', 'Show middle'], ['bottom', 'Show bottom'], ['whole', 'Show whole']];
  const photoUrl = (path: string) => sb.storage.from('event-photos').getPublicUrl(path).data.publicUrl;
  // The picture in its square frame, cut or whole like in the app.
  function framed(src: string, fit: string | undefined | null, cls: string) {
    const box = el('div', { class: `fit ${fit ?? 'center'} ${cls}` }, el('img', { src, alt: '', loading: 'lazy' }));
    if (fit === 'whole') box.style.backgroundImage = `url("${src.replace(/"/g, '%22')}")`;
    return box;
  }

  // ---------- Events in Arc ----------
  let events: any[] = [];
  let when: 'upcoming' | 'past' | 'all' = 'upcoming';
  let myId = '';
  let editing: Item | null = null;

  function show(view: 'events' | 'import' | 'editor') {
    q<HTMLElement>('[data-events-view]').hidden = view !== 'events';
    q<HTMLElement>('[data-import-view]').hidden = view !== 'import';
    q<HTMLElement>('[data-editor-view]').hidden = view !== 'editor';
    window.scrollTo({ top: 0 });
  }
  function showList() { editing = null; show('events'); renderEvents(); }

  async function loadEvents() {
    q('[data-ev-count]').textContent = 'Loading…';
    const { data, error } = await sb.from('events').select('*').order('event_date', { ascending: true });
    if (error) { q('[data-ev-count]').textContent = ''; return showError(error.message); }
    events = data ?? [];
    renderEvents();
  }

  function renderEvents() {
    const from = today();
    const fold = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    const term = fold(q<HTMLInputElement>('[data-ev-search]').value);
    const isPast = (e: any) => (e.end_date ?? e.event_date) < from;
    let shown = events.filter((e) => when === 'all' || (when === 'past') === isPast(e));
    if (when === 'past') shown = [...shown].reverse();
    if (term) shown = shown.filter((e) => fold([e.title, e.place, e.dz_name, e.organizer_name].filter(Boolean).join(' ')).includes(term));
    q('[data-ev-count]').textContent = `${shown.length} ${when === 'all' ? '' : when + ' '}event${shown.length === 1 ? '' : 's'}${term ? ' found' : ' in Arc'}`;
    q<HTMLElement>('[data-events]').replaceChildren(...shown.map((e) => {
      const d = e.event_date ? new Date(`${e.event_date}T12:00:00`) : null;
      const thumb = e.photo_path ? framed(photoUrl(e.photo_path), e.photo_fit, 'ev-thumb')
        : el('div', { class: 'ev-thumb' }, d ? `${d.toLocaleString('en', { month: 'short' }).toUpperCase()}\n${d.getDate()}` : '–');
      thumb.style.whiteSpace = 'pre-line';
      const cat = CATEGORIES.find(([v]) => v === e.category)?.[1];
      return el('button', { type: 'button', class: `ev-row${isPast(e) ? ' past' : ''}`, onclick: () => openEvent(e) },
        thumb,
        el('div', { style: 'min-width:0' },
          el('strong', { textContent: e.title }),
          el('small', { textContent: [e.end_date ? `${fmt(e.event_date)} – ${fmt(e.end_date)}` : fmt(e.event_date), e.place].filter(Boolean).join(' · ') }),
          el('div', { class: 'ev-tags' },
            cat && el('span', { class: 'ev-tag', textContent: cat }),
            e.visibility === 'private' && el('span', { class: 'ev-tag', textContent: 'Private' }),
            el('span', { class: 'ev-tag', textContent: e.source && e.source !== 'admin' ? `Imported · ${SOURCES.find((x) => x.id === e.source)?.label ?? e.source}` : e.organizer_id === myId ? 'By Arc' : `By ${e.organizer_name}` }),
          ),
        ),
      );
    }));
    if (!shown.length) q<HTMLElement>('[data-events]').replaceChildren(el('p', { class: 'note', textContent: term ? 'No event matches.' : when === 'past' ? 'No past events.' : 'No upcoming events yet. Import some or create one.' }));
  }

  // An event in Arc as an editable card: the dropzone and the address come
  // apart again from `place` ("Dropzone, address").
  function openEvent(e: any) {
    const dz = places.find((p) => p.name === e.dz_name) ?? places.find((p) => e.place?.startsWith(p.name));
    const address = dz ? (e.place ?? '').slice(dz.name.length).replace(/^[\s,·]+/, '') : '';
    editing = {
      src: { ...MANUAL, id: e.source ?? 'admin' }, id: e.source_id ?? e.id,
      title: e.title, start: e.event_date, end: e.end_date, type: '',
      locName: '', locAddress: '', locWebsite: '',
      description: e.description ?? '', image: e.photo_path ? photoUrl(e.photo_path) : null, link: e.website ?? null,
      price: e.price ?? '', organizer: e.organizer_name, arcPlace: dz?.name ?? e.place ?? '', address,
      discs: e.discs ?? [], category: e.category ?? '', fit: e.photo_fit ?? (e.photo_path ? 'center' : undefined),
      editId: e.id, mine: e.organizer_id === myId, photoPath: e.photo_path ?? null,
    };
    renderEditor();
    show('editor');
  }
  function renderEditor() { if (editing) q<HTMLElement>('[data-editor]').replaceChildren(card(editing)); }

  async function deleteEvent(it: Item) {
    if (!confirm(`Delete "${it.title}" from Arc? People who said they're going lose it too.`)) return;
    const { error } = await sb.from('events').delete().eq('id', it.editId!);
    if (error) return showError(error.message);
    toast(`Deleted: ${it.title}`);
    showList();
    loadEvents();
  }

  async function loadPlaces() {
    const [dz, tu] = await Promise.all([
      sb.from('dropzones').select('name, lat, lng, website'),
      sb.from('tunnels').select('name, lat, lng, website'),
    ]);
    if (dz.error || tu.error) throw dz.error || tu.error;
    places = [
      ...(dz.data ?? []).map((p: any) => ({ ...p, kind: 'dz' as const })),
      ...(tu.data ?? []).map((p: any) => ({ ...p, kind: 'tunnel' as const })),
    ];
    q('#places').replaceChildren(...places.map((p) => el('option', { value: p.name, label: p.kind === 'tunnel' ? 'Tunnel' : 'Dropzone' })));
  }

  // What a source returned stays in this tab (sessionStorage) until "Read
  // again": switching sources, going back to the list or reloading the page
  // doesn't read the pages (Claude calls) again.
  const cacheKey = (src: Source) => `arc-evimport:${(sb as any).supabaseUrl ?? ''}:${src.id}`;
  let readAt: number | null = null;
  async function readSource(src: Source, fresh: boolean): Promise<Item[]> {
    if (!fresh) {
      try {
        const raw = sessionStorage.getItem(cacheKey(src));
        if (raw) {
          const cached = JSON.parse(raw) as { at: number; items: Omit<Item, 'src'>[] };
          readAt = Math.min(readAt ?? cached.at, cached.at);
          return cached.items.map((it) => ({ ...it, src }));
        }
      } catch { /* no storage: read the page */ }
    }
    const list = await fetchSource(src);
    const at = Date.now();
    readAt = Math.min(readAt ?? at, at);
    try {
      sessionStorage.setItem(cacheKey(src), JSON.stringify({ at, items: list.map(({ src: _s, file: _f, ...rest }) => rest) }));
    } catch { /* full or blocked: just not kept */ }
    return list;
  }

  async function load(fresh = false) {
    readAt = null;
    const reading = selected.length > 1 ? `Reading ${selected.length} sources… (the pages take a few seconds each)` : `Reading ${selected[0].label}…`;
    q<HTMLElement>('[data-list]').replaceChildren(el('p', { class: 'note', textContent: reading }));
    q('[data-count]').textContent = '';
    try {
      const [fetched, done, skips] = await Promise.all([
        Promise.allSettled(selected.map((src) => readSource(src, fresh))),
        sb.from('events').select('source, source_id').in('source', selected.map((s) => s.id)),
        sb.from('event_import_skips').select('source, source_id').in('source', selected.map((s) => s.id)),
      ]);
      if (done.error) throw done.error;
      // Before 0135 is on this database there's no table: nothing skipped.
      skipped = new Set((skips.data ?? []).map((r: any) => `${r.source}|${r.source_id}`));
      // One source failing (site down) doesn't hide the others.
      failed = fetched.flatMap((r, i) => (r.status === 'rejected' ? [`Couldn't read ${selected[i].label}: ${r.reason?.message ?? r.reason}`] : []));
      items = fetched.flatMap((r) => (r.status === 'fulfilled' ? r.value : [])).sort((a, b) => a.start.localeCompare(b.start));
      imported = new Set((done.data ?? []).map((r: any) => `${r.source}|${r.source_id}`));
      q('[data-read-at]').textContent = readAt ? `Read ${new Date(readAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}` : '';
      render();
    } catch (e: any) {
      q<HTMLElement>('[data-list]').replaceChildren();
      showError(e?.message ?? String(e));
    }
  }

  const select = q<HTMLSelectElement>('[data-source]');
  select.replaceChildren(
    el('option', { value: ALL, textContent: `All sources (${SOURCES.length})` }),
    ...SOURCES.map((s) => el('option', { value: s.id, textContent: s.label })),
  );
  select.addEventListener('change', () => {
    selected = select.value === ALL ? SOURCES : SOURCES.filter((s) => s.id === select.value);
    load();
  });
  q('[data-new]').addEventListener('click', () => {
    editing = { src: MANUAL, id: crypto.randomUUID(), title: '', start: '', end: null, type: '',
      locName: '', locAddress: '', locWebsite: '', description: '', image: null, link: null, discs: [] };
    drafts = [editing];
    renderEditor();
    show('editor');
  });
  // The sources are only read here (the page sources cost a Claude call each).
  q('[data-import]').addEventListener('click', () => {
    show('import');
    load();
  });
  q('[data-reread]').addEventListener('click', () => load(true));
  document.querySelectorAll<HTMLElement>('[data-back]').forEach((b) => b.addEventListener('click', () => { showList(); loadEvents(); }));
  q('[data-ev-search]').addEventListener('input', renderEvents);
  document.querySelectorAll<HTMLButtonElement>('[data-when]').forEach((b) => b.addEventListener('click', () => {
    when = b.dataset.when as typeof when;
    document.querySelectorAll('[data-when]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    renderEvents();
  }));
  q('[data-hide-assoc]').addEventListener('change', render);
  q('[data-show-skipped]').addEventListener('change', render);

  initAdmin(async (client) => {
    sb = client;
    myId = (await sb.auth.getUser()).data.user?.id ?? '';
    showList();
    try { await loadPlaces(); } catch (e: any) { showError(e?.message ?? String(e)); }
    await loadEvents();
  });
</script>
