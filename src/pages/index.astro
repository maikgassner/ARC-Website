---
// Landing page — rebuilt from the Claude Design export (ARC/docs/ARC Website v2.html).
// Own nav/footer instead of the Base layout; the legal + support pages keep Base.
import '../styles/landing.css';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Arc — Your digital skydive logbook</title>
  <meta name="description" content="The logbook and skydiving network you've been waiting for. Log every jump in seconds, watch your skills grow and connect with jumpers at every dropzone.">
  <meta property="og:title" content="Arc — Your digital skydive logbook">
  <meta property="og:description" content="The logbook and skydiving network you've been waiting for.">
  <meta property="og:image" content="/img/arc-icon-512.png">
  <meta name="theme-color" content="#b23a22">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png">
  <link rel="apple-touch-icon" href="/img/arc-icon-512.png">
  <link rel="preload" href="/fonts/jakarta-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>

<!-- ============================ HERO ============================ -->
<header id="home" class="hero">
  <div class="glow"></div>

  <nav class="nav wrap">
    <a href="#home" class="brand" aria-label="Arc">
      <svg viewBox="0 0 60.06 60.06" width="32" height="32" aria-hidden="true"><rect width="60.06" height="60.06" rx="14" fill="rgba(255,255,255,.16)"/><path d="M51.4,42.07c-2.88-.14-8.31-12.01-21.36-12.01-13.85,0-19.6,12.22-21.21,12.22-4.81,0,8.18-24.5,21.31-24.5s25.48,24.5,21.26,24.29Z" fill="#fff"/></svg>
      <span>Arc</span>
    </a>
    <div class="nav-links">
      <a href="#home" class="active">Home</a>
      <a href="#mission">About Arc</a>
      <a href="#about">About us</a>
      <a href="#contact">Contact</a>
    </div>
    <a href="#waitlist" class="nav-cta"><span class="dot"></span>Coming soon</a>
  </nav>

  <div class="hero-body wrap">
    <div class="overline">Logbook · Skill profile · Network</div>
    <h1>Your digital skydive logbook.</h1>
    <p class="hero-lede">The logbook and skydiving network you've been waiting for. Log every jump in seconds, watch your skills grow and connect with jumpers at every dropzone.</p>

    <div id="waitlist" class="waitlist">
      <div class="badge"><span class="dot"></span>Coming soon to iOS</div>
      <div data-waitlist-open>
        <form class="waitlist-form" data-form="waitlist">
          <input required type="email" name="email" placeholder="Your email" aria-label="Your email">
          <button type="submit" class="btn-coral">Join the waitlist</button>
        </form>
        <p class="waitlist-note">Be the first to know when Arc launches. No spam, just the launch.</p>
        <p class="waitlist-error" data-waitlist-error hidden>Something went wrong. Please try again.</p>
      </div>
      <div class="waitlist-done" data-waitlist-done hidden>You're on the list. We'll email you at launch.</div>
      <a href="#mission" class="link-underline">See what's inside</a>
    </div>

    <div class="hero-phones">
      <div class="phone"><img src="/img/landing/logbook.jpg" alt="Logbook" width="640" height="1385"></div>
      <div class="phone center"><img src="/img/landing/profile.jpg" alt="Profile" width="640" height="1385"></div>
      <div class="phone"><img src="/img/landing/map.jpg" alt="Map" width="640" height="1385"></div>
    </div>
  </div>
</header>

<main>
<!-- ======================= ABOUT ARC / FEATURES ======================= -->
<section id="mission" class="mission wrap">
  <div class="mission-head">
    <div>
      <div class="overline">About Arc · Our mission</div>
      <h2 class="section-title">The logbook that keeps up with you.</h2>
    </div>
    <p class="lede">Paper logbooks get lost, spreadsheets are a chore. Arc turns every jump into a clean record and shows you where you stand: across disciplines, dropzones and years.</p>
  </div>

  <div class="features">

    <!-- 01 Logbook -->
    <div class="feature">
      <div class="stage">
        <div class="phone"><img src="/img/landing/logbook.jpg" alt="Skydive logbook" width="640" height="1385" loading="lazy"></div>
      </div>
      <div class="feature-text">
        <div class="kicker">01 — Logbook</div>
        <h3>Every jump, neatly recorded.</h3>
        <p class="lede">Jump number, discipline and dropzone, sorted by month. Search, filter and find any jump in seconds.</p>
        <p class="lede">Got 1,000 jumps to catch up on? No problem. The AI import scans your old logbooks, even handwritten ones. No need to do it all at once: scan a few pages whenever you have time.</p>
        <p class="lede">Need a signature? With Sign a jump, licensed skydivers from the Arc network sign your jumps right in the app, in a couple of taps.</p>
      </div>
    </div>

    <!-- 02 Logging -->
    <div class="feature" data-tabs>
      <div class="feature-text end">
        <div class="kicker">02 — Logging</div>
        <h3>Logged before your canopy's packed.</h3>
        <p class="lede">Date, dropzone, gear, discipline, exit altitude, freefall time and much more. Tunnel sessions with flight time, coach and wind speed.</p>
        <div class="tabs" role="tablist">
          <button role="tab" aria-selected="true" data-src="/img/landing/log-skydive.jpg">Skydive</button>
          <button role="tab" aria-selected="false" data-src="/img/landing/log-tunnel.jpg">Tunnel</button>
        </div>
      </div>
      <div class="stage left-glow">
        <div class="phone"><img data-tab-target src="/img/landing/log-skydive.jpg" alt="Log a jump" width="640" height="1385" loading="lazy"></div>
      </div>
    </div>

    <!-- 03 Skill profile -->
    <div class="feature" data-tabs>
      <div class="stage">
        <div class="phone"><img data-tab-target src="/img/landing/skill-sky.jpg" alt="Skill profile" width="640" height="1385" loading="lazy"></div>
      </div>
      <div class="feature-text">
        <div class="kicker">03 — Skill profile</div>
        <h3>Watch yourself grow.</h3>
        <p class="lede">Your skills as a radar chart across Bodyfly Sky, Bodyfly Indoor and Canopy. Plus your air time in freefall and the tunnel.</p>
        <p class="lede">Your skill profile will help you find jumpers nearby with a similar skill set, so your next load is a good match.</p>
        <div class="tabs" role="tablist">
          <button role="tab" aria-selected="true" data-src="/img/landing/skill-sky.jpg">Bodyfly Sky</button>
          <button role="tab" aria-selected="false" data-src="/img/landing/skill-indoor.jpg">Bodyfly Indoor</button>
          <button role="tab" aria-selected="false" data-src="/img/landing/skill-canopy.jpg">Canopy</button>
        </div>
      </div>
    </div>

    <!-- 04 Map -->
    <div class="feature">
      <div class="feature-text end">
        <div class="kicker">04 — Map</div>
        <h3>Dropzones and tunnels worldwide.</h3>
        <p class="lede">Discover dropzones and wind tunnels on the map, filter by type and save your favourites for the next trip.</p>
      </div>
      <div class="stage left-glow">
        <div class="phone"><img src="/img/landing/map.jpg" alt="Map" width="640" height="1385" loading="lazy"></div>
      </div>
    </div>

    <!-- 05 Dropzone details -->
    <div class="feature" data-tabs>
      <div class="stage">
        <div class="phone"><img data-tab-target src="/img/landing/dz-weather.jpg" alt="Dropzone details" width="640" height="1385" loading="lazy"></div>
      </div>
      <div class="feature-text">
        <div class="kicker">05 — Dropzone details</div>
        <h3>The weather, before you drive out.</h3>
        <p class="lede">Every dropzone has its own page: 5-day forecast, winds aloft and temperatures by altitude, a cloud profile showing cloud base against your exit altitude and, for Alpine dropzones, the Föhn trend. Plus the facilities on site.</p>
        <div class="tabs" role="tablist">
          <button role="tab" aria-selected="true" data-src="/img/landing/dz-weather.jpg">Weather &amp; winds aloft</button>
          <button role="tab" aria-selected="false" data-src="/img/landing/dz-clouds.jpg">Clouds &amp; Föhn</button>
        </div>
      </div>
    </div>

    <!-- 06 Community -->
    <div class="feature" data-tabs>
      <div class="feature-text end">
        <div class="kicker">06 — Community</div>
        <h3>Together in the sky.</h3>
        <p class="lede">Your home feed shows your friends' posts with photos, likes and comments. Events nearby and at your favourite dropzones show up right on your home screen, and you can post your own public or private events.</p>
        <div class="tabs" role="tablist">
          <button role="tab" aria-selected="true" data-src="/img/landing/feed.jpg">Feed</button>
          <button role="tab" aria-selected="false" data-src="/img/landing/post.jpg">Post</button>
          <button role="tab" aria-selected="false" data-src="/img/landing/events.jpg">Events &amp; friends</button>
        </div>
      </div>
      <div class="stage left-glow">
        <div class="phone"><img data-tab-target src="/img/landing/feed.jpg" alt="Community" width="640" height="1385" loading="lazy"></div>
      </div>
    </div>

  </div>
</section>

<!-- ============================ ABOUT US ============================ -->
<section id="about" class="about wrap">
  <div class="about-grid">
    <div>
      <div class="overline">About us</div>
      <h2 class="section-title">By skydivers, for skydivers.</h2>
      <p class="lede">Arc is made in Switzerland. We jump ourselves and wanted a logbook as precise as a good jump run.</p>
    </div>
    <!-- TODO: put the team photo at public/img/landing/team.jpg and replace the placeholder with <img src="/img/landing/team.jpg" alt="The Arc team"> ersetzen -->
    <div class="photo-slot">Team photo coming soon</div>
  </div>
</section>
</main>

<!-- ============================ CONTACT ============================ -->
<section id="contact" class="contact">
  <div class="contact-card">
    <div class="glow"></div>
    <div class="contact-grid">
      <div>
        <div class="overline">Contact</div>
        <h2>Say hello.</h2>
        <p class="contact-lede">Questions or feedback? Write to us.</p>
        <a href={`mailto:${SITE.supportEmail}`} class="link-underline">{SITE.supportEmail}</a>
      </div>

      <form class="contact-form" data-form="contact">
        <div class="row">
          <input required name="name" placeholder="Name" aria-label="Name">
          <input required type="email" name="email" placeholder="Email" aria-label="Email">
        </div>
        <textarea name="message" placeholder="Your message" rows="5" aria-label="Your message"></textarea>
        <button type="submit" class="btn-coral">Send message</button>
      </form>

      <div class="contact-done" data-contact-done hidden>
        <strong>Thanks, got it.</strong>
        <p>We usually reply within two days.</p>
        <button type="button" data-contact-reset>New message</button>
      </div>
    </div>
  </div>

  <footer class="footer">
    <a href="#home" class="brand" aria-label="Arc">
      <svg viewBox="0 0 60.06 60.06" width="26" height="26" aria-hidden="true"><defs><linearGradient id="arcft" x1="30" y1="63" x2="30" y2="-70" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#8f0000"/><stop offset=".63" stop-color="#ffa54e"/></linearGradient></defs><rect width="60.06" height="60.06" rx="13" fill="url(#arcft)"/><path d="M51.4,42.07c-2.88-.14-8.31-12.01-21.36-12.01-13.85,0-19.6,12.22-21.21,12.22-4.81,0,8.18-24.5,21.31-24.5s25.48,24.5,21.26,24.29Z" fill="#fff"/></svg>
      <span>Arc</span>
    </a>
    <div class="footer-links">
      <a href="#home">Home</a>
      <a href="#mission">About Arc</a>
      <a href="#about">About us</a>
      <a href="#contact">Contact</a>
      <a href="/support">Support</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </div>
    <div>© {year} Arc</div>
  </footer>
</section>

<script>
// Arc website — tab switching for the feature screenshots + form states.

// Feature tabs: each [data-tabs] block swaps its [data-tab-target] image.
document.querySelectorAll('[data-tabs]').forEach((block) => {
  const img = block.querySelector('[data-tab-target]');
  const buttons = block.querySelectorAll('[role="tab"]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      img.src = btn.dataset.src;
    });
  });
});

// Preload the alternate tab screenshots so switching is instant.
window.addEventListener('load', () => {
  document.querySelectorAll('[role="tab"][data-src]').forEach((btn) => {
    new Image().src = btn.dataset.src;
  });
});

// Waitlist — stored in Supabase (PROD) via the join_waitlist RPC
// (supabase/migrations/0086_waitlist.sql). The publishable key is public
// by design; the table is only writable through that function.
const SUPABASE_URL = 'https://jbcfgxxdbnjtxclygpgm.supabase.co';
const SUPABASE_KEY = 'sb_publishable_FlWYjGOw7Db-HwB8Exx3VQ_Ds35WLl9';

const waitlist = document.querySelector('[data-form="waitlist"]');
const waitlistError = document.querySelector('[data-waitlist-error]');
waitlist?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const button = waitlist.querySelector('button');
  button.disabled = true;
  waitlistError.hidden = true;
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/join_waitlist`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        apikey: SUPABASE_KEY,
        Authorization: `Bearer ${SUPABASE_KEY}`,
      },
      body: JSON.stringify({ p_email: waitlist.email.value }),
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    document.querySelector('[data-waitlist-open]').hidden = true;
    document.querySelector('[data-waitlist-done]').hidden = false;
  } catch {
    waitlistError.hidden = false;
  } finally {
    button.disabled = false;
  }
});

// Contact — TODO: send the message to a real backend.
const contact = document.querySelector('[data-form="contact"]');
const contactDone = document.querySelector('[data-contact-done]');
contact?.addEventListener('submit', (e) => {
  e.preventDefault();
  contact.hidden = true;
  contactDone.hidden = false;
});
document.querySelector('[data-contact-reset]')?.addEventListener('click', () => {
  contact.reset();
  contact.hidden = false;
  contactDone.hidden = true;
});
</script>
</body>
</html>
