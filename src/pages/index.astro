---
import Base from '../layouts/Base.astro';
import Canopy from '../components/Canopy.astro';
import { SITE } from '../data/site';

// Same feature set as the App Store description (ARC/docs/app-store-listing.md)
// — only what the app does today.
const features = [
  {
    title: 'Your logbook',
    points: [
      'Log skydives and tunnel sessions in seconds — DZ, discipline, altitudes, freefall, aircraft, canopy, who you jumped with.',
      'Get jumps signed: ask a friend, they sign in the app with name, role and licence number.',
      'Scan your paper logbook in, or import an Excel or CSV file.',
      'Export everything as an Excel file anytime. Your data stays yours.',
    ],
  },
  {
    title: 'Licence, gear & documents',
    points: [
      'Licence, ratings, AAD, reserve repacks and insurance — scanned straight from paper or PDF.',
      'See at a glance when your repack, AAD service or insurance is due.',
      'Your rigs with exit weight and wingload.',
      'A one-page skydiver profile PDF for manifest and organisers.',
    ],
  },
  {
    title: 'Dropzones & tunnels',
    points: [
      'Map of dropzones and wind tunnels with altitude, aircraft, hours, prices, photos and reviews.',
      'Jump-day weather: hourly forecast, winds aloft, clouds by altitude and Föhn warnings for the Alps.',
      'Webcams, contact and directions right on the DZ page.',
      'The community keeps it current — suggest changes or add a new DZ.',
    ],
  },
  {
    title: 'Your crew',
    points: [
      'Add the people you jump with and follow their jumps and milestones.',
      'Chat, share posts and plan jump days and boogies with events.',
      'Show what you fly — belly, freefly, angle, wingsuit, tunnel.',
      'Emergency contact (and, if you choose, medical info) your friends can see when it matters.',
    ],
  },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero-inner">
      <Canopy size={120} label="Arc" />
      <h1>Every jump.<br />Signed by your crew.</h1>
      <p class="lead">{SITE.description}</p>
      {SITE.appStoreUrl
        ? <a class="cta" href={SITE.appStoreUrl}>Download on the App Store</a>
        : <p class="soon">Coming soon to iPhone · free for jumpers</p>}
    </div>
  </section>

  <section id="features" class="wrap features" aria-labelledby="features-title">
    <h2 id="features-title" class="sr-only">Features</h2>
    {features.map(f => (
      <article class="card">
        <h3>{f.title}</h3>
        <ul>{f.points.map(p => <li>{p}</li>)}</ul>
      </article>
    ))}
  </section>

  <section class="wrap narrow note">
    <h2>Free for jumpers</h2>
    <p>
      Arc is built by a skydiver for skydivers. Logging, signatures, documents, the DZ map and weather are free — no ads, and we don't sell your data.
    </p>
    <p class="small">
      Arc is a record-keeping and social app. It doesn't replace your dropzone's, instructor's or licensing body's rules, and doesn't verify what users enter. Weather is a forecast — always follow your DZ.
    </p>
  </section>
</Base>

<style>
  .hero {
    background: linear-gradient(180deg, var(--brand-top), var(--brand-bottom));
    color: var(--cream);
    padding-block: clamp(56px, 10vw, 112px);
    text-align: center;
  }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); font-weight: 800; margin: 8px 0 0; }
  .lead { max-width: 560px; font-size: 1.1rem; margin: 0; color: #fff; opacity: 0.95; }
  .soon {
    margin: 8px 0 0; padding: 10px 18px; border-radius: 999px;
    background: rgba(253, 245, 230, 0.16); border: 1px solid rgba(253, 245, 230, 0.4);
    font-weight: 700; font-size: 0.95rem; color: #fff;
  }
  .cta {
    margin-top: 8px; padding: 14px 24px; border-radius: 14px; background: var(--cream);
    color: var(--brand-bottom); font-weight: 800; text-decoration: none;
  }
  .features {
    display: grid; gap: 20px; grid-template-columns: 1fr;
    margin-top: -40px; position: relative;
  }
  @media (min-width: 760px) { .features { grid-template-columns: 1fr 1fr; } }
  .card { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px; }
  .card h3 { font-size: 1.2rem; color: var(--fg); }
  .card ul { margin: 0; padding-left: 1.1em; color: var(--fg-2); }
  .card li { margin-bottom: 8px; }
  .card li::marker { color: var(--action); }
  .note { margin-top: 64px; text-align: center; }
  .note h2 { font-size: 1.8rem; }
  .note p { color: var(--fg-2); }
  .small { font-size: 0.9rem; color: var(--fg-3) !important; }
</style>
