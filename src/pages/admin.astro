---
// Moderation: everything waiting for approval, with photo previews.
// Data + actions go through admin_moderation_queue() / admin_review()
// (ARC/supabase/migrations/0087_admin_moderation.sql) — only users in the
// admins table get past them. Not linked anywhere, noindex.
import Base from '../layouts/Base.astro';
---
<Base title="Moderation" noindex>
  <div class="wrap admin">
    <div class="admin-head">
      <h1>Moderation</h1>
      <div class="admin-tools">
        <select data-env aria-label="Database">
          <option value="prod">PROD</option>
          <option value="test">TEST</option>
        </select>
        <button type="button" class="ghost" data-signout hidden>Sign out</button>
      </div>
    </div>

    <form class="login" data-login hidden>
      <p>Sign in with your Arc account (email + password).</p>
      <input name="email" type="email" placeholder="Email" required autocomplete="username">
      <input name="password" type="password" placeholder="Password" required autocomplete="current-password">
      <button type="submit">Sign in</button>
    </form>

    <p class="status" data-status></p>

    <div data-queue hidden>
      <section>
        <h2>Photos <span class="count" data-count="photos"></span></h2>
        <div class="grid" data-list="photos"></div>
      </section>
      <section>
        <h2>New dropzones &amp; tunnels <span class="count" data-count="creates"></span></h2>
        <div class="stack" data-list="creates"></div>
      </section>
      <section>
        <h2>Edit suggestions <span class="count" data-count="edits"></span></h2>
        <div class="stack" data-list="edits"></div>
      </section>
    </div>
  </div>

  <!-- Full-size preview -->
  <dialog class="lightbox" data-lightbox><img alt=""></dialog>
</Base>

<style>
  .admin { padding-top: 40px; }
  .admin-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .admin-head h1 { margin: 0; font-size: 2rem; font-weight: 800; }
  .admin-tools { display: flex; gap: 10px; align-items: center; }
  .admin select, .admin input {
    font: inherit; font-size: 1rem; padding: 10px 14px; border-radius: 12px;
    border: 1px solid var(--border); background: var(--surface); color: var(--fg);
  }
  .admin button {
    font: inherit; font-weight: 700; cursor: pointer; border: 0; border-radius: 999px;
    padding: 10px 18px; background: var(--fg); color: #fff;
  }
  .admin button:disabled { opacity: .5; cursor: default; }
  .admin button.ghost { background: transparent; color: var(--fg-2); border: 1px solid var(--border); }
  .login { display: grid; gap: 10px; max-width: 360px; margin-top: 32px; }
  .login p { margin: 0; color: var(--fg-2); }
  .status { color: var(--fg-2); min-height: 1.6em; margin-top: 16px; }
  .admin section { margin-top: 32px; }
  .admin h2 { font-size: 1.25rem; display: flex; align-items: center; gap: 8px; }
  .count { font-size: .85rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: var(--ink-100); color: var(--fg-2); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .stack { display: grid; gap: 16px; }
  :global(.card) { background: var(--surface); border-radius: 16px; box-shadow: var(--shadow); padding: 14px; display: grid; gap: 10px; align-content: start; }
  :global(.card h3) { margin: 0; font-size: 1.05rem; }
  :global(.card .meta) { margin: 0; font-size: .85rem; color: var(--fg-3); }
  :global(.card .note) { margin: 0; font-size: .95rem; color: var(--fg-2); white-space: pre-wrap; }
  :global(.thumb) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; background: var(--ink-100); cursor: zoom-in; }
  :global(.thumbs) { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
  :global(.thumb-label) { font-size: .75rem; font-weight: 700; color: var(--fg-3); text-transform: uppercase; letter-spacing: .06em; margin: 4px 0 -4px; }
  :global(.changes) { margin: 0; padding-left: 1.1em; font-size: .9rem; color: var(--fg-2); }
  :global(.changes b) { color: var(--fg); }
  :global(.actions) { display: flex; gap: 8px; }
  :global(.actions .approve) { background: #3e9e76 !important; }
  :global(.actions .reject) { background: #c64e2c !important; }
  :global(.empty) { color: var(--fg-3); margin: 0; }
  .lightbox { padding: 0; border: 0; border-radius: 16px; max-width: 92vw; max-height: 92vh; background: #000; }
  .lightbox::backdrop { background: rgba(0, 0, 0, .7); }
  .lightbox img { display: block; max-width: 92vw; max-height: 92vh; object-fit: contain; }
</style>

<script>
  import { createClient, type SupabaseClient } from '@supabase/supabase-js';

  // Publishable keys — public by design, same as in the app.
  const ENVS = {
    prod: { url: 'https://jbcfgxxdbnjtxclygpgm.supabase.co', key: 'sb_publishable_FlWYjGOw7Db-HwB8Exx3VQ_Ds35WLl9' },
    test: { url: 'https://mgqsxbzqdgvgvnukvknp.supabase.co', key: 'sb_publishable_45AbKAxYJPxCPVY3YMMnMQ_myH6LbsA' },
  } as const;
  type Env = keyof typeof ENVS;

  const $ = <T extends Element>(sel: string) => document.querySelector(sel) as T;
  const envSelect = $<HTMLSelectElement>('[data-env]');
  const loginForm = $<HTMLFormElement>('[data-login]');
  const signOutBtn = $<HTMLButtonElement>('[data-signout]');
  const statusEl = $<HTMLElement>('[data-status]');
  const queueEl = $<HTMLElement>('[data-queue]');
  const lightbox = $<HTMLDialogElement>('[data-lightbox]');

  let env: Env = 'prod';
  try { if (localStorage.getItem('arc-admin-env') === 'test') env = 'test'; } catch {}
  envSelect.value = env;

  let sb: SupabaseClient;
  const photoUrl = (path: string) => `${ENVS[env].url}/storage/v1/object/public/location-photos/${path}`;

  // Tiny element builder — all user content goes in as text, never as HTML.
  function el(tag: string, props: Record<string, any> = {}, ...children: (Node | string | null | undefined | false)[]) {
    const node = document.createElement(tag);
    for (const [k, v] of Object.entries(props)) {
      if (k === 'class') node.className = v;
      else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
      else (node as any)[k] = v;
    }
    for (const c of children) if (c) node.append(c);
    return node;
  }

  function thumb(path: string) {
    const src = photoUrl(path);
    return el('img', {
      class: 'thumb', src, alt: '', loading: 'lazy',
      onclick: () => { (lightbox.querySelector('img') as HTMLImageElement).src = src; lightbox.showModal(); },
    });
  }
  lightbox.addEventListener('click', () => lightbox.close());

  const when = (iso: string) => new Date(iso).toLocaleString('de-CH', { dateStyle: 'medium', timeStyle: 'short' });
  const show = (v: unknown) =>
    v == null || v === '' ? '—' : Array.isArray(v) ? (v.length ? v.join(', ') : '—') : typeof v === 'object' ? JSON.stringify(v) : String(v);

  function actions(source: string, id: string, card: HTMLElement) {
    const review = async (approve: boolean, btns: HTMLButtonElement[]) => {
      btns.forEach((b) => (b.disabled = true));
      const { error } = await sb.rpc('admin_review', { p_source: source, p_id: id, p_approve: approve });
      if (error) {
        btns.forEach((b) => (b.disabled = false));
        alert(`Failed: ${error.message}`);
        return;
      }
      card.remove();
      load(false);
    };
    const approve = el('button', { class: 'approve', type: 'button', textContent: 'Approve' }) as HTMLButtonElement;
    const reject = el('button', { class: 'reject', type: 'button', textContent: 'Reject' }) as HTMLButtonElement;
    approve.onclick = () => review(true, [approve, reject]);
    reject.onclick = () => review(false, [approve, reject]);
    return el('div', { class: 'actions' }, approve, reject);
  }

  function photoCard(p: any) {
    const card = el('div', { class: 'card' });
    card.append(
      thumb(p.photo_path),
      el('h3', { textContent: p.location }),
      el('p', { class: 'meta', textContent: `${p.source === 'tunnel_photos' ? 'Tunnel' : 'Dropzone'} · ${p.submitter || 'unknown'} · ${when(p.created_at)}` }),
      actions(p.source, p.id, card),
    );
    return card;
  }

  function createCard(c: any) {
    const card = el('div', { class: 'card' });
    const fields = c.fields || {};
    const avatar = fields.avatar_path as string | undefined;
    const rest = Object.entries(fields).filter(([k]) => k !== 'avatar_path');
    card.append(
      el('h3', { textContent: `${c.kind === 'tunnel' ? 'Tunnel' : 'Dropzone'}: ${c.name}${c.country ? ` (${c.country})` : ''}` }),
      el('p', { class: 'meta' },
        `${c.submitter || 'unknown'} · ${when(c.created_at)} · `,
        el('a', { href: `https://www.google.com/maps?q=${c.lat},${c.lng}`, target: '_blank', rel: 'noopener', textContent: `${Number(c.lat).toFixed(5)}, ${Number(c.lng).toFixed(5)}` }),
      ),
      c.note && el('p', { class: 'note', textContent: `Note: ${c.note}` }),
      rest.length > 0 && el('ul', { class: 'changes' }, ...rest.map(([k, v]) => el('li', {}, el('b', { textContent: k }), `: ${show(v)}`))),
      avatar && el('p', { class: 'thumb-label', textContent: 'Profile photo' }),
      avatar && el('div', { class: 'thumbs' }, thumb(avatar)),
      c.photo_paths?.length > 0 && el('p', { class: 'thumb-label', textContent: 'Gallery' }),
      c.photo_paths?.length > 0 && el('div', { class: 'thumbs' }, ...c.photo_paths.map(thumb)),
      actions(c.source, c.id, card),
    );
    return card;
  }

  function editCard(e: any) {
    const card = el('div', { class: 'card' });
    const changes = Object.entries(e.changes || {}) as [string, any][];
    const avatar = changes.find(([k]) => k === 'avatar_path')?.[1]?.to as string | undefined;
    card.append(
      el('h3', { textContent: `${e.source === 'tunnel_edit_submissions' ? 'Tunnel' : 'Dropzone'}: ${e.location}` }),
      el('p', { class: 'meta', textContent: `${e.submitter || 'unknown'} · ${when(e.created_at)}` }),
      e.note && el('p', { class: 'note', textContent: `Note: ${e.note}` }),
      el('ul', { class: 'changes' },
        ...changes.filter(([k]) => k !== 'avatar_path').map(([k, v]) =>
          el('li', {}, el('b', { textContent: k }), `: ${show(v?.from)} → ${show(v?.to)}`)),
      ),
      avatar && el('p', { class: 'thumb-label', textContent: 'New profile photo' }),
      avatar && el('div', { class: 'thumbs' }, thumb(avatar)),
      actions(e.source, e.id, card),
    );
    return card;
  }

  function render(list: string, items: any[], make: (x: any) => HTMLElement) {
    const box = $<HTMLElement>(`[data-list="${list}"]`);
    box.replaceChildren(...(items.length ? items.map(make) : [el('p', { class: 'empty', textContent: 'Nothing pending.' })]));
    $<HTMLElement>(`[data-count="${list}"]`).textContent = String(items.length);
  }

  async function load(full = true) {
    if (full) statusEl.textContent = 'Loading…';
    const { data, error } = await sb.rpc('admin_moderation_queue');
    if (error) {
      queueEl.hidden = true;
      statusEl.textContent = error.message.includes('Not allowed')
        ? 'This account is not an admin. Add it to the admins table (see migration 0087).'
        : `Error: ${error.message}`;
      return;
    }
    render('photos', data.photos, photoCard);
    render('creates', data.creates, createCard);
    render('edits', data.edits, editCard);
    statusEl.textContent = '';
    queueEl.hidden = false;
  }

  async function start() {
    sb = createClient(ENVS[env].url, ENVS[env].key, { auth: { storageKey: `arc-admin-${env}` } });
    const { data } = await sb.auth.getSession();
    const signedIn = !!data.session;
    loginForm.hidden = signedIn;
    signOutBtn.hidden = !signedIn;
    queueEl.hidden = true;
    statusEl.textContent = '';
    if (signedIn) load();
  }

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(loginForm);
    statusEl.textContent = 'Signing in…';
    const { error } = await sb.auth.signInWithPassword({ email: String(fd.get('email')), password: String(fd.get('password')) });
    if (error) { statusEl.textContent = `Sign-in failed: ${error.message}`; return; }
    start();
  });

  signOutBtn.addEventListener('click', async () => { await sb.auth.signOut(); start(); });

  envSelect.addEventListener('change', () => {
    env = envSelect.value as Env;
    try { localStorage.setItem('arc-admin-env', env); } catch {}
    start();
  });

  start();
</script>
