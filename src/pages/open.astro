---
import Base from '../layouts/Base.astro';

// Landing for links shared from the app (utils/shareLinks there):
//   /open?place=<DZ or tunnel name>&where=<Town, Country>
//   /open?event=<id>&title=<title>&where=<date · place>
//   /open?profile=<user id>&name=<name>
// The app claims /open as a universal link (public/.well-known/
// apple-app-site-association), so with Arc installed the link opens the app
// and this page is only seen without it, or before that build. "Open in Arc"
// hands over with the same arc:// deep links the app uses. Everything comes
// from the link and goes in as text only; ids must be UUIDs.
---
<Base title="Open in Arc" description="A dropzone or wind tunnel shared from Arc, the skydiving logbook app." noindex>
  <div class="wrap narrow open-page">
    <div class="card">
      <img src="/img/arc-icon.png" alt="" width="64" height="64" class="icon">
      <p class="kicker" data-kicker>Shared from Arc</p>
      <h1 data-place>A place on Arc</h1>
      <p class="where" data-where hidden></p>
      <a class="btn" data-open href="arc://location">Open in Arc</a>
      <p class="hint" data-hint>Opens the dropzone or tunnel with its weather, hours and prices in the Arc app.</p>
      <p class="hint small">No Arc yet? It's in beta right now. <a href="/">See what Arc is</a>.</p>
    </div>
  </div>
</Base>

<style>
  .open-page { padding-top: 56px; padding-bottom: 72px; }
  .card { background: var(--surface); border-radius: 24px; box-shadow: var(--shadow); padding: 32px 24px; text-align: center; display: grid; justify-items: center; gap: 6px; }
  .icon { border-radius: 16px; margin-bottom: 8px; }
  .kicker { margin: 0; font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-3); }
  h1 { margin: 0; font-size: clamp(1.6rem, 6vw, 2.2rem); font-weight: 800; line-height: 1.15; }
  .where { margin: 0; color: var(--fg-2); font-size: 1.05rem; }
  .btn { margin-top: 18px; display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 28px; border-radius: 16px; background: var(--action, #C64E2C); color: #fff; font-weight: 700; text-decoration: none; font-size: 1.05rem; }
  .hint { margin: 10px 0 0; color: var(--fg-3); font-size: .92rem; max-width: 34ch; }
  .hint.small { font-size: .85rem; margin-top: 6px; }
  .hint a { color: var(--accent-text, #B04524); font-weight: 600; }
</style>

<script>
  const q = new URLSearchParams(location.search);
  const text = (k: string) => (q.get(k) ?? '').trim().slice(0, 120);
  const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  const event = text('event'), profile = text('profile'), place = text('place');
  const where = text('where');

  let title = '', href = '', kicker = '', hint = '';
  if (UUID.test(event)) {
    title = text('title') || 'An event on Arc';
    href = `arc://event-detail?id=${event}`;
    kicker = 'Event on Arc';
    hint = 'Opens the event in the Arc app, with who is going and everything you need to know.';
  } else if (UUID.test(profile)) {
    title = text('name') || 'A skydiver on Arc';
    href = `arc://skydiver-profile?id=${profile}`;
    kicker = 'Skydiver on Arc';
    hint = 'Opens their skydiver profile in the Arc app.';
  } else if (place) {
    title = place;
    href = `arc://location?focusDz=${encodeURIComponent(place)}&focusTs=${Date.now()}`;
  }

  if (title) {
    document.querySelector('[data-place]')!.textContent = title;
    document.title = `${title} · Arc`;
    document.querySelector<HTMLAnchorElement>('[data-open]')!.href = href;
    if (kicker) document.querySelector('[data-kicker]')!.textContent = kicker;
    if (hint) document.querySelector('[data-hint]')!.textContent = hint;
  }
  if (where) {
    const el = document.querySelector<HTMLElement>('[data-where]')!;
    el.textContent = where;
    el.hidden = false;
  }
</script>
